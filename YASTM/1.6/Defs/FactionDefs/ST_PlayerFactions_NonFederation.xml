<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Klingon player faction -->
  <FactionDef ParentName="PlayerFactionBase">
    <defName>ST_Player_KlingonHouse</defName>
    <label>klingon house expedition</label>
    <description>A frontier expedition of a Klingon Great House. Honor, glory and worthy battles
      matter more than comfort or survival odds.</description>
    <isPlayer>true</isPlayer>
    <basicMemberKind>Colonist</basicMemberKind>
    <pawnSingular>colonist</pawnSingular>
    <pawnsPlural>colonists</pawnsPlural>
    <techLevel>Spacer</techLevel>
    <factionNameMaker>ST_NamerKlingonFaction</factionNameMaker>
    <settlementNameMaker>ST_SettlementName_Klingon</settlementNameMaker>

    <factionIconPath>UI/Icons/Factions/Klingon</factionIconPath>
    <colorSpectrum>
        <li>(0.70, 0.10, 0.10)</li> <!-- Dark red -->
        <li>(0.90, 0.25, 0.20)</li> <!-- Lighter red -->
    </colorSpectrum>

    <allowedCultures>
      <li>ST_Culture_Klingon</li>
    </allowedCultures>
    <forcedMemes>
      <li>ST_Meme_KlingonHonor</li>
    </forcedMemes>

    <xenotypeSet Inherit="False" MayRequire="Ludeon.RimWorld.Biotech">
      <xenotypeChances><Ectos_Klingon>0.90</Ectos_Klingon><Baseliner>0.10</Baseliner></xenotypeChances>
    </xenotypeSet>

    <canMakeRandomly>false</canMakeRandomly>
    <hidden>false</hidden>
    <backstoryCategories>
      <li>Klingon_Operations</li>    <!-- skilled pilots and tacticians -->
      <li>Klingon_Engineer</li>     <!-- expert technicians --> 
      <li>Klingon_Science</li>    <!-- research specialists -->
      <li>Klingon_Medic</li>    <!-- dedicated healers -->
      <li>Klingon_Warrior</li>    <!-- frontline fighters -->
      <li>Klingon_Command</li>    <!-- strategic leaders -->
      <li>Offworld</li>
    </backstoryCategories>

    <startingResearchTags>
      <li>ClassicStart</li>
    </startingResearchTags>
    <startingTechprintsResearchTags>
      <li>ClassicStart</li>
      <li>ClassicStartTechprints</li>
    </startingTechprintsResearchTags>
  </FactionDef>


  <!-- Romulan player faction -->
  <FactionDef ParentName="PlayerFactionBase">
    <defName>ST_Player_RomulanOutpost</defName>
    <label>romulan frontier outpost</label>
    <description>A covert Romulan frontier outpost, operating on the edge of known space.
      Secrecy, control and technological superiority define this colony.</description>
    <isPlayer>true</isPlayer>
    <basicMemberKind>Colonist</basicMemberKind>
    <pawnSingular>colonist</pawnSingular>
    <pawnsPlural>colonists</pawnsPlural>
    <techLevel>Spacer</techLevel>
 
    <factionNameMaker>ST_NamerRomulanFaction</factionNameMaker>
    <settlementNameMaker>ST_SettlementName_Romulan</settlementNameMaker>
    <factionIconPath>UI/Icons/Factions/Romulan</factionIconPath>
    <colorSpectrum>
      <li>(0.10, 0.60, 0.35)</li> 
      <li>(0.20, 0.90, 0.50)</li>
    </colorSpectrum>

    <allowedCultures><li>ST_Culture_Romulan</li></allowedCultures>

    <forcedMemes>
      <li>ST_Meme_RomulanCommand</li>
    </forcedMemes>
    <disallowedMemes>
      <li>Cannibal</li>
    </disallowedMemes>

    <xenotypeSet Inherit="False" MayRequire="Ludeon.RimWorld.Biotech">
      <xenotypeChances><Ectos_Romulan>0.90</Ectos_Romulan><Baseliner>0.10</Baseliner></xenotypeChances>
    </xenotypeSet>

    <canMakeRandomly>false</canMakeRandomly>
    <hidden>false</hidden>
    <backstoryCategories>
      <li>Romulan_Operations</li>    <!-- skilled pilots and tacticians -->
      <li>Romulan_Engineering</li>  <!-- expert technicians -->
      <li>Romulan_Science</li>    <!-- research specialists -->
      <li>Romulan_Medical</li>    <!-- dedicated healers -->
      <li>Romulan_Command</li>    <!-- strategic leaders -->
      <li>Offworld</li>
    </backstoryCategories>

    <startingResearchTags>
      <li>ClassicStart</li>
    </startingResearchTags>
    <startingTechprintsResearchTags>
      <li>ClassicStart</li>
      <li>ClassicStartTechprints</li>
    </startingTechprintsResearchTags>
  </FactionDef>


  <!-- Ferengi player faction -->
  <FactionDef ParentName="PlayerFactionBase">
    <defName>ST_Player_FerengiConsortium</defName>
    <label>ferengi trade consortium</label>
    <description>A Ferengi trade consortium, here to turn every natural resource,
      social contact and subspace anomaly into profit.</description>

    <isPlayer>true</isPlayer>
    <basicMemberKind>Colonist</basicMemberKind>
    <pawnSingular>colonist</pawnSingular>
    <pawnsPlural>colonists</pawnsPlural>

    <techLevel>Industrial</techLevel>

    <factionNameMaker>ST_NamerFerengiFaction</factionNameMaker>
    <settlementNameMaker>ST_SettlementName_Ferengi</settlementNameMaker>
    <factionIconPath>UI/Icons/Factions/Ferengi</factionIconPath>
    <colorSpectrum>
      <li>(0.90, 0.70, 0.20)</li>
      <li>(1.00, 0.85, 0.25)</li>
    </colorSpectrum>

    <allowedCultures>
      <li>ST_Culture_Ferengi</li>
    </allowedCultures>

    <forcedMemes>
      <li>ST_Meme_FerengiCommerce</li>
    </forcedMemes>
    <disallowedMemes>
      <li>Cannibal</li>
    </disallowedMemes>

    <xenotypeSet Inherit="False" MayRequire="Ludeon.RimWorld.Biotech">
      <xenotypeChances><Ectos_Ferengi>0.90</Ectos_Ferengi><Baseliner>0.10</Baseliner></xenotypeChances>
    </xenotypeSet>
    
    <canMakeRandomly>false</canMakeRandomly>
    <hidden>false</hidden>
    <backstoryCategories>
      <li>Ferengi_Commerce</li>     <!-- deal-making experts -->
      <li>Ferengi_Exotics</li>      <!-- finding the unusual -->
      <li>Ferengi_Engineering</li>   <!-- maintaining equipment -->
      <li>Ferengi_Medical</li>       <!-- profit from health -->
      <li>Ferengi_TradeNegotiator</li>  <!-- skilled bargainers -->
      <li>Offworld</li>
    </backstoryCategories>
    
    <startingResearchTags>
      <li>ClassicStart</li>
    </startingResearchTags>
    <startingTechprintsResearchTags>
      <li>ClassicStart</li>
      <li>ClassicStartTechprints</li>
    </startingTechprintsResearchTags>
  </FactionDef>


  <!-- Dominion player faction -->
  <FactionDef ParentName="PlayerFactionBase">
    <defName>ST_Player_DominionOutpost</defName>
    <label>dominion outpost</label>
    <description>A Dominion outpost, here to expand the glory of the Founders and bring order to the galaxy.</description>
    <isPlayer>true</isPlayer>
    <basicMemberKind>Colonist</basicMemberKind>
    <pawnSingular>colonist</pawnSingular>
    <pawnsPlural>colonists</pawnsPlural>
    <techLevel>Spacer</techLevel>
    <factionNameMaker>ST_NamerDominionFaction</factionNameMaker>
    <settlementNameMaker>ST_SettlementName_Dominion</settlementNameMaker>
    <factionIconPath>UI/Icons/Factions/Dominion</factionIconPath>
    <colorSpectrum>
      <li>(0.10, 0.10, 0.60)</li>
      <li>(0.20, 0.20, 0.90)</li>
    </colorSpectrum>

    <allowedCultures>
      <li>ST_Culture_Dominion</li>
    </allowedCultures>
    <forcedMemes>
      <li>ST_Meme_DominionOrder</li>
    </forcedMemes>
    <disallowedMemes>
      <li>Cannibal</li>
    </disallowedMemes>
    <xenotypeSet Inherit="False" MayRequire="Ludeon.RimWorld.Biotech">
      <xenotypeChances>
        <Ectos_JemHadar>0.75</Ectos_JemHadar>
        <Ectos_Vorta>0.10</Ectos_Vorta>
        <Ectos_Cardassian>0.12</Ectos_Cardassian>
        <Baseliner>0.025</Baseliner>
        <Ectos_Changeling>0.005</Ectos_Changeling>
      </xenotypeChances>
    </xenotypeSet>
    <canMakeRandomly>false</canMakeRandomly>
    <hidden>false</hidden>
    <backstoryCategories>
      <li>ST_Dominion_JemHadar</li>
      <li>ST_Dominion_Vorta</li>
      <li>ST_Dominion_Founder</li>
      <li>ST_Dominion_Cardassian</li>
      <li>Offworld</li> 
    </backstoryCategories>
    <startingResearchTags>
      <li>ClassicStart</li>
    </startingResearchTags>
    <startingTechprintsResearchTags>
      <li>ClassicStart</li>
      <li>ClassicStartTechprints</li>
    </startingTechprintsResearchTags>
  </FactionDef>
</Defs>
