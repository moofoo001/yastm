            <li><category>ProfitVolume</category><count>150</count></li> </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>6</targetDegree>
        <requirements>
          <minSocialSkill>18</minSocialSkill>
          <minIntellectualSkill>10</minIntellectualSkill>
          <careerPoints>
