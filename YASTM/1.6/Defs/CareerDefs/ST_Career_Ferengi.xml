<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <YASTM.CareerDef>
    <defName>ST_Career_Ferengi_Commerce</defName>
    <label>Ferengi Commerce</label>
    <description>The acquisition of wealth via the Great Material Continuum.</description>
    <trait>ST_FerengiRank</trait>
    
    <stages>
      <li>
        <targetDegree>1</targetDegree>
        <requirements>
          <minSocialSkill>3</minSocialSkill>
          <careerPoints>
            <li><category>SuccessfulTrade</category><count>5</count></li>
            <li><category>ProfitVolume</category><count>2</count></li>
          </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>2</targetDegree>
        <requirements>
          <minSocialSkill>6</minSocialSkill>
          <careerPoints>
            <li><category>SuccessfulTrade</category><count>15</count></li>
            <li><category>ProfitVolume</category><count>10</count></li>
          </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>3</targetDegree>
        <requirements>
          <minSocialSkill>8</minSocialSkill>
          <minShootingSkill>5</minShootingSkill> 
          <careerPoints>
            <li><category>CombatKill</category><count>3</count></li>
            <li><category>ProfitVolume</category><count>25</count></li>
          </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>4</targetDegree>
        <requirements>
          <minSocialSkill>12</minSocialSkill>
          <careerPoints>
            <li><category>DiplomacyCeasefire</category><count>1</count></li>
            <li><category>ProfitVolume</category><count>60</count></li>
          </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>5</targetDegree>
        <requirements>
          <minSocialSkill>15</minSocialSkill>
          <timeInRankYears>2.0</timeInRankYears>
          <careerPoints>
            <li><category>DiplomacyImprove</category><count>5</count></li>
            <li><category>ProfitVolume</category><count>150</count></li>
          </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>6</targetDegree>
        <requirements>
          <minSocialSkill>18</minSocialSkill>
          <careerPoints>
            <li><category>ProfitVolume</category><count>500</count></li>
            <li><category>SuccessfulTrade</category><count>200</count></li>
            <li><category>DiplomacyImprove</category><count>2</count></li>
            <li><category>DiplomacyCeasefire</category><count>1</count></li>
          </careerPoints>
        </requirements>
      </li>
    </stages>
  </YASTM.CareerDef>
</Defs>