<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <YASTM.CareerDef>
    <defName>ST_Career_Federation_Standard</defName>
    <label>Starfleet Career</label>
    <description>To boldy go. Advancement relies on scientific discovery, diplomacy, and time in service.</description>
    <trait>ST_FederationRank</trait>
    
    <stages>
      <li>
        <targetDegree>1</targetDegree>
        <requirements>
          <minIntellectualSkill>4</minIntellectualSkill>
          <minSocialSkill>3</minSocialSkill>
          <timeInRankYears>0.5</timeInRankYears> <careerPoints>
            <li><category>ScienceScan</category><count>5</count></li> </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>2</targetDegree>
        <requirements>
          <minIntellectualSkill>6</minIntellectualSkill>
          <timeInRankYears>1.0</timeInRankYears>
          <careerPoints>
            <li><category>ScienceScan</category><count>15</count></li>
          </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>3</targetDegree>
        <requirements>
          <minIntellectualSkill>8</minIntellectualSkill>
          <minSocialSkill>5</minSocialSkill>
          <timeInRankYears>1.5</timeInRankYears>
          <careerPoints>
            <li><category>ScienceScan</category><count>30</count></li>
            <li><category>SecuritySweep</category><count>5</count></li> </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>4</targetDegree>
        <requirements>
          <minIntellectualSkill>10</minIntellectualSkill>
          <minSocialSkill>8</minSocialSkill>
          <timeInRankYears>2.0</timeInRankYears>
          <careerPoints>
            <li><category>ScienceScan</category><count>50</count></li>
            <li><category>SuccessfulTrade</category><count>2</count></li> </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>5</targetDegree>
        <requirements>
          <minSocialSkill>12</minSocialSkill> <minIntellectualSkill>12</minIntellectualSkill>
          <timeInRankYears>3.0</timeInRankYears>
          <careerPoints>
            <li><category>ScienceScan</category><count>80</count></li>
            <li><category>SecuritySweep</category><count>20</count></li>
          </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>6</targetDegree>
        <requirements>
          <minSocialSkill>15</minSocialSkill>
          <minIntellectualSkill>14</minIntellectualSkill>
          <minShootingSkill>6</minShootingSkill> <timeInRankYears>4.0</timeInRankYears>
          <careerPoints>
            <li><category>SuccessfulTrade</category><count>10</count></li> </careerPoints>
        </requirements>
      </li>
    </stages>
  </YASTM.CareerDef>
</Defs>