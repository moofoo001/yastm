<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <YASTM.CareerDef>
    <defName>ST_Career_Federation_Standard</defName>
    <label>Starfleet Career</label>
    <description>The path of the explorer and diplomat. Advancement requires scientific curiosity, dedication to duty, and the ability to forge peace.</description>
    <trait>ST_FederationRank</trait>
    
    <stages>
      <li>
        <targetDegree>1</targetDegree>
        <requirements>
          <minIntellectualSkill>4</minIntellectualSkill>
          <timeInRankYears>0.5</timeInRankYears>
          <careerPoints>
            <li><category>ScienceScan</category><count>10</count></li> </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>2</targetDegree>
        <requirements>
          <minIntellectualSkill>6</minIntellectualSkill>
          <timeInRankYears>1.0</timeInRankYears>
          <careerPoints>
            <li><category>ScienceScan</category><count>25</count></li>
            <li><category>SecuritySweep</category><count>5</count></li> </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>3</targetDegree>
        <requirements>
          <minIntellectualSkill>8</minIntellectualSkill>
          <minSocialSkill>5</minSocialSkill>
          <timeInRankYears>1.5</timeInRankYears>
          <careerPoints>
            <li><category>ScienceScan</category><count>50</count></li>
            <li><category>SecuritySweep</category><count>15</count></li>
          </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>4</targetDegree>
        <requirements>
          <minIntellectualSkill>10</minIntellectualSkill>
          <minSocialSkill>8</minSocialSkill>
          <careerPoints>
            <li><category>DiplomacyImprove</category><count>1</count></li>
            <li><category>ScienceScan</category><count>75</count></li>
            <li><category>SecuritySweep</category><count>15</count></li>
          </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>5</targetDegree>
        <requirements>
          <minSocialSkill>12</minSocialSkill>
          <minIntellectualSkill>12</minIntellectualSkill>
          <timeInRankYears>3.0</timeInRankYears>
          <careerPoints>
            <li><category>DiplomacyImprove</category><count>3</count></li>
            <li><category>DiplomacyCeasefire</category><count>1</count></li>
            <li><category>SecuritySweep</category><count>30</count></li>
          </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>6</targetDegree>
        <requirements>
          <minSocialSkill>15</minSocialSkill>
          <minIntellectualSkill>14</minIntellectualSkill>
          <timeInRankYears>5.0</timeInRankYears>
          <careerPoints>
            <li><category>DiplomacyCeasefire</category><count>3</count></li>
            <li><category>DiplomacyImprove</category><count>10</count></li>
          </careerPoints>
        </requirements>
      </li>
    </stages>
  </YASTM.CareerDef>
</Defs>