<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <YASTM.ST_CareerDef>
    <defName>ST_Career_Klingon_Warrior</defName>
    <label>Warrior's Path</label>
    <description>Victory or Death. Advancement is earned through blood, labor, and honorable combat.</description>
    <trait>ST_KlingonRank</trait>
    
    <stages>
      <li>
        <targetDegree>1</targetDegree>
        <requirements>
          <minMeleeSkill>4</minMeleeSkill>
          <careerPoints>
            <li><category>WormsStomped</category><count>50</count></li> 
            <li><category>CombatKill</category><count>1</count></li>
          </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>2</targetDegree>
        <requirements>
          <minMeleeSkill>6</minMeleeSkill>
          <minShootingSkill>4</minShootingSkill>
          <careerPoints>
            <li><category>CombatKill</category><count>5</count></li>
            <li><category>WormsStomped</category><count>100</count></li> </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>3</targetDegree>
        <requirements>
          <minMeleeSkill>8</minMeleeSkill>
          <careerPoints>
            <li><category>CombatKill</category><count>10</count></li>
            <li><category>HonorKill</category><count>1</count></li>
          </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>4</targetDegree>
        <requirements>
          <minMeleeSkill>10</minMeleeSkill>
          <minSocialSkill>4</minSocialSkill>
          <careerPoints>
            <li><category>CombatKill</category><count>25</count></li>
            <li><category>HonorKill</category><count>5</count></li>
          </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>5</targetDegree>
        <requirements>
          <minMeleeSkill>13</minMeleeSkill>
          <minSocialSkill>6</minSocialSkill>
          <careerPoints>
            <li><category>CombatKill</category><count>50</count></li>
            <li><category>HonorKill</category><count>15</count></li>
          </careerPoints>
        </requirements>
      </li>

      <li>
        <targetDegree>6</targetDegree>
        <requirements>
          <minMeleeSkill>16</minMeleeSkill>
          <minSocialSkill>10</minSocialSkill>
          <careerPoints>
            <li><category>CombatKill</category><count>100</count></li>
            <li><category>HonorKill</category><count>30</count></li>
          </careerPoints>
        </requirements>
      </li>
    </stages>
  </YASTM.ST_CareerDef>
</Defs>