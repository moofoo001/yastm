<Defs>

  <BackstoryDef>
    <defName>ST_BS_JemHadar_VatGrown</defName>
    <title>vat-grown soldier</title>
    <titleShort>vat-grown</titleShort>
    <baseDesc>Grown in a birthing pod, reaching maturity in a matter of days. Implanted with genetic loyalty to the Founders and a dependency on Ketracel White, he knows only combat and obedience.</baseDesc>
    <slot>Childhood</slot>
    <shuffleable>true</shuffleable>
    <spawnCategories>
      <li>Dominion_Warrior</li>
    </spawnCategories>
    <workDisables>
      <li>Artistic</li>
      <li>Caring</li>
      <li>PlantWork</li>
      <li>Animals</li>
      <li>Social</li>
    </workDisables>
    <skillGains>
      <Melee>4</Melee>
      <Shooting>4</Shooting>
    </skillGains>
    <forcedTraits>
      <Psychopath>0</Psychopath> </forcedTraits>
    <disallowedTraits>
      <Wimp>0</Wimp>
      <Kind>0</Kind>
    </disallowedTraits>
  </BackstoryDef>

