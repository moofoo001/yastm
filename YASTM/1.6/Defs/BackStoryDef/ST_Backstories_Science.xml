<Defs>
  <BackstoryDef>
    <defName>ST_Adult_Starfleet_Science_Astrometrics_Analyst</defName>
    <title>Starfleet astrometrics analyst</title>
    <titleShort>astrometrics</titleShort>
    <slot>Adulthood</slot>
    <baseDesc>Charts subspace currents and stellar anomalies, turning sensor noise into
      navigational insight and research leads.
    </baseDesc>
    <skillGains>
      <Intellectual>+2</Intellectual>
      <Crafting>+1</Crafting>
      <Shooting>+1</Shooting>
      <Artistic>+1</Artistic>
      <Mining>+1</Mining>
      <Animals>+1</Animals>
      <Plants>+1</Plants>
    </skillGains>
    <spawnCategories>
      <li>Starfleet_Science</li>
    </spawnCategories>
    <forcedTraits>
        <FastLearner>0</FastLearner>
    </forcedTraits>
    <disallowedTraits />
  </BackstoryDef>

  <BackstoryDef>
