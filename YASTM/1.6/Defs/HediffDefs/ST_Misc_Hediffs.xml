<?xml version="1.0" encoding="utf-8"?>
<Defs>

 <!-- Med Booster  -->
 
  <HediffDef>
    <defName>ST_Hediff_MedBooster</defName>
    <label>medical booster</label>
    <description>Temporary improvement in medical focus and coordination.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.95, 0.85)</defaultLabelColor>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <MedicalTendSpeed>0.30</MedicalTendSpeed>
          <SurgerySuccessChanceFactor>0.05</SurgerySuccessChanceFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

    <!-- hypospray effects -->
    <HediffDef>
      <defName>ST_Hypo_Analgesic</defName>
      <label>analgesic sedation</label>
      <description>Pain receptors are dampened by a hypospray injection.</description>
      <hediffClass>HediffWithComps</hediffClass>
      <defaultLabelColor>(0.6, 0.8, 1.0)</defaultLabelColor>
      <isBad>false</isBad>
      <comps>
        <li Class="HediffCompProperties_Disappears">
          <disappearsAfterTicks>15000~30000</disappearsAfterTicks> <showRemainingTime>true</showRemainingTime>
        </li>
      </comps>
      <stages>
        <li>
          <painFactor>0.1</painFactor> </li>
      </stages>
    </HediffDef>

    <!-- stimulant effect -->
    <HediffDef>
      <defName>ST_Hypo_Stimulant</defName>
      <label>cortical stimulant</label>
      <description>Metabolic activity boosted by hypospray injection.</description>
      <hediffClass>HediffWithComps</hediffClass>
      <defaultLabelColor>(1.0, 0.8, 0.4)</defaultLabelColor>
      <isBad>false</isBad>
      <comps>
        <li Class="HediffCompProperties_Disappears">
          <disappearsAfterTicks>10000~20000</disappearsAfterTicks>
          <showRemainingTime>true</showRemainingTime>
        </li>
      </comps>
      <stages>
        <li>
          <restFallFactor>0.5</restFallFactor> <capMods>
            <li>
              <capacity>Consciousness</capacity>
              <offset>0.20</offset>
            </li>
            <li>
              <capacity>Moving</capacity>
              <offset>0.15</offset>
            </li>
          </capMods>
        </li>
      </stages>
    </HediffDef>

    <!-- biobed monitoring -->
    <HediffDef>
        <defName>ST_Biobed_Monitoring</defName>
        <label>bio-monitor active</label>
        <description>Advanced sensors are actively monitoring vital signs and accelerating cellular regeneration.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <defaultLabelColor>(0.6, 1.0, 0.6)</defaultLabelColor>
        <isBad>false</isBad>
        <stages>
          <li>
            <statOffsets>
              <ImmunityGainSpeed>0.25</ImmunityGainSpeed> <InjuryHealingFactor>0.50</InjuryHealingFactor> </statOffsets>
          </li>
        </stages>
        <comps>
          <li Class="HediffCompProperties_Disappears">
            <disappearsAfterTicks>300</disappearsAfterTicks> <showRemainingTime>false</showRemainingTime>
          </li>
        </comps>
      </HediffDef>

    <!-- transporter nausea -->
    <HediffDef>
    <defName>ST_TransporterNausea</defName>
    <label>transporter nausea</label>
    <description>Brief disorientation following matter stream reintegration.</description> <!-- FIX -->
    <hediffClass>HediffWithComps</hediffClass>
    <stages>
        <li>
        <capMods>
            <li><capacity>Consciousness</capacity><offset>-0.05</offset></li>
            <li><capacity>Moving</capacity><offset>-0.05</offset></li>
        </capMods>
        </li>
    </stages>
    <comps>
        <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>18000</disappearsAfterTicks>
        </li>
    </comps>
    </HediffDef>

    <!-- stun mode -->
    <HediffDef>
        <defName>ST_Hediff_PhaserStunMode</defName>
        <description>Phaser Stun mode</description>
        <label>phaser set to stun</label>
        <isBad>false</isBad>
        <tendable>false</tendable>
        <stages><li><minSeverity>0</minSeverity></li></stages>
    </HediffDef>


    <!-- NEU: Ktarian Afterglow -->
    <HediffDef>
      <defName>ST_KtarianAfterglow</defName>
      <label>afterglow</label>
      <description>Lingering neural stimulation from the Ktarian game.</description>
      <hediffClass>HediffWithComps</hediffClass>
      <comps>
        <li Class="HediffCompProperties_Disappears">
          <disappearsAfterTicks>30000</disappearsAfterTicks>
        </li>
      </comps>
      <stages>
        <li>
          <label>afterglow</label>
          <capMods>
            <li>
              <capacity>Consciousness</capacity>
              <offset>0.02</offset>
            </li>
          </capMods>
          <statOffsets>
            <MoveSpeed>0.04</MoveSpeed>
          </statOffsets>
        </li>
      </stages>
    </HediffDef>

    <!-- NEU: Obsessive focus -->
      <HediffDef>
      <defName>ST_KtarianObsession</defName>
      <label>obsessive focus</label>
      <description>Compulsive fixation on the Ktarian game. Hard to focus on anything else.</description>
      <hediffClass>HediffWithComps</hediffClass>
      <comps>
          <li Class="HediffCompProperties_Disappears">
          <disappearsAfterTicks>90000</disappearsAfterTicks>
          </li>
      </comps>
      <stages>
          <li>
          <label>obsessive focus</label>
          <statOffsets>
              <WorkSpeedGlobal>0.08</WorkSpeedGlobal> 
              <GlobalLearningFactor>-0.10</GlobalLearningFactor>
              <SocialImpact>-0.15</SocialImpact>
          </statOffsets>
          </li>
      </stages>
      </HediffDef>

    <!-- Field Triage Buff -->
    <HediffDef>
    <defName>ST_FieldTriageBuff</defName>
    <label>field triage</label>
    <description>Provides a temporary boost to medical tend speed and immunity gain, while slightly reducing pain.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.65,0.95,1)</defaultLabelColor>
    <tendable>false</tendable>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3000</disappearsAfterTicks> 
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MedicalTendSpeed>0.25</MedicalTendSpeed>
          <ImmunityGainSpeed>0.05</ImmunityGainSpeed>
        </statOffsets>
        <painOffset>-0.05</painOffset>
      </li>
    </stages>
  </HediffDef>

  <!-- alert status -->
  <HediffDef>
    <defName>ST_Alert_RedState</defName>
    <label>red alert</label>
    <description>All hands to stations.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
      <statOffsets>
            <WorkSpeedGlobal>0.05</WorkSpeedGlobal>
            <MoveSpeed>0.05</MoveSpeed>
            <AimingDelayFactor>-0.05</AimingDelayFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

    <!-- yellow alert -->

  <HediffDef>
    <defName>ST_Alert_YellowState</defName>
    <label>yellow alert</label>
    <description>Heightened readiness.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
            <WorkSpeedGlobal>0.03</WorkSpeedGlobal> <!-- +3% -->
            <MoveSpeed>0.03</MoveSpeed> <!-- +3% -->
        </statOffsets>
      </li>
    </stages>
  </HediffDef>


  <!-- command presence buff -->
  <HediffDef>
    <defName>ST_CommandPresenceBuff</defName>
    <label>command presence</label>
    <description>Leadership aura that steadies nerves and improves coordination.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2200</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>0.10</MoveSpeed>
          <AimingDelayFactor>-0.05</AimingDelayFactor>
          <ShootingAccuracyPawn>0.05</ShootingAccuracyPawn>
          <MentalBreakThreshold>-0.03</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

    <!-- tactical overwatch buff -->
  <HediffDef>
    <defName>ST_TacticalOverwatchBuff</defName>
    <label>tactical overwatch</label>
    <description>Assumes a steady firing stance, improving aim at the cost of mobility.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>900</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <AimingDelayFactor>-0.15</AimingDelayFactor>
          <ShootingAccuracyPawn>0.03</ShootingAccuracyPawn>
          <MoveSpeed>-0.05</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- medical Tricorder -->
  <HediffDef>
    <defName>ST_MedScan_Boost</defName>
    <label>medical scan</label>
    <description>Fine-tuned treatment based on tricorder scan results.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>36000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0.85</painFactor>
        <statOffsets>
          <ImmunityGainSpeed>0.20</ImmunityGainSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- science Tricorder -->
  <HediffDef>
    <defName>ST_ScienceInsight</defName>
    <label>science insight</label>
    <description>New data informs better hypotheses and techniques.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>36000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ResearchSpeed>0.20</ResearchSpeed>
          <MiningYield>0.10</MiningYield>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- security Tricorder -->
  <HediffDef>
    <defName>ST_SecuritySweep</defName>
    <label>security sweep</label>
    <description>Heightened situational awareness after a tricorder sweep.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>36000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ShootingAccuracyPawn>0.10</ShootingAccuracyPawn>
          <MeleeHitChance>0.08</MeleeHitChance>
          <AimingDelayFactor>-0.08</AimingDelayFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- force-field drag -->
 <HediffDef>
    <defName>ST_Hediff_ForceFieldDrag</defName>
    <label>force-field drag</label>
    <description>Movement impeded by residual energy field.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55,0.85,1.0)</defaultLabelColor>
    <stages>
      <li>
        <label>force-field drag</label>
        <capMods/>
        <statOffsets>
          <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
          <ArmorRating_Heat>0.10</ArmorRating_Heat>
          <ShootingAccuracyPawn>-0.10</ShootingAccuracyPawn>
        </statOffsets>
        <statFactors>
          <MoveSpeed>0.70</MoveSpeed>
        </statFactors>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>90</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

  <!-- STARFLEET – Duty Focus-->
  <HediffDef>
    <defName>ST_Hediff_Starfleet_DutyFocus</defName>
    <label>duty focus</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>This pawn has recently reaffirmed their duty to Starfleet and the Federation.
      Their sense of responsibility sharpens their focus and work ethic for a limited time.</description>
    <initialSeverity>1</initialSeverity>
    <isBad>false</isBad>

    <stages>
      <li>
        <label>duty-focused</label>
        <statFactors>
          <WorkSpeedGlobal>1.10</WorkSpeedGlobal>
        </statFactors>
        <statOffsets>
          <MentalBreakThreshold>-0.03</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>

    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>45000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>


  <!-- KLINGON – Battle Oath Focus -->
  <HediffDef>
    <defName>ST_Hediff_Klingon_BattleFocus</defName>
    <label>battle focus</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>This warrior has recently sworn or renewed a blood oath.
      Honor and battle are at the center of their thoughts, sharpening their combat focus.</description>
    <initialSeverity>1</initialSeverity>
    <isBad>false</isBad>
    <stages>
      <li>
        <label>oathbound</label>
        <statFactors>
          <MoveSpeed>1.08</MoveSpeed>
        </statFactors>
        <statOffsets>
          <MeleeHitChance>0.10</MeleeHitChance>
          <MeleeDodgeChance>0.05</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>

    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>30000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>


  <!-- ROMULAN – Analysis Trance -->
  <HediffDef>
    <defName>ST_Hediff_Romulan_AnalysisFocus</defName>
    <label>analysis focus</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>This pawn is in a state of intense, controlled analytical focus,
      shutting out distractions to process data, plots and intelligence.</description>
    <initialSeverity>1</initialSeverity>
    <isBad>false</isBad>

    <stages>
      <li>
        <label>deep analysis</label>
        <statFactors>
          <ResearchSpeed>1.20</ResearchSpeed>
          <GlobalLearningFactor>1.10</GlobalLearningFactor>
        </statFactors>
        <statOffsets>
          <MoveSpeed>-0.08</MoveSpeed>
        </statOffsets>
      </li>
    </stages>

    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>


  <!-- FERENGI – Profit High -->
  <HediffDef>
    <defName>ST_Hediff_Ferengi_ProfitHigh</defName>
    <label>profit high</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>This Ferengi has recently concluded a profitable deal or profit ceremony.
      Latinum dreams sharpen their bargaining and business instincts.</description>
    <initialSeverity>1</initialSeverity>
    <isBad>false</isBad>

    <stages>
      <li>
        <label>profit-inspired</label>
        <statFactors>
          <TradePriceImprovement>1.15</TradePriceImprovement>
        </statFactors>
        <statOffsets>
          <WorkSpeedGlobal>0.05</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </stages>

    <comps>
      <li Class="HediffCompProperties_Disappears">

        <disappearsAfterTicks>30000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <!-- Neural Interface Implant -->
  <HediffDef ParentName="ImplantHediffBase">
    <defName>ST_Hediff_NeuralInterface</defName>
    <label>neural interface ports</label>
    <labelNoun>a neural interface</labelNoun>
    <description>Implanted neural ports at the temples that allow connection of external sensory devices like a V.I.S.O.R.</description>
    <defaultLabelColor>(0.6, 0.7, 1.0)</defaultLabelColor> <stages>
      <li>
        <statOffsets>
          <GlobalLearningFactor>0.05</GlobalLearningFactor>
        </statOffsets>
      </li>
    </stages>
    <spawnThingOnRemoved>ST_NeuralInterfaceKit</spawnThingOnRemoved>
  </HediffDef>

  <HediffDef>
    <defName>ST_Hediff_VisorUplink</defName>
    <label>VISOR uplink</label>
    <description>The V.I.S.O.R. is actively transmitting full-spectrum visual data to the neural cortex via the implanted interface.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.8, 1.0)</defaultLabelColor> <isBad>false</isBad>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <offset>1.20</offset>
          </li>
        </capMods>
        <statOffsets>
             <ResearchSpeed>0.25</ResearchSpeed>
             <ShootingAccuracyPawn>3.0</ShootingAccuracyPawn>
             <WorkSpeedGlobal>0.10</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Holodeck Holographic Projection -->
<HediffDef>
    <defName>ST_Hediff_HolographicProjection</defName>
    <label>holographic matrix</label>
    <hediffClass>HediffWithComps</hediffClass> 
    <description>This entity is a hard-light projection. It vanishes if disrupted.</description>
    <isBad>false</isBad>
        <stages>
          <li>
            <painFactor>0</painFactor>
            <becomeVisible>false</becomeVisible>
          </li>
        </stages>
        <comps>
          <li Class="YASTM.HediffCompProperties_Hologram" />
        </comps>
  </HediffDef>

  <!-- Cloaking Field -->
<HediffDef>
    <defName>ST_CloakingField</defName>
    <label>cloaked</label>
    <description>Light refraction field active. Subject is invisible to sensors and visuals.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300</disappearsAfterTicks> <showRemainingTime>true</showRemainingTime>
      </li>
      
      <li Class="HediffCompProperties_Invisibility">
        <visibleToPlayer>false</visibleToPlayer> </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ShootingAccuracyPawn>2.0</ShootingAccuracyPawn>
          <MeleeDodgeChance>50.0</MeleeDodgeChance>
          <HuntingStealth>1.0</HuntingStealth> </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- Buffer Time -->

  <HediffDef>
    <defName>ST_BufferTime_Bliss</defName>
    <label>buffer time vibe</label>
    <description>Currently enjoying (or recovering from) unauthorized buffer time. Work speed is reduced, but stress is non-existent.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <WorkSpeedGlobal>-0.30</WorkSpeedGlobal>
          <MentalBreakThreshold>-0.15</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>15000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <!-- ===== DOMINION: Shroud Cloak ===== -->
  <HediffDef>
    <defName>ST_Hediff_ShroudCloak</defName>
    <label>Shrouded</label>
    <hediffClass>HediffWithComps</hediffClass>
    <description>Visually undetectable.</description>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="HediffCompProperties_Invisibility">
        <visibleToPlayer>true</visibleToPlayer> </li>
    </comps>
    <isBad>false</isBad>
  </HediffDef>


  <!-- Morphogenic Matrix -->
  <HediffDef>
    <defName>ST_Hediff_MorphogenicMatrix</defName>
    <label>morphogenic matrix</label>
    <description>This being's physiology is based on a morphogenic liquid matrix. It does not possess internal organs in the traditional sense, does not bleed, and absorbs kinetic energy effectively.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(255, 215, 0)</defaultLabelColor>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <totalBleedFactor>0</totalBleedFactor> <painFactor>0.1</painFactor> <statFactors>
          <IncomingDamageFactor>0.25</IncomingDamageFactor> </statFactors>
        <capMods>
            <li><capacity>Manipulation</capacity><offset>0.2</offset></li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_DisappearsOnDeath"/>
    </comps>
  </HediffDef>

</Defs>
