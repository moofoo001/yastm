  </RulePackDef>

  <RulePackDef>
    <defName>NamerDeity_Klingon</defName>
    <rulePack>
      <rulesStrings>
        <li>r_deityName->Kahless the Unforgettable</li>
        <li>r_deityName->The Black Fleet</li>
        <li>r_deityName->Fek'lhr</li>
        <li>r_deityName->The Ancestors</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>DeityTypeMaker_Klingon</defName>
    <rulePack>
      <rulesStrings>
        <li>r_deityType->Warriors who have proven themselves in glorious battle.</li>
        <li>r_deityType->Guardians of honor watching from Sto'Vo'Kor.</li>
        <li>r_deityType->The dread Fek'lhr who rules Gre'thor, the Klingon underworld.</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

