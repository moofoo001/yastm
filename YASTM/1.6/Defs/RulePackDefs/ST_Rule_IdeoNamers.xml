  <RulePackDef>
    <defName>NamerDeity_Klingon</defName>
    <rulePack>
      <rulesStrings>
        <li>r_deityName->Kahless the Unforgettable</li>
        <li>r_deityName->The Black Fleet</li>
        <li>r_deityName->Fek'lhr</li>
        <li>r_deityName->The Ancestors</li>
