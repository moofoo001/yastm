<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Ideology names expect r_ideoName / r_ideoAdjective / r_memberName -->
  <RulePackDef>
    <defName>NamerIdeoName_Starfleet</defName>
    <rulePack>
      <rulesStrings>
        <li>r_ideoName-> [maybePrefix][baseUFP]</li>
        <li>r_ideoAdjective-> [ufpAdj]</li>
        <li>r_memberName-> [ufpMember]</li>

        <li>maybePrefix-> [hyphenPrefix]-</li>
        <li>maybePrefix-> </li>

        <li>hyphenPrefix-> [memeHyphenPrefix]</li>
        <li>hyphenPrefix-> [memeLeaderAdjective]</li>
        <li>hyphenPrefix-> [memeAdjective]</li>

        <li>ufpAdj-> federated</li>
        <li>ufpAdj-> exploratory</li>
        <li>ufpAdj-> scientific</li>
        <li>ufpAdj-> humanitarian</li>

        <li>ufpMember-> officer</li>
        <li>ufpMember-> explorer</li>
        <li>ufpMember-> citizen</li>

        <li>baseUFP-> Federation Doctrine</li>
        <li>baseUFP-> Prime Directive</li>
        <li>baseUFP-> Starfleet Charter</li>
        <li>baseUFP-> Explorers' Ethos</li>
        <li>baseUFP-> Scientific Mandate</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>NamerDeity_UFP</defName>
    <rulePack>
      <rulesStrings>
        <li>r_deityName->IDIC</li>
        <li>r_deityName->The Great Bird of the Galaxy</li>
        <li>r_deityName->The Federation Charter</li>
        <li>r_deityName->The Council of Worlds</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <RulePackDef>
    <defName>DeityTypeMaker_UFP</defName>
    <rulePack>
      <rulesStrings>
        <li>r_deityType->Infinite Diversity in Infinite Combinations, a Vulcan ideal.</li>
        <li>r_deityType->The guiding spirit of exploration and unity.</li>
        <li>r_deityType->Principles enshrined in the Federation’s founding document.</li>
        <li>r_deityType->Voices of countless worlds joined in harmony.</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>


