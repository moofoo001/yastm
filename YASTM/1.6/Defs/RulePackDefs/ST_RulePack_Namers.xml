<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Faction names -->
  <RulePackDef>
    <defName>ST_NamerFedFaction</defName>
    <rulePack>
      <rulesStrings>
        <li>name->[FederationName]</li>
        <li>name->[FedPrefix] [FedDept]</li>
        <li>name->[FedPrefix] [FedDept] - [SectorTag]</li>

        <li>FederationName->United Federation of Planets</li>

        <li>FedPrefix->Federation</li>
        <li>FedPrefix->Starfleet</li>
        <li>FedPrefix->UFP</li>

        <li>FedDept->Liaison Office</li>
        <li>FedDept->Diplomatic Corps</li>
        <li>FedDept->Exploration Command</li>
        <li>FedDept->Research Directorate</li>
        <li>FedDept->Logistics Command</li>
        <li>FedDept->Colonial Affairs</li>

        <li>SectorTag->Sector Alpha</li>
        <li>SectorTag->Sector Beta</li>
        <li>SectorTag->Sector Gamma</li>
        <li>SectorTag->Sector Delta</li>
        <li>SectorTag->Perseus Arm</li>
        <li>SectorTag->Taurus Reach</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>

  <!-- Settlement/base names -->
  <RulePackDef>
    <defName>ST_NamerFedBase</defName>
    <rulePack>
      <rulesStrings>
        <li>name->Starbase [Roman]</li>
        <li>name->Research Station [Greek]</li>
        <li>name->Federation Outpost [Greek]</li>
        <li>name->UFP Colony [Greek]</li>
        <li>name->Observation Post [Greek]</li>

        <!-- Roman numerals -->
        <li>Roman->I</li><li>Roman->II</li><li>Roman->III</li><li>Roman->IV</li><li>Roman->V</li>
        <li>Roman->VI</li><li>Roman->VII</li><li>Roman->VIII</li><li>Roman->IX</li><li>Roman->X</li>
        <li>Roman->XI</li><li>Roman->XII</li><li>Roman->XIII</li><li>Roman->XIV</li><li>Roman->XV</li>
        <li>Roman->XVI</li><li>Roman->XVII</li><li>Roman->XVIII</li><li>Roman->XIX</li><li>Roman->XX</li>

        <!-- Greek letters -->
        <li>Greek->Alpha</li><li>Greek->Beta</li><li>Greek->Gamma</li><li>Greek->Delta</li><li>Greek->Epsilon</li>
        <li>Greek->Zeta</li><li>Greek->Eta</li><li>Greek->Theta</li><li>Greek->Iota</li><li>Greek->Kappa</li>
        <li>Greek->Lambda</li><li>Greek->Mu</li><li>Greek->Nu</li><li>Greek->Xi</li><li>Greek->Omicron</li>
        <li>Greek->Pi</li><li>Greek->Rho</li><li>Greek->Sigma</li><li>Greek->Tau</li><li>Greek->Upsilon</li>
        <li>Greek->Phi</li><li>Greek->Chi</li><li>Greek->Psi</li><li>Greek->Omega</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>


