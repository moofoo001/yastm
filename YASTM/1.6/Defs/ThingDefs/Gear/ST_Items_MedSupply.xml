<!-- Medical Booster -->
   <ThingDef ParentName="DrugBase">
    <defName>ST_MedicalBooster</defName>
    <label>medical booster</label>
    <description>A fast-acting pharmacological booster that briefly improves tending and surgical performance.</description>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>Things/Item/Equipment/Utilities/ST_MedBooster</texPath>
      <drawSize>(0.60,0.60)</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>52</MarketValue>
      <Mass>0.03</Mass>
      <SellPriceFactor>1.0</SellPriceFactor>
    </statBases>
    <ingestible>
      <drugCategory>Medical</drugCategory>
      <preferability>NeverForNutrition</preferability>
      <foodType>Fluid</foodType>
      <ingestSound>Ingest_Drink</ingestSound>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>ST_Hediff_MedBooster</hediffDef>
          <severity>1.0</severity>
        </li>
      </outcomeDoers>
      <chairSearchRadius>8</chairSearchRadius>
      <maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
      <defaultNumToIngestAtOnce>1</defaultNumToIngestAtOnce>
    </ingestible>
  </ThingDef>


  
</Defs>
