<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Legendary, unique melee weapon: Sword of Kahless -->
  <ThingDef ParentName="ST_MeleeBase">
    <defName>ST_SwordOfKahless</defName>
    <label>Sword of Kahless</label>
    <description>The legendary bat'leth of Kahless the Unforgettable. Its return is said to unite
      all Klingons under one banner and ignite an unstoppable hunger for glorious battle.</description>

    <relicChance>5</relicChance>
    <smeltable>false</smeltable>
    <weaponClasses>
      <li>MeleePiercer</li>
    </weaponClasses>

    <graphicData>
      <texPath>Things/Item/Equipment/Klingon_weapons/SWKahless</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1, 1)</drawSize>
    </graphicData>
    <uiIconScale>1</uiIconScale>

    <tools>
      <li>
        <label>blade edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>30</power>
        <cooldownTime>1.7</cooldownTime>
        <linkedBodyPartsGroup>Torso</linkedBodyPartsGroup>
        <chanceFactor>1.0</chanceFactor>
        <armorPenetration>0.7</armorPenetration>
      </li>
    </tools>

    <stackLimit>1</stackLimit>
    <tradeNeverStack>true</tradeNeverStack>
    <techLevel>Spacer</techLevel>

    <weaponTags>
      <li>KlingonRelic</li>
    </weaponTags>

    <statBases>
      <Mass>3.0</Mass>
      <MarketValue>6000</MarketValue>
    </statBases>
    
    <recipeMaker>
      <researchPrerequisite>ST_Klingon_Melee_III</researchPrerequisite>
      <skillRequirements>
        <Crafting>14</Crafting>
    </skillRequirements>

    </recipeMaker>
    <equippedStatOffsets>
      <MeleeHitChance>0.1</MeleeHitChance>
    </equippedStatOffsets>

  </ThingDef>

<ThingDef ParentName="BuildingBase">
    <defName>ST_RessikanFluteBox</defName>
    <label>Ressikan flute</label>
    <description>A simple tin flute in a box. For most, it's a beautiful antique. For some, it's a lifetime of memories. (Hint: Try letting a certain Captain play it...)</description>
    <thingClass>YASTM.Building_RessikanFlute</thingClass>
    <tickerType>Rare</tickerType>
    <graphicData>
      <texPath>Things/Item/Special/FluteBox</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(0.8,0.8)</drawSize>
    </graphicData>
    <uiIconScale>0.8</uiIconScale>
    <uiIconPath>Things/Item/Special/FluteBox</uiIconPath>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <clearBuildingArea>false</clearBuildingArea>
    <statBases>
      <Mass>0.5</Mass>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
      <Beauty>250</Beauty>
      <JoyGainFactor>1.2</JoyGainFactor>
    </statBases>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <building>
      <joyKind>ST_RessikanMemory</joyKind>
      <isEdifice>false</isEdifice>
    </building> 
    <minifiedDef>MinifiedThing</minifiedDef>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Glower">
        <overlightRadius>1.0</overlightRadius>
        <glowRadius>2</glowRadius>
        <glowColor>(370,370,370,0)</glowColor>
      </li>
    </comps>
    <thingCategories>
      <li>BuildingsArt</li>
    </thingCategories>
    <soundInteract>ST_Sound_RessikanFlute_Melody</soundInteract>
  </ThingDef>


</Defs>
