<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Legendary, unique melee weapon: Sword of Kahless -->
  <ThingDef ParentName="ST_MeleeBase">
    <defName>ST_SwordOfKahless</defName>
    <label>Sword of Kahless</label>
    <description>The legendary bat'leth of Kahless the Unforgettable. Its return is said to unite
      all Klingons under one banner and ignite an unstoppable hunger for glorious battle.</description>

    <relicChance>5</relicChance>
    <smeltable>false</smeltable>
    <weaponClasses>
      <li>MeleePiercer</li>
    </weaponClasses>

    <graphicData>
      <texPath>Things/Item/Equipment/Klingon_weapons/SWKahless</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1, 1)</drawSize>
    </graphicData>
    <uiIconScale>1</uiIconScale>

    <tools>
      <li>
        <label>blade edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>30</power>
        <cooldownTime>1.7</cooldownTime>
        <linkedBodyPartsGroup>Torso</linkedBodyPartsGroup>
        <chanceFactor>1.0</chanceFactor>
        <armorPenetration>0.7</armorPenetration>
      </li>
    </tools>

    <stackLimit>1</stackLimit>
    <tradeNeverStack>true</tradeNeverStack>
    <techLevel>Spacer</techLevel>

    <weaponTags>
      <li>KlingonRelic</li>
    </weaponTags>

    <statBases>
      <Mass>3.0</Mass>
      <MarketValue>6000</MarketValue>
    </statBases>

    <equippedStatOffsets>
      <MeleeHitChance>0.1</MeleeHitChance>
    </equippedStatOffsets>

  </ThingDef>

</Defs>
