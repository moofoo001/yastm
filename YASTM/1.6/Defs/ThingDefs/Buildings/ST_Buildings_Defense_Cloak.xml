<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>ST_CloakInterference</defName>
    <label>sensor interference</label>
    <description>Targeting systems are scrambling due to a romulan cloaking field active in the area.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.5, 0.5, 0.5)</defaultLabelColor>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>400~600</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
            <ShootingAccuracyPawn>-5.0</ShootingAccuracyPawn>
            <AimingDelayFactor>1.5</AimingDelayFactor>
            <MeleeHitChance>-0.2</MeleeHitChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <ThingDef ParentName="BuildingBase">
    <defName>ST_Building_CloakingGenerator</defName>
    <label>cloaking field generator</label>
    <description>A massive Romulan device that projects a sensor-scrambling field across the entire map. While it cannot make buildings fully invisible to the naked eye, it creates "ghost signals" that confuse enemy targeting computers and eyesight.\n\nEffect: Enemies suffer massive accuracy penalties.\nPower Usage: Very High.</description>
    <graphicData>
      <texPath>Things/Building/Romulan/ST_CloakingGen</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <shadowData>
        <volume>(2.5, 1.0, 2.5)</volume>
      </shadowData>
    </graphicData>
    <size>(3,3)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.6</fillPercent>
    <statBases>
      <MaxHitPoints>500</MaxHitPoints>
      <WorkToBuild>6000</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Mass>150</Mass>
    </statBases>
    <costList>
      <Steel>300</Steel>
      <Plasteel>50</Plasteel>
      <ComponentSpacer>4</ComponentSpacer>
      <Uranium>20</Uranium> </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>2500</basePowerConsumption> </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="YASTM.CompProperties_CloakingField" />
    </comps>
    <designationCategory>ST_Designation</designationCategory>
    <researchPrerequisites>
      <li>Romulan_CloakingSystems</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>