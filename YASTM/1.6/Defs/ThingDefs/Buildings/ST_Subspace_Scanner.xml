<?xml version="1.0" encoding="utf-8"?>
<Defs>

 <ThingDef ParentName="BuildingBase">
    <defName>ST_Subspace_Scanner</defName>
    <label>subspace scanner</label>
    <description>Wide-area subspace sweep emitter. Must be linked to a science console to initiate scans.</description>

    <!-- Graphics (add a PNG at this path) -->
    <graphicData>
      <texPath>Things/Building/Science/ST_SubspaceScanner</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2.5,2.6)</drawSize>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>


    <!-- Placement / interaction -->
    <size>(2,2)</size>
    <rotatable>true</rotatable>
    <passability>PassThroughOnly</passability>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>

    <selectable>true</selectable>

    <statBases>
      <WorkToBuild>1200</WorkToBuild>
      <MaxHitPoints>250</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <Mass>30</Mass>
    </statBases>
    <thingClass>Building</thingClass>


    <comps>
      <li Class="RimWorld.CompProperties_Power">
        <compClass>RimWorld.CompPowerTrader</compClass>
        <basePowerConsumption>350</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>

      <li Class="YASTM.Comps.CompProperties_SubspaceScanner" />

      <!-- Accepts the science console as facility/controller -->
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ST_ScienceConsole</li>
        </linkableFacilities>
      </li>

      <!-- Proximity link to both obelisks 
      <li Class="RimWorld.CompProperties_Facility">
        <linkableBuildings>
          <li>ST_Obelisk_A</li>
          <li>ST_Obelisk_B</li>
        </linkableBuildings>
        <mustBePlacedAdjacent>false</mustBePlacedAdjacent>
        <maxSimultaneous>2</maxSimultaneous>
      </li>
      -->
    </comps>
    
    <modExtensions>
      <li Class="YASTM.DefModExt_LinkTags">
        <tags>
          <li>ST_Link_Science</li>
        </tags>
      </li>
    </modExtensions>
    
    <uiOrder>2001</uiOrder>

    <placeWorkers>
      <li>RimWorld.PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    
    <soundInteract>ST_SFX_LCARS_Click</soundInteract>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>120</costStuffCount>
    
    <costList>
      <ComponentIndustrial>6</ComponentIndustrial>
      <Plasteel>30</Plasteel>
    </costList>
    <designationCategory>ST_Designation</designationCategory>


  </ThingDef>

</Defs>
