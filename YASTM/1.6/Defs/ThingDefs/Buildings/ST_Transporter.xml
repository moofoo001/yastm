    <ThingDef ParentName="BuildingBase">
    <defName>ST_TransporterPad</defName>
    <label>transporter pad</label>
    <description>Landing pad for transporter operations. Must be linked to a transporter console.</description>
    <thingClass>Building</thingClass>
    <size>(1,1)</size>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <rotatable>false</rotatable>
    <graphicData>
      <texPath>Things/Building/Transporter/ST_Pad</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <uiIconPath>Things/Building/Transporter/ST_Pad</uiIconPath>
    <costList>
      <Steel>25</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToBuild>300</WorkToBuild>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>0.2</Flammability>
    </statBases>
    <comps>
      <!-- leichter Stromverbrauch -->
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>20</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <!-- Facility: verlinkt zu Konsolen -->
      <li Class="CompProperties_Facility">
        <linkableBuildings>
          <li>ST_TransporterConsole</li>
        </linkableBuildings>
        <maxSimultaneous>1</maxSimultaneous>
        <requiresLOS>false</requiresLOS>
        <statOffsets/>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <designationCategory>ST_Designation</designationCategory>
    <researchPrerequisites>
      <li>ST_TransporterTech</li>
    </researchPrerequisites>
  </ThingDef>

    <ThingDef ParentName="BenchBase">
    <defName>ST_TransporterConsole</defName>
    <label>transporter console</label>
    <description>Starfleet console controlling beam operations. Must be linked to a transporter pad.</description>
    <thingClass>Building</thingClass>
    <size>(2,1)</size>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <graphicData>
      <texPath>Things/Building/Transporter/ST_Console</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2.5,3)</drawSize>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <uiIconPath>Things/Building/Transporter/ST_Console</uiIconPath>
    <costList>
      <Steel>70</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToBuild>1200</WorkToBuild>
      <MaxHitPoints>220</MaxHitPoints>
      <Flammability>0.2</Flammability>
    </statBases>
    <comps>
      <!-- Power -->
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>300</basePowerConsumption>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>8</glowRadius>
        <glowColor>(0,218,255,255)</glowColor>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ST_TransporterPad</li>
        </linkableFacilities>
      </li>
      <li Class="YASTM.CompProperties_TransporterConsole">
        <energyCostPerUse>1200</energyCostPerUse>
        <warmupTicks>60</warmupTicks>
        <cooldownTicks>120000</cooldownTicks>
        <maxLinkDistance>100</maxLinkDistance>

        <!-- Mindest-Rang für BEAM OUT -->
        <requiredRankTraitsBeamOut>
          <li>ST_Rank_LieutenantJG</li>
          <li>ST_Rank_Lieutenant</li>
          <li>ST_Rank_LtCommander</li>
          <li>ST_Rank_Commander</li>
          <li>ST_Rank_Captain</li>
        </requiredRankTraitsBeamOut>

        <!-- Mindest-Rang für BEAM IN -->
        <requiredRankTraitsBeamIn>
          <li>ST_Rank_LieutenantJG</li>
          <li>ST_Rank_Lieutenant</li>
          <li>ST_Rank_LtCommander</li>
          <li>ST_Rank_Commander</li>
          <li>ST_Rank_Captain</li>
        </requiredRankTraitsBeamIn>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <designationCategory>ST_Designation</designationCategory>
    <researchPrerequisites>
      <li>ST_TransporterTech</li>
    </researchPrerequisites>
  </ThingDef>
  
</Defs>
