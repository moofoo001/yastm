<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>ST_TransporterConsole</defName>
    <label>Transporter Console</label>
    <description>A control station for matter transportation. Links to a Transporter Pad. Allows standard pad-to-pad transport and high-energy tactical site-to-site transport.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Transporter/ST_Console</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2.5,2.6)</drawSize>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <size>(3,1)</size>
    <rotatable>true</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.5</fillPercent>
    
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0, 0, -1)</interactionCellOffset>

    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <ST_DilithiumCrystal>2</ST_DilithiumCrystal>
    </costList>

    <statBases>
      <Mass>100</Mass>
      <WorkToBuild>1200</WorkToBuild>
      <MaxHitPoints>220</MaxHitPoints>
      <Flammability>0.2</Flammability>
    </statBases>

    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>350</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ST_TransporterPad</li>
        </linkableFacilities>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>2</glowRadius>
        <glowColor>(137,207,240,100)</glowColor>
      </li> 
      <li Class="YASTM.CompProperties_TransporterConsole">
        <energyCostPerUse>1200</energyCostPerUse>
        <tacticalBeamEnergyCost>2500</tacticalBeamEnergyCost>
        <maxLinkedPads>5</maxLinkedPads> 
        <warmupTicks>60</warmupTicks>
        <cooldownTicks>120000</cooldownTicks>
        <maxLinkDistance>30</maxLinkDistance>
      </li>
    </comps>

    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>

    <researchPrerequisites>
      <li>ST_AdvancedTransporterTech</li>
    </researchPrerequisites>
    <uiOrder>2006</uiOrder>

    <designationCategory>ST_Designation</designationCategory>
    <designatorDropdown>ST_Consoles_Group</designatorDropdown>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>ST_TransporterPad</defName>
    <label>Transporter Pad</label>
    <description>The molecular imaging scanner and phase transition coil assembly. Must be linked to a console.</description>
    <graphicData>
      <texPath>Things/Building/Transporter/ST_Pad</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <designationCategory>ST_Designation</designationCategory>
    <designatorDropdown>ST_Consoles_Group</designatorDropdown>
    <costList>
      <Steel>25</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <statBases>
      <Mass>20</Mass>
      <WorkToBuild>300</WorkToBuild>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>0.2</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Facility">
        <maxSimultaneous>5</maxSimultaneous> </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>1</glowRadius>
        <glowColor>(137,207,240,20)</glowColor>
      </li> 
    </comps>
    <researchPrerequisites>
      <li>ST_AdvancedTransporterTech</li>
    </researchPrerequisites>
    <uiOrder>2007</uiOrder>
  </ThingDef>

</Defs>