<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="TableGatherSpotBase">
		<defName>ST_ShipTable</defName>
		<label>UFP standard table</label>
		<description>A comfortable and elegant table. For home and Starfleet Ship interiors</description>
		<size>(2,1)</size>
		<graphicData>
			<texPath>Things/Building/Interiors/ST_table_mid</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2.0,2.0)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<uiIconScale>1</uiIconScale>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<WorkToBuild>200</WorkToBuild>
			<Mass>25</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>5</Beauty>
		</statBases>
		<costStuffCount>50</costStuffCount>
		<costList>
			<Gold>10</Gold>
		</costList>
		<building>
			<paintable>true</paintable>
		</building>
		<researchPrerequisites>
			<li>ST_UFP_Interior</li>
		</researchPrerequisites>
		<designationCategory>ST_Designation</designationCategory>
	</ThingDef>

	<ThingDef ParentName="FurnitureWithQualityBase">
		<defName>ST_ShipChair</defName>
		<label>UFP standard chair</label>
		<description>A comfortable and elegant chair. For home and Starfleet Ship interiors</description>
    <replaceTags>
      <li>Chair</li>
    </replaceTags>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Interiors/ST_chair</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1.2,1.2)</drawSize>
			<damageData>
				<rectN>(0,0,1,0.703125)</rectN>
				<rectS>(0.09375,0,0.84375,1)</rectS>
				<rectE>(0,0,0.84375,0.625)</rectE>
				<rectW>(0.15625,0,0.84375,0.625)</rectW>
			</damageData>
			<shadowData>
				<volume>(0.25, 0.28, 0.25)</volume>
			</shadowData>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<uiIconScale>1</uiIconScale>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<WorkToBuild>10000</WorkToBuild>
			<Mass>15</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>5</Beauty>
			<Comfort>0.90</Comfort>
		</statBases>
		<socialPropernessMatters>true</socialPropernessMatters>
		<stuffCategories>
      <li>Fabric</li>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>150</costStuffCount>
		<pathCost>30</pathCost>
		<fillPercent>0.35</fillPercent>
		<defaultPlacingRot>South</defaultPlacingRot>
		<!--uiIconOffset>0,0.15</uiIconOffset-->
		<building>
			<isSittable>true</isSittable>
			<paintable>true</paintable>
      <destroySound>BuildingDestroyed_Soft_Small</destroySound>
		</building>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<researchPrerequisites>
			<li>ST_UFP_Interior</li>
		</researchPrerequisites>
		<designationCategory>ST_Designation</designationCategory>
    <comps>
      <li Class="CompProperties_Styleable" />
    </comps>
	</ThingDef>

  <!-- A) LCARS Wall Light -->
    <ThingDef ParentName="BuildingBase">
    <defName>ST_WallLight_LCARS</defName>
    <label>LCARS wall light</label>
    <description>Sleek wall-mounted LCARS light panel.</description>

    <thingClass>Building</thingClass>
    <size>(1,1)</size>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <fillPercent>0.1</fillPercent>
    <pathCost>0.1</pathCost>
    <passability>PassThroughOnly</passability>
    <uiIconPath>Things/Building/Interiors/ST_LCARS_light</uiIconPath>
    
    <graphicData>
      <texPath>Things/Building/Interiors/ST_LCARS_light</texPath>
      <shaderType>CutoutComplex</shaderType>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
      <drawOffsetNorth>(0,0,-0.2)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,0.2)</drawOffsetSouth>
      <drawOffsetWest>(0.45,0,0)</drawOffsetWest>
      <drawOffsetEast>(-0.45,0,0)</drawOffsetEast>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    
    <statBases>
      <WorkToBuild>300</WorkToBuild>
      <Flammability>0.2</Flammability>
      <Beauty>2</Beauty>
      <MaxHitPoints>120</MaxHitPoints>
    </statBases>

    <costList>
      <Steel>15</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>

    <comps>  
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>25</basePowerConsumption>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(255,230,120,255)</glowColor>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
    <building>
		  <isEdifice>false</isEdifice>
		  <isAttachment>true</isAttachment>
		</building>
    <placeWorkers>
			<li>Placeworker_AttachedToWall</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <designationCategory>ST_Designation</designationCategory>
    <researchPrerequisites>
      <li>ST_UFP_Interior</li>
    </researchPrerequisites>
  </ThingDef>

   <!--  Biobed  -->
  <ThingDef ParentName="BedBase">
    <defName>ST_Biobed</defName>
    <label>biobed</label>
    <description>Advanced medical bed with integrated diagnostics and stabilizers.</description>
    <thingClass>Building_Bed</thingClass>
    <graphicData>
      <texPath>Things/Building/Interiors/ST_BioBed</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2,2)</drawSize>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <uiIconScale>1</uiIconScale>
    <tickerType>Normal</tickerType>
    <size>(1,2)</size>

    <statBases>
      <WorkToBuild>2200</WorkToBuild>
      <MaxHitPoints>220</MaxHitPoints>
      <Mass>25</Mass>
      <Flammability>0.2</Flammability>
      <BedRestEffectiveness>1.1</BedRestEffectiveness>
      <Comfort>0.7</Comfort>
      <ImmunityGainSpeedFactor>0.07</ImmunityGainSpeedFactor>
      <SurgerySuccessChanceFactor>0.10</SurgerySuccessChanceFactor>
      <MedicalTendQualityOffset>0.10</MedicalTendQualityOffset>
      <Beauty>5</Beauty>
    </statBases>

    <costList>
      <Steel>60</Steel>
      <Plasteel>20</Plasteel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <MedicineIndustrial>2</MedicineIndustrial>
    </costList>

    <building>
      <bed_showSleeperBody>true</bed_showSleeperBody>
      <bed_healPerDay>5</bed_healPerDay>
      <bed_defaultMedical>true</bed_defaultMedical>
      <paintable>true</paintable>
      <buildingSizeCategory>Small</buildingSizeCategory>
    </building>

    <fillPercent>0.4</fillPercent>
    <pathCost>60</pathCost>

    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>VitalsMonitor</li>
          <li>EndTable</li>
          <li>Dresser</li>
          <li MayRequire="Ludeon.RimWorld.Ideology">SleepAccelerator</li>
        </linkableFacilities>
      </li>

      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>120</basePowerConsumption>
      </li>
    </comps>

    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>

    <designationCategory>ST_Designation</designationCategory>
    <researchPrerequisites>
      <li>ST_UFP_Interior</li>
      <li>ST_Medical_diagnostics</li>
    </researchPrerequisites>

    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
  </ThingDef>

</Defs>