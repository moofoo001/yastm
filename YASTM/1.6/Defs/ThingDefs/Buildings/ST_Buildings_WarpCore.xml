<?xml version="1.0" encoding="utf-8" ?>
<Defs>


  <ThingDef ParentName="BuildingBase">
    <defName>ST_WarpCore</defName>
    <label>warp core</label>
    <description>A matter/antimatter reaction assembly. Generates massive amounts of power but requires Dilithium crystals and SIGNIFICANT cooling. Warning: Destruction while active will cause a catastrophic explosion.</description>
    <thingClass>Building</thingClass>
    <graphicData>
      <texPath>Things/Building/Power/ST_WarpCore</texPath> 
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.6,2.6)</drawSize>
      <shadowData>
        <volume>(1.8, 1.0, 1.8)</volume>
      </shadowData>
    </graphicData>
    <uiIconScale>0.6</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>150</pathCost>
    <blockWind>true</blockWind>
    <fillPercent>1.0</fillPercent>
    <rotatable>false</rotatable>
    <size>(2,2)</size>
    <tickerType>Normal</tickerType> <statBases>
      <MaxHitPoints>1000</MaxHitPoints> <WorkToBuild>8000</WorkToBuild>
      <Flammability>0</Flammability>
      <Mass>1000</Mass>
    </statBases>


    <costList>
      <Steel>500</Steel>
      <Plasteel>200</Plasteel>
      <Uranium>50</Uranium>
      <ComponentIndustrial>10</ComponentIndustrial>
      <ComponentSpacer>4</ComponentSpacer>
      <ST_DilithiumCrystal>10</ST_DilithiumCrystal>
    </costList>
    <constructionSkillPrerequisite>14</constructionSkillPrerequisite>

    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>-25000</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>

      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>2.0</fuelConsumptionRate>
        <fuelCapacity>100.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>ST_Dilithium_Refined</li>
          </thingDefs>
        </fuelFilter>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      

      <li Class="YASTM.CompProperties_WarpCore">
         <explosionRadius>50</explosionRadius>
         <!--safeTemperatureMax>60.0</safeTemperatureMax-->
         <!--pulseInterval>180</pulseInterval-->
         <pulseRadius>3.5</pulseRadius>
       </li>

      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />
      
      <li Class="CompProperties_Glower">
        <overlightRadius>7.0</overlightRadius>
        <glowRadius>14</glowRadius>
        <glowColor>(370,370,370,0)</glowColor>
      </li>

      <!--energy effect -->
      <li Class="CompProperties_ThrownFleckEmitter">
        <fleck>ElectricalSpark</fleck>
        <offsetMin>(-0.6,0,0.3)</offsetMin>
        <offsetMax>(0.6,0,0.5)</offsetMax>
        <emissionInterval>90</emissionInterval>
        <scale>1~1.5</scale>
        <colorA>(46, 128, 255, 255)</colorA> <!-- color: blue -->
        <colorB>(46, 128, 255, 100)</colorB>  
      </li>

      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>WarpCoreCooling</li>
        </linkableFacilities>
      </li>
      </comps>

    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>

    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>ST_Designation</designationCategory>
    <designatorDropdown>ST_PowerandProduction_Group</designatorDropdown>
    <uiOrder>3000</uiOrder>
    <researchPrerequisites>
      <li>ST_WarpFieldTheory</li> 
    </researchPrerequisites>
  </ThingDef>



<ThingDef ParentName="BuildingBase">
    <defName>WarpCoreCooling</defName>
    <label>warp core cooling system</label>
    <description>A massive cooling system required to dissipate the waste heat generated by a warp core. Must be built directly adjacent to the core.</description>
    <thingClass>Building</thingClass> <graphicData>
      <texPath>Things/Building/Power/ST_WarpCoreCooling</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <blockLight>true</blockLight>
    <canOverlapZones>false</canOverlapZones>
    <castEdgeShadows>true</castEdgeShadows>
    <blockWeather>true</blockWeather>
    <staticSunShadowHeight>1.0</staticSunShadowHeight>
    <statBases>
      <WorkToBuild>1600</WorkToBuild>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0.7</Flammability>
    </statBases>
    <tickerType>Rare</tickerType>
    <costList>
      <Steel>90</Steel>
      <Plasteel>100</Plasteel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>

    <building>
      <isAirtight>true</isAirtight>
    </building>

    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>1000</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      
      <li Class="CompProperties_Facility">
        <maxDistance>1</maxDistance>
        <mustBePlacedAdjacent>true</mustBePlacedAdjacent>
        <maxSimultaneous>1</maxSimultaneous>
      </li>
    </comps>

    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>

    <designationCategory>ST_Designation</designationCategory>
    <designatorDropdown>ST_PowerandProduction_Group</designatorDropdown>
    <uiOrder>4000</uiOrder>
    <researchPrerequisites>
      <li>ST_WarpFieldTheory</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
  </ThingDef>

</Defs>