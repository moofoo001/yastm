<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>ST_Building_CaptainsChair</defName>
    <label>Captain's Chair</label>
    <description>The center seat. Assign a high-ranking officer to 'Bridge' work to man this station.</description>
    <graphicData>
      <texPath>Things/Building/Interiors/ST_chair</texPath> 
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.2,1.2)</drawSize>
      <damageData>
        <rect>(0.1,0.1,0.8,0.8)</rect>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Flammability>0.3</Flammability>
      <Mass>20</Mass>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
      <Gold>5</Gold>
    </costList>
    <designationCategory>ST_Designation</designationCategory>
    
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,0)</interactionCellOffset> <comps>
        <li Class="YASTM.Source.Comps.CompProperties_BridgeStation">
            <role>Command</role>
            <mannable>true</mannable>
        </li>
        <li Class="CompProperties_Power">
            <compClass>CompPowerTrader</compClass>
            <basePowerConsumption>50</basePowerConsumption>
        </li>
    </comps>
  </ThingDef>

</Defs>