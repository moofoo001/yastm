<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>ST_ScienceConsole</defName>
    <label>science console</label>
    <description>Starfleet science console. Operates nearby subspace scanners (linked by tag) and provides a modest research buff like the former LCARS auxiliary console.</description>

    <!-- Graphics -->
    <graphicData>
      <texPath>Things/Building/Science/ST_ScienceConsole</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2.5,2.6)</drawSize>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>


    <!-- Placement / interaction -->
    <size>(2,1)</size>
    <rotatable>true</rotatable>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <passability>PassThroughOnly</passability>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <tickerType>Normal</tickerType>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <fillPercent>0.4</fillPercent>

    
    <statBases>
      <WorkToBuild>1000</WorkToBuild>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <Mass>20</Mass>
    </statBases>
    <thingClass>Building</thingClass>


    <comps>
      <li Class="RimWorld.CompProperties_Power">
        <compClass>RimWorld.CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
        <shortCircuitInRain>true</shortCircuitInRain>
      </li>

      <!-- Link to science devices by tag -->
      <li Class="YASTM.CompProperties_ConsoleLink">
        <maxLinkDistance>400</maxLinkDistance>
        <linkTags>
          <li>ST_Link_Science</li>
        </linkTags>
      </li>

      <li Class="CompProperties_Facility">
        <statOffsets>
          <ResearchSpeedFactor>0.04</ResearchSpeedFactor> <!-- +4% -->
        </statOffsets>
        <linkableBuildings>
          <li>SimpleResearchBench</li>
          <li>HiTechResearchBench</li>
          <li>ST_Subspace_Scanner</li>
        </linkableBuildings>
        <maxSimultaneous>2</maxSimultaneous>
      </li>

      <li Class="YASTM.Source.Comps.CompProperties_BridgeStation">
          <role>Science</role>
          <mannable>true</mannable>
      </li>

    <li Class="StarTrekFactions.Comps.CompProperties_ScienceConsoleSubspaceScan">
      <requiredResearch>ST_SubspaceTelemetry</requiredResearch>
      <questSignalOnScanStarted>STQ.Obelisks.ScanStarted</questSignalOnScanStarted>
      <questSignalOnScanCompleted>STQ.Obelisks.DataTransmitted</questSignalOnScanCompleted>
    </li>

    <li>
       <compClass>YASTM.CompUsageRestriction</compClass>
    </li>

    </comps>

    <placeWorkers>
      <li>RimWorld.PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
    <soundInteract>ST_SFX_LCARS_Click</soundInteract>

    <costList>
      <Steel>80</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>

    <designationCategory>ST_Designation</designationCategory>

    <modExtensions>
      <li Class="YASTM.DefModExt_LinkTags">
        <tags>
          <li>ST_Link_Science</li>
        </tags>
      </li>
    <li Class="YASTM.UsageRestrictionExtension">
      <requiredTrainingTrait>ST_Training_Science</requiredTrainingTrait>
      <failMessage>Access denied. Science certification required.</failMessage>
    </li>
    </modExtensions>

    <researchPrerequisites>
      <li>ST_SubspaceTelemetry</li>
    </researchPrerequisites>
    <uiOrder>2006</uiOrder>
  </ThingDef>

</Defs>
