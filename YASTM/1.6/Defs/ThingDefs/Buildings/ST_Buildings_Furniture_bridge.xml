<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>ST_Building_CaptainsChair</defName>
    <label>Captain's Chair</label>
    <description>The center seat. Assign a high-ranking officer to 'Bridge' work to man this station.</description>
    <graphicData>
      <texPath>Things/Building/Interiors/ST_CptChair</texPath> 
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.2,1.2)</drawSize>
      <damageData>
        <rect>(0.1,0.1,0.8,0.8)</rect>
      </damageData>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <modExtensions>
      <li Class="YASTM.ST_SitOffsetExtension">
        <offsetNorth>(0, 0, 0.05)</offsetNorth>
        <offsetSouth>(0, 0, -0.1)</offsetSouth>
        <offsetEast>(0.02, 0, -0.08)</offsetEast>
        <offsetWest>(-0.02, 0, 0.08)</offsetWest>
        <northLayerAdjust>-0.6</northLayerAdjust>
      </li>
    </modExtensions>
    <uiIconScale>0.8</uiIconScale>
    <uiIconPath>Things/Building/Interiors/ST_CptChair_south</uiIconPath>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>true</rotatable>
    <passability>Standable</passability>
    <pathCost>30</pathCost>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.4</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Flammability>0.3</Flammability>
      <Mass>20</Mass>
    </statBases>
    <size>(1,1)</size>
    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
      <Gold>5</Gold>
    </costList>
    <designationCategory>ST_Designation</designationCategory>
    <designatorDropdown>ST_Consoles_Group</designatorDropdown>
    
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,0)</interactionCellOffset>
    
    <building>
    	<isSittable>true</isSittable>
      <bed_showSleeperBody>false</bed_showSleeperBody>
      <paintable>true</paintable>
      <buildingSizeCategory>Small</buildingSizeCategory>
    </building>

    <comps>
      <li Class="YASTM.CompProperties_BridgeStation">
          <role>Command</role>
          <requiredTraitDef>ST_Trait_Command</requiredTraitDef>
      </li>
        <li Class="CompProperties_Power">
            <compClass>CompPowerTrader</compClass>
            <basePowerConsumption>50</basePowerConsumption>
        </li>
        <li Class="YASTM.Source.Comps.CompProperties_GraphicOverlay">
         <altitude>MoteOverhead</altitude> <graphicData>
           <texPath>Things/Building/Interiors/ST_CptChair_overlay</texPath>
           <graphicClass>Graphic_Multi</graphicClass>
           <drawSize>(1.2,1.2)</drawSize>
         </graphicData>
       </li>
    </comps>
  </ThingDef>

 <ThingDef ParentName="BuildingBase">
    <defName>ST_Building_StationChair</defName>
    <label>bridge station chair</label>
    <description>A comfortable and elegant chair. For home and Starfleet Ship interiors</description>
    <graphicData>
      <texPath>Things/Building/Interiors/ST_StationChair</texPath> 
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1.2,1.2)</drawSize>
      <damageData>
        <rect>(0.1,0.1,0.8,0.8)</rect>
      </damageData>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <modExtensions>
      <li Class="YASTM.ST_SitOffsetExtension">
        <offsetNorth>(0, 0, 0.05)</offsetNorth>
        <offsetSouth>(0, 0, -0.1)</offsetSouth>
        <offsetEast>(0.02, 0, -0.08)</offsetEast>
        <offsetWest>(-0.02, 0, 0.08)</offsetWest>
        <northLayerAdjust>-0.6</northLayerAdjust>
      </li>
    </modExtensions>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<uiIconScale>1</uiIconScale>
		<statBases>
			<MaxHitPoints>150</MaxHitPoints>
			<WorkToBuild>10000</WorkToBuild>
			<Mass>15</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>6</Beauty>
			<Comfort>0.80</Comfort>
		</statBases>
		<socialPropernessMatters>true</socialPropernessMatters>
		<stuffCategories>
      <li>Fabric</li>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>350</costStuffCount>
		<pathCost>30</pathCost>
		<fillPercent>0.35</fillPercent>
		<defaultPlacingRot>South</defaultPlacingRot>
		<building>
			<isSittable>true</isSittable>
			<paintable>true</paintable>
      <destroySound>BuildingDestroyed_Soft_Small</destroySound>
		</building>
     <uiOrder>1001</uiOrder>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<researchPrerequisites>
			<li>ST_Standard_Interior</li>
		</researchPrerequisites>
		<designationCategory>ST_Designation</designationCategory>
    <designatorDropdown>ST_Furiture_Group</designatorDropdown>
    <comps>
      <li Class="CompProperties_Styleable" />
    </comps>
	</ThingDef>

</Defs>