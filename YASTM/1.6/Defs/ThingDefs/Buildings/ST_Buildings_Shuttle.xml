<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>ST_Shuttle_LandingPad</defName>
    <label>shuttle bay</label>
    <description>A reinforced landing pad. Use the console to call a shuttle.</description>
    <thingClass>Building</thingClass> 
    <drawerType>MapMeshAndRealTime</drawerType>

    <graphicData>
      <texPath>Things/Building/Shuttle/Shuttle_Pad</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(8,8)</drawSize>
    </graphicData>

    <size>(6,6)</size>
    <altitudeLayer>FloorEmplacement</altitudeLayer>

    <building>
      <isEdifice>false</isEdifice> 
      <sowTag>SupportPlantsOnly</sowTag>
    </building>

    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <clearBuildingArea>true</clearBuildingArea>
    <fillPercent>0.0</fillPercent>
    <uiOrder>2500</uiOrder> 
    
    <statBases>
      <MaxHitPoints>5000</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>  
    
    <costList>
      <Steel>300</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    
    <comps>
      <li Class="YASTM.CompProperties_ShuttleBay">
        <shuttleDef>ST_ShuttleCraft_TypeVI</shuttleDef>
        <iconPath>UI/Icons/Gizmos/CallAid</iconPath>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_NotUnderRoof</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>ST_Shuttle_Craft</li>
    </researchPrerequisites>
    <designationCategory>ST_Designation</designationCategory>
    <designatorDropdown>ST_ShipandVehicle_Group</designatorDropdown>
  </ThingDef>

<ThingDef ParentName="BuildingBase">
    <defName>ST_Shuttle_Taxi</defName>
    <label>federation runabout (rental)</label>
    <description>A borrowed shuttlecraft. It will drop you off and return to the Federation HQ automatically.</description>
    <thingClass>Building</thingClass> 
    <uiIconPath>Things/Building/Shuttle/ShuttleType6_Side</uiIconPath>
    <drawerType>MapMeshAndRealTime</drawerType>   
    <graphicData>
      <texPath>Things/Building/Shuttle/ShuttleType6_Top</texPath> 
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(6,6)</drawSize>
      <drawOffset>(0, 0, 0)</drawOffset> 
      <color>(200, 200, 255)</color> </graphicData>
    <size>(4,5)</size>
    <rotatable>true</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>   
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Transporter">
        <massCapacity>1000</massCapacity>
        <max1PerGroup>true</max1PerGroup>
      </li>
      <li Class="YASTM.CompProperties_ShuttleLauncher">
        <maxDistance>120</maxDistance> <skyfallerLeaving>ST_Shuttle_Leaving</skyfallerLeaving>
      </li>
    <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>2.0</fuelConsumptionRate> <fuelCapacity>50.0</fuelCapacity> <fuelFilter>
          <thingDefs>
            <li>ST_Dilithium_Refined</li>
          </thingDefs>
        </fuelFilter>
        <drawOutOfFuelOverlay>true</drawOutOfFuelOverlay>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showFuelGizmo>true</showFuelGizmo>
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <canEjectFuel>true</canEjectFuel>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>ST_ShuttleCraft_TypeVI</defName>
    <label>Type-6 Shuttlecraft</label>
    <description>A short-range auxiliary vehicle.</description>
    <thingClass>Building</thingClass> 
    <uiIconPath>Things/Building/Shuttle/ShuttleType6_Side</uiIconPath>
    <uiIconScale>0.9</uiIconScale>
    <drawerType>MapMeshAndRealTime</drawerType>
    
    <minifiedDef>MinifiedThing</minifiedDef> 
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>

    <graphicData>
      <texPath>Things/Building/Shuttle/ShuttleType6_Top</texPath> 
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(6,6)</drawSize>
      <shadowData>
       <volume>(3, 1, 3)</volume>
      </shadowData>
      <drawOffset>(0, 0, 0)</drawOffset> 
    </graphicData>

    <size>(4,5)</size>
    <rotatable>true</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <clearBuildingArea>false</clearBuildingArea>
    <passability>PassThroughOnly</passability>
    <blockWind>true</blockWind>
    
    <statBases>
      <MaxHitPoints>1000</MaxHitPoints>
      <WorkToBuild>40000</WorkToBuild> 
      <Flammability>0</Flammability>
      <Mass>2000</Mass>
    </statBases>
    
    <costList>
      <Steel>200</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
      <Plasteel>200</Plasteel>
      <Uranium>50</Uranium>
      <ComponentSpacer>8</ComponentSpacer>
      <ST_DilithiumCrystal>5</ST_DilithiumCrystal>
    </costList>

    <building>
      <claimable>true</claimable>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <paintable>true</paintable>
      <isInert>true</isInert>
    </building>
    
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0, 0, -3)</interactionCellOffset>
    <selectable>true</selectable>
    <inspectorTabs>
      <li>ITab_ContentsTransporter</li>
    </inspectorTabs>

    <comps>
      <li Class="CompProperties_Transporter">
        <massCapacity>1000</massCapacity>
        <max1PerGroup>true</max1PerGroup>
        <canChangeAssignedThingsAfterStarting>true</canChangeAssignedThingsAfterStarting>
        <showOverallStats>true</showOverallStats>
      </li>

      <li Class="YASTM.CompProperties_ShuttleLauncher">
        <maxDistance>70</maxDistance>
        <skyfallerLeaving>ST_Shuttle_Leaving</skyfallerLeaving>
      </li>

      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>2.0</fuelConsumptionRate> <fuelCapacity>50.0</fuelCapacity> <fuelFilter>
          <thingDefs>
            <li>ST_Dilithium_Refined</li>
          </thingDefs>
        </fuelFilter>
        <drawOutOfFuelOverlay>true</drawOutOfFuelOverlay>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <showFuelGizmo>true</showFuelGizmo>
        <initialFuelPercent>1</initialFuelPercent>
        <autoRefuelPercent>0.5</autoRefuelPercent>
        <canEjectFuel>true</canEjectFuel>
      </li>

      <li Class="CompProperties_AmbientSound">
        <sound>ShuttleIdle_Ambience</sound>
      </li>
    </comps>
    
    <placeWorkers>
        <li>YASTM.PlaceWorker_OnShuttleBay</li>
    </placeWorkers>
    <researchPrerequisites>
      <li>ST_Shuttle_Craft</li>
    </researchPrerequisites>
  </ThingDef>

  <ThingDef ParentName="SkyfallerBase">
    <defName>ST_Shuttle_Leaving</defName>
    <label>shuttle taking off</label>
    <graphicData>
      <texPath>Things/Building/Shuttle/ShuttleType6_Top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(6,6)</drawSize>
    </graphicData>
    <skyfaller>
      <movementType>Decelerate</movementType>
      <reversed>true</reversed> 
      <shadow>Things/Skyfaller/SkyfallerShadowDropPod</shadow>
      <shadowSize>(3, 3)</shadowSize>
      <anticipationSound>DropPod_Leaving</anticipationSound> 
      <anticipationSoundTicks>-10</anticipationSoundTicks>
      <ticksToImpactRange><min>-40</min><max>-15</max></ticksToImpactRange>
      <rotateGraphicTowardsDirection>false</rotateGraphicTowardsDirection>
      <motesPerCell>0</motesPerCell>
    </skyfaller>
  </ThingDef>

</Defs>