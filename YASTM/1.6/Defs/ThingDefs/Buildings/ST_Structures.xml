<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Starship Hull Wall -->
<ThingDef ParentName="BuildingBase">
  <defName>ST_HullWall</defName>
  <label>hull wall</label>
  <thingClass>Building</thingClass>
  <category>Building</category>
  <description>Starship-grade hull section. Extremely durable and airtight.</description>
    <replaceTags>
      <li>Wall</li>
    </replaceTags>
  <graphicData>
    <texPath>Things/Building/Ship/WallShip</texPath>
    <graphicClass>Graphic_Single</graphicClass>
    <linkType>CornerFiller</linkType>
    <linkFlags>
    <li>Wall</li>
    <li>Rock</li>
    </linkFlags>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
        <edgeTop>Damage/Edge</edgeTop>
        <edgeBot>Damage/Edge</edgeBot>
        <edgeLeft>Damage/Edge</edgeLeft>
        <edgeRight>Damage/Edge</edgeRight>
      </damageData>
       <color>(0.8, 0.8, 1, 1)</color> 
   </graphicData>
  <uiIconPath>Things/Building/Ship/HullWall_MenuIcon</uiIconPath>
  <statBases>
    <MaxHitPoints>900</MaxHitPoints>
    <WorkToBuild>900</WorkToBuild>
    <Flammability>0</Flammability>
    <MeditationFocusStrength>0.22</MeditationFocusStrength>
  </statBases>
  <costStuffCount>10</costStuffCount>
   <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <blockWind>true</blockWind>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>1</fillPercent>
    <coversFloor>true</coversFloor>
    <drawStyleCategory>Walls</drawStyleCategory>
    <tickerType>Never</tickerType>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <useStuffTerrainAffordance>true</useStuffTerrainAffordance>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded> <!-- Best affordance needed for stone -->
    <holdsRoof>true</holdsRoof>
    <designationCategory>Structure</designationCategory>
    <uiOrder>2000</uiOrder>
    <staticSunShadowHeight>1.0</staticSunShadowHeight>
    <blockLight>true</blockLight>
    <canOverlapZones>false</canOverlapZones>
    <fertility>0</fertility>
    <stuffCategories>
      <li>Metallic</li>
  </stuffCategories>
   <building>
      <paintable>true</paintable>
      <isInert>true</isInert>
      <isWall>true</isWall>
      <isPlaceOverableWall>true</isPlaceOverableWall>
      <ai_chillDestination>false</ai_chillDestination>
      <supportsWallAttachments>true</supportsWallAttachments>
      <isStuffableAirtight>true</isStuffableAirtight>
      <relatedBuildCommands>
        <li>Door</li>
        <li>Autodoor</li>
        <li MayRequire="Ludeon.RimWorld.Anomaly">SecurityDoor</li>
        <li MayRequire="Ludeon.RimWorld.Odyssey">VacBarrier</li>
        <li>Cooler</li>
        <li>Vent</li>
      </relatedBuildCommands>
    </building>
    <comps>
      <li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef>
        <focusTypes>
          <li>Minimal</li>
        </focusTypes>
      </li>
    </comps>
  <researchPrerequisites><li>ST_Common_Engineering</li></researchPrerequisites>
    <damageMultipliers>
      <li>
        <damageDef>Bomb</damageDef>
        <multiplier>0.02</multiplier>
      </li>
      <li>
        <damageDef>Thump</damageDef>
        <multiplier>0.02</multiplier>
      </li>
    </damageMultipliers>
  <costList>
    <Steel>40</Steel>
    <Plasteel>10</Plasteel>
  </costList>
</ThingDef>

  <!-- Starship Hull Window  -->
      
 <ThingDef ParentName="LampBase">
    <defName>ST_HullWindows</defName>
    <label>hull viewport</label>
    <description>Transparent duraglass panel rated for hull pressure.</description>
    <rotatable>true</rotatable> 
    <graphicData> 
      <texPath>Things/Building/Ship/STHull_Window</texPath>
      <graphicClass>Graphic_Multi</graphicClass> 
	  <shaderType>CutoutComplex</shaderType> 
      <drawOffsetNorth>(0,0,1)</drawOffsetNorth> 
      <drawOffsetSouth>(0,0,-1)</drawOffsetSouth> 
      <drawOffsetWest>(-1,0,0)</drawOffsetWest>
      <drawOffsetEast>(1,0,0)</drawOffsetEast> 
	  <drawSize>(1.1,1.1)</drawSize> 
      <damageData> 
        <enabled>false</enabled>
      </damageData>
    <linkFlags>
      <li>Wall</li>
       <li>Rock</li>
    </linkFlags>
    </graphicData>
    <fillPercent>1</fillPercent>
    <uiIconPath>Things/Building/Ship/STHull_Window</uiIconPath> 
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <costList> 
      <Steel>15</Steel>
    </costList>
    <statBases>
      <WorkToBuild>330</WorkToBuild> 
      <MaxHitPoints>35</MaxHitPoints> 
      <Mass>2</Mass> 
	  <Beauty>5</Beauty> 
	  <Flammability>0.5</Flammability>
    </statBases>
	<constructionSkillPrerequisite>3</constructionSkillPrerequisite> 
    <uiOrder>2061</uiOrder> 
    <passability>Standable</passability> 
    <terrainAffordanceNeeded IsNull="True" />
    <pathCost>0</pathCost> 
    <overrideMinifiedRot>North</overrideMinifiedRot> 
    <minifiedDrawOffset>(0, 0, 0.2)</minifiedDrawOffset> 
          <passability>Impassable</passability>
    <building> 
      <isEdifice>true</isEdifice> 
      <isAttachment>true</isAttachment> 
	    <paintable>true</paintable> 
      <supportsWallAttachments>true</supportsWallAttachments> 
      <isStuffableAirtight>true</isStuffableAirtight>
    </building>
    <placeWorkers> 
      <li>Placeworker_AttachedToWall</li> 
    </placeWorkers>
    <comps> 
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius> 
        <glowColor>(255,237,221,0)</glowColor>  <!-- Soft warm light -->
        <overlightRadius>0</overlightRadius>
        <colorPickerEnabled>true</colorPickerEnabled> 
        <darklightToggle>true</darklightToggle> 
      </li>
    </comps>
	<designationCategory>Structure</designationCategory> 
	<researchPrerequisites> 
      <li>ST_Common_Engineering</li>
    </researchPrerequisites>
  </ThingDef>

<ThingDef ParentName="DoorBase">
    <defName>ST_HullDoor</defName>
    <label>armored hull door</label>
    <description>Divides rooms. Armored doors must be manually opened, which slows people down. Armored doors are nearly entirely blast resistant and barely take damage from breaching methods.</description>
    <category>Building</category>
    <thingClass>Building_MultiTileDoor</thingClass>
    <statBases>
        <WorkToBuild>1685</WorkToBuild>
        <MaxHitPoints>450</MaxHitPoints>
        <DoorOpenSpeed>0.75</DoorOpenSpeed>
    </statBases>
    <graphicData>
      <texPath>Things/Building/Ship/ST_HullDoor_Mover</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      	  <shaderType>CutoutComplex</shaderType>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Ship/ST_HullDoor</uiIconPath>
    <costList>
      <Plasteel>20</Plasteel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <building>
      <blueprintGraphicData>
        <texPath>Things/Building/Ship/ST_HullDoor_Blueprint</texPath>
        <drawSize>(2,2)</drawSize>
      </blueprintGraphicData>
      <paintable>true</paintable>
      <isSupportDoor>true</isSupportDoor>
      <isAirtight>true</isAirtight>
      <doorTopGraphic>
        <texPath>Things/Building/Ship/ST_HullDoor_Top</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(2.4,2)</drawSize>
        <color>(105,105,105)</color>
      </doorTopGraphic>
      <doorSupportGraphic>
        <texPath>Things/Building/Ship/ST_HullDoor_Support</texPath>
        <graphicClass>Graphic_Multi</graphicClass>
        <drawSize>(2,2.4)</drawSize>
        <color>(105,105,105)</color>
      </doorSupportGraphic>
      <soundDoorOpenPowered>ST_Door_Sound</soundDoorOpenPowered>
      <soundDoorClosePowered>ST_Door_Sound</soundDoorClosePowered>
      <soundDoorOpenManual>ST_Door_Sound</soundDoorOpenManual>
      <soundDoorCloseManual>ST_Door_Sound</soundDoorCloseManual>
    </building>
    <placeWorkers>
      <li>PlaceWorker_MultiCellDoor</li>
    </placeWorkers>
    <stuffCategories Inherit="False">
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>50</costStuffCount>
    <damageMultipliers>
      <li>
        <damageDef>Bomb</damageDef>
        <multiplier>0.05</multiplier>
      </li>
      <li>
        <damageDef>Thump</damageDef>
        <multiplier>0.05</multiplier>
      </li>
    </damageMultipliers>
    <researchPrerequisites>
      <li>ST_Common_Engineering</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>
