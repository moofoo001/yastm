<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>ST_Building_FerengiMarket</defName>
    <label>Ferengi market link</label>
    <description>A subspace terminal connected directly to the Ferengi Futures Exchange on Ferenginar. Allows instant trading of goods for Gold-Pressed Latinum.\n\nWARNING: The House always wins... slightly. Requires significant power to maintain the subspace tunnel.</description>
    <graphicData>
      <texPath>Things/Building/Misc/MarketConsole</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
    </graphicData>
    <uiIconScale>0.8</uiIconScale>
    <size>(2,2)</size>
    <rotatable>true</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.5</fillPercent>
    <designationCategory>ST_Designation</designationCategory>
    <designatorDropdown>ST_Consoles_Group</designatorDropdown>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Flammability>1.0</Flammability>
    </statBases>
    <costList>
      <Steel>150</Steel>
      <Gold>20</Gold> <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>500</basePowerConsumption> </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="YASTM.CompProperties_FerengiMarket">
        <marketTraderKind>ST_TraderKind_FerengiGlobal</marketTraderKind>
      </li>
    </comps>
    <researchPrerequisites>
      <li>Ferengi_Commerce</li>
    </researchPrerequisites>
  </ThingDef>

 <TraderKindDef>
    <defName>ST_TraderKind_FerengiGlobal</defName>
    <label>Ferengi Futures Exchange</label>
    <orbital>true</orbital> <stockGenerators>
      
      <li Class="StockGenerator_SingleDef">
        <thingDef>ST_Latinum</thingDef>
        <countRange>500~2000</countRange>
      </li>

      <li Class="StockGenerator_Category">
        <categoryDef>ResourcesRaw</categoryDef>
    </li>
      <li Class="StockGenerator_Category">
        <categoryDef>Textiles</categoryDef>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>FoodMeals</categoryDef>
      </li>
      
      <li Class="StockGenerator_BuyTradeTag"><tag>Weapon</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Apparel</tag></li>
      
      <li Class="StockGenerator_BuySlaves" />

      <li Class="StockGenerator_Tag">
        <tradeTag>ExoticMisc</tradeTag>
        <thingDefCountRange>1~3</thingDefCountRange>
        <countRange>1~2</countRange>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>Techprint</tradeTag>
        <thingDefCountRange>0~1</thingDefCountRange>
        <countRange>1</countRange>
      </li>
      
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentSpacer</thingDef>
        <countRange>2~8</countRange>
      </li>

    </stockGenerators>
  </TraderKindDef>

</Defs>