<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>ST_HoloEmitter</defName>
    <label>holographic emitter</label>
    <description>A projector capable of creating immersive photonic simulations. Can be configured for relaxation (Risa) or running specialized training programs via isolinear chips.\n\nWarning: Combat simulations consume high power.</description>
    
    <thingClass>Building_WorkTable</thingClass>
    
    <graphicData>
      <texPath>Things/Building/Misc/HoloEmitter</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
      <shadowData>
        <volume>(0.5, 0.5, 0.5)</volume>
      </shadowData>
    </graphicData>
    <size>(2,2)</size>
    <uiIconScale>0.8</uiIconScale>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <rotatable>false</rotatable>
    <fillPercent>0.2</fillPercent>
    
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <clearBuildingArea>true</clearBuildingArea>
    <canOverlapZones>false</canOverlapZones>
    <selectable>true</selectable>
    <blockWind>true</blockWind>

    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>2500</WorkToBuild>
      <Mass>20</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>10</Beauty>
      <Comfort>1</Comfort>
      <JoyGainFactor>1.5</JoyGainFactor>
      <WorkTableWorkSpeedFactor>1.0</WorkTableWorkSpeedFactor>
    </statBases>

    <tickerType>Normal</tickerType> 

    <costList>
      <Steel>100</Steel>
      <ComponentSpacer>4</ComponentSpacer>
      <Gold>20</Gold>
    </costList>

    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>

    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>500</basePowerConsumption> 
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>

      <li Class="YASTM.CompProperties_Holodeck">
        <trainingXpPerTick>0.15</trainingXpPerTick>
        <powerTrainingMode>2000</powerTrainingMode>
        <powerRelaxMode>500</powerRelaxMode>
        <holoRefreshInterval>240</holoRefreshInterval>
      </li>
      
      <li Class="CompProperties_Glower">
        <glowRadius>2</glowRadius>
        <glowColor>(137,207,240,50)</glowColor>
      </li> 
    </comps>

    <building>
      <joyKind>Gaming_Cerebral</joyKind>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    
    <researchPrerequisites>
      <li>ST_Emitter_Tech</li>
      <li>ST_RecreationalInterfaces</li> 
    </researchPrerequisites>
    
    <designationCategory>ST_Designation</designationCategory>
    <designatorDropdown>ST_PowerandProduction_Group</designatorDropdown>
    
  </ThingDef>

</Defs>