<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Shared base: Klingon Tunic -->
  <ThingDef Name="ST_Apparel_KlingonTunic_shared" ParentName="ApparelMakeableBase" Abstract="True">
    <label>Klingon tunic</label>
    <description>Warrior duty garb: rugged weaves, reinforced seams.</description>

    <graphicData>
      <texPath>Things/Item/Apparel/Klingon_Tunic/KlingonTunic</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <uiIconScale>2</uiIconScale>
    <uiIconPath>Things/Item/Apparel/Klingon_Tunic/KlingonTunic</uiIconPath>
    <statBases>
      <WorkToMake>2400</WorkToMake>
      <Mass>0.7</Mass>
      <MarketValue>130</MarketValue>
      <ArmorRating_Sharp>0.24</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.06</ArmorRating_Blunt>
      <ArmorRating_Heat>0.08</ArmorRating_Heat>
      <Insulation_Cold>3</Insulation_Cold>
      <Insulation_Heat>2</Insulation_Heat>
    </statBases>
    <thingCategories><li>Apparel</li></thingCategories>
    <apparel>
      <wornGraphicPath>Things/Item/Apparel/Klingon_Tunic/KlingonTunic</wornGraphicPath>
      <bodyPartGroups><li>Torso</li><li>Arms</li></bodyPartGroups>
      <layers><li>OnSkin</li></layers>
      <tags><li>KlingonUniform</li></tags>
    </apparel>
    <costList>
      <Cloth>80</Cloth>
      <Steel>25</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <equippedStatOffsets>
      <SocialImpact>-0.02</SocialImpact>
    </equippedStatOffsets>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable"/>
      <li><compClass>CompQuality</compClass></li>
    </comps>
  </ThingDef>

  <!-- Craftable Klingon Tunic -->
  <ThingDef ParentName="ST_Apparel_KlingonTunic_shared">
    <defName>ST_Apparel_KlingonTunic</defName>
    <label>Klingon tunic</label>
    <stuffCategories><li>Fabric</li></stuffCategories>
    <costStuffCount>45</costStuffCount>
    <recipeMaker>
      <workAmount>5200</workAmount>
      <workSkill>Crafting</workSkill>
      <effectWorking>Tailor</effectWorking>
      <soundWorking>Recipe_Tailor</soundWorking>
      <skillRequirements><Crafting>4</Crafting></skillRequirements>
      <recipeUsers>
        <li>ElectricTailoringBench</li>
        <li>HandTailoringBench</li>
      </recipeUsers>
      <researchPrerequisites>
        <li>Klingon_Standard</li>
      </researchPrerequisites>
    </recipeMaker>
    <generateCommonality>0</generateCommonality>
    <tradeability>None</tradeability>
    <alwaysHaulable>true</alwaysHaulable>
  </ThingDef>

  <!-- Klingon Armored Vest -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>ST_Apparel_KlingonArmoredVest</defName>
    <label>Klingon armored vest</label>
    <description>Layered plates for brutal melee and shrapnel defense.</description>
    <graphicData>
      <texPath>Things/Item/Apparel/Klingon_Vest/Klingon_Vest</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <uiIconScale>2</uiIconScale>
    <uiIconPath>Things/Item/Apparel/Klingon_Vest/Klingon_Vest</uiIconPath>
    <thingCategories><li>Apparel</li></thingCategories>
    <statBases>
      <WorkToMake>4800</WorkToMake>
      <Mass>3.0</Mass>
      <MarketValue>260</MarketValue>
      <ArmorRating_Sharp>0.24</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.14</ArmorRating_Blunt>
      <ArmorRating_Heat>0.18</ArmorRating_Heat>
      <Insulation_Cold>0.5</Insulation_Cold>
      <Insulation_Heat>0.5</Insulation_Heat>
    </statBases>
    <apparel>
      <wornGraphicPath>Things/Item/Apparel/Klingon_Vest/Klingon_Vest</wornGraphicPath>
      <bodyPartGroups><li>Torso</li><li>Shoulders</li></bodyPartGroups>
      <layers><li>Middle</li></layers>
      <tags><li>KlingonUniform</li></tags>
      <defaultOutfitTags><li>Soldier</li></defaultOutfitTags>
    </apparel>
    <equippedStatOffsets>
      <MoveSpeed>-0.05</MoveSpeed>
    </equippedStatOffsets>
    <costList>
      <Plasteel>30</Plasteel>
      <Steel>20</Steel>
      <ComponentIndustrial>10</ComponentIndustrial>
    </costList>
    <stuffCategories/>
    <tradeTags>
     <li>ClothingArmor</li>
     <li>ST_KlingonArms</li>
    </tradeTags>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <efficiencyStat>GeneralLaborSpeed</efficiencyStat>
      <skillRequirements><Crafting>6</Crafting></skillRequirements>
      <researchPrerequisites>
        <li>Klingon_Standard</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>

  <!-- Klingon Honor Armor -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>ST_Apparel_KlingonHonorArmor</defName>
    <label>Klingon honor armor</label>
    <description>A heavy, meticulously crafted suit of battle armor forged in the fires of Qo'noS. Designed specifically for close-quarters combat, it integrates micro-servos to assist with the sweeping strikes of a bat'leth. It offers incredible protection without sacrificing the warrior's mobility.</description>
    <graphicData>
      <texPath>Things/Item/Apparel/Klingon_Vest/Klingon_HonorArmor</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>1.1</drawSize>
    </graphicData>
    
    <statBases>
      <WorkToMake>35000</WorkToMake>
      <Mass>12.5</Mass>
      <MarketValue>1800</MarketValue>
      <ArmorRating_Sharp>1.10</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.55</ArmorRating_Blunt>
      <ArmorRating_Heat>0.60</ArmorRating_Heat>
      <Insulation_Cold>25</Insulation_Cold>
      <Insulation_Heat>15</Insulation_Heat>
      <EquipDelay>10</EquipDelay>
    </statBases>

    <equippedStatOffsets>
      <MoveSpeed>0.4</MoveSpeed>
      <MeleeDodgeChance>0.15</MeleeDodgeChance>
      <MeleeHitChance>0.10</MeleeHitChance>
    </equippedStatOffsets>

    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Item/Apparel/KlingonHonorArmor/KlingonHonorArmor</wornGraphicPath>
      <layers>
        <li>Middle</li>
        <li>Shell</li> </layers>
      <tags>
        <li>SpacerMilitary</li>
        <li>KlingonArmor</li> </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <developmentalStageFilter>Adult</developmentalStageFilter>
    </apparel>
    
    <recipeMaker>
      <researchPrerequisite>PoweredArmor</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
    </recipeMaker>
    
    <costList>
      <Plasteel>100</Plasteel>
      <Steel>40</Steel>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(60, 60, 60)</only> </li>
        <li>
          <weight>5</weight>
          <only>(80, 50, 50)</only> </li>
        <li>
          <weight>5</weight>
          <only>(40, 40, 40)</only> </li>
      </options>
    </colorGenerator>
  </ThingDef>

</Defs>
