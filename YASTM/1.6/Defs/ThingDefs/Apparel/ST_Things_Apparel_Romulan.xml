<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Shared base: Romulan Tunic -->
  <ThingDef Name="ST_Apparel_RomulanTunic_shared" ParentName="ApparelMakeableBase" Abstract="True">
    <label>Romulan tunic</label>
    <description>Structured tessellated fabric; discreet tactical baffling.</description>
    <graphicData>
      <texPath>Things/Item/Apparel/Romulan_Tunic/RomulanTunic</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <uiIconScale>2</uiIconScale>
    <uiIconPath>Things/Item/Apparel/Romulan_Tunic/RomulanTunic</uiIconPath>
    <statBases>
      <WorkToMake>2300</WorkToMake>
      <Mass>0.6</Mass>
      <MarketValue>130</MarketValue>
      <ArmorRating_Sharp>0.18</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.04</ArmorRating_Blunt>
      <ArmorRating_Heat>0.14</ArmorRating_Heat>
      <Insulation_Cold>4</Insulation_Cold>
      <Insulation_Heat>5</Insulation_Heat>
    </statBases>
    <thingCategories><li>Apparel</li></thingCategories>
    <apparel>
      <wornGraphicPath>Things/Item/Apparel/Romulan_Tunic/RomulanTunic</wornGraphicPath>
      <bodyPartGroups><li>Torso</li><li>Arms</li></bodyPartGroups>
      <layers><li>OnSkin</li></layers>
      <tags><li>RomulanUniform</li></tags>
    </apparel>
    <costList>
      <Cloth>80</Cloth>
      <Steel>15</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <equippedStatOffsets>
      <SocialImpact>-0.01</SocialImpact>
    </equippedStatOffsets>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable"/>
      <li><compClass>CompQuality</compClass></li>
    </comps>
  </ThingDef>

  <!-- Craftable Romulan Tunic -->
  <ThingDef ParentName="ST_Apparel_RomulanTunic_shared">
    <defName>ST_Apparel_RomulanTunic</defName>
    <label>Romulan tunic</label>
    <stuffCategories><li>Fabric</li></stuffCategories>
    <costStuffCount>45</costStuffCount>
    <recipeMaker>
      <workAmount>5000</workAmount>
      <workSkill>Crafting</workSkill>
      <effectWorking>Tailor</effectWorking>
      <soundWorking>Recipe_Tailor</soundWorking>
      <skillRequirements><Crafting>4</Crafting></skillRequirements>
      <recipeUsers>
        <li>ElectricTailoringBench</li>
        <li>HandTailoringBench</li>
      </recipeUsers>
      <researchPrerequisites>
        <li>Romulan_Standard</li>
      </researchPrerequisites>
    </recipeMaker>
    <generateCommonality>0</generateCommonality>
    <tradeability>None</tradeability>
    <alwaysHaulable>true</alwaysHaulable>
  </ThingDef>

  <!-- Romulan Armored Vest -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>ST_Apparel_RomulanArmoredVest</defName>
    <label>Romulan armored vest</label>
    <description>Energy-baffled layers optimized against directed heat weapons.</description>
    <graphicData>
      <texPath>Things/Item/Apparel/Romulan_Vest/Romulan_Vest</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <uiIconScale>2</uiIconScale>
    <uiIconPath>Things/Item/Apparel/Romulan_Vest/Romulan_Vest</uiIconPath>
    <thingCategories><li>Apparel</li></thingCategories>
    <statBases>
      <WorkToMake>4600</WorkToMake>
      <Mass>2.3</Mass>
      <MarketValue>280</MarketValue>
      <ArmorRating_Sharp>0.20</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
      <ArmorRating_Heat>0.28</ArmorRating_Heat>
      <Insulation_Cold>0.5</Insulation_Cold>
      <Insulation_Heat>0.7</Insulation_Heat>
    </statBases>
    <apparel>
      <wornGraphicPath>Things/Item/Apparel/Romulan_Vest/Romulan_Vest</wornGraphicPath>
      <bodyPartGroups><li>Torso</li><li>Shoulders</li></bodyPartGroups>
      <layers><li>Middle</li></layers>
      <tags><li>RomulanUniform</li></tags>
      <defaultOutfitTags><li>Soldier</li></defaultOutfitTags>
    </apparel>
    <equippedStatOffsets>
      <MoveSpeed>-0.02</MoveSpeed>
    </equippedStatOffsets>
    <costList>
      <Plasteel>20</Plasteel>
      <Cloth>30</Cloth>
      <ComponentIndustrial>12</ComponentIndustrial>
    </costList>
    <stuffCategories/>
    <tradeTags><li>ClothingArmor</li></tradeTags>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <efficiencyStat>GeneralLaborSpeed</efficiencyStat>
      <skillRequirements><Crafting>5</Crafting></skillRequirements>
      <researchPrerequisites>
        <li>Romulan_Standard</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="ApparelMakeableBase">
    <defName>ST_Apparel_TalShiarSuit</defName>
    <label>Tal Shiar covert ops suit</label>
    <description>An advanced, lightweight stealth suit issued only to elite operatives of the Romulan Tal Shiar. Woven from sensor-baffling metamaterials, it offers moderate kinetic protection but drastically enhances the wearer's agility, speed, and ability to subdue targets quietly.</description>
    <techLevel>Spacer</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <researchPrerequisite>Romulan_CloakingSystems</researchPrerequisite>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
    </recipeMaker>
    <graphicData>
      <texPath>Things/Item/Apparel/Romulan_Vest/TalShiarSuit</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <uiIconScale>1.5</uiIconScale>
    <uiIconPath>Things/Item/Apparel/Romulan_Vest/TalShiarSuit</uiIconPath>
    <statBases>
      <WorkToMake>35000</WorkToMake>
      <MaxHitPoints>250</MaxHitPoints>
      <Mass>3.5</Mass>
      <Flammability>0.2</Flammability>
      <ArmorRating_Sharp>0.65</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.45</ArmorRating_Blunt>
      <ArmorRating_Heat>0.50</ArmorRating_Heat>
      <Insulation_Cold>20</Insulation_Cold>
      <Insulation_Heat>20</Insulation_Heat>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <costList>
      <Synthread>60</Synthread>
      <Plasteel>40</Plasteel>
      <ComponentSpacer>2</ComponentSpacer>
    </costList>
    <equippedStatOffsets>
      <MoveSpeed>0.6</MoveSpeed>
      <MeleeDodgeChance>15.0</MeleeDodgeChance>
      <ArrestSuccessChance>0.25</ArrestSuccessChance>
      <ToxicResistance>0.50</ToxicResistance>
      <ShootingAccuracyPawn>1.5</ShootingAccuracyPawn>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Item/Apparel/Romulan_Vest/TalShiarSuit</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
        <li>Middle</li>
      </layers>
      <tags>
        <li>SpacerMilitary</li>
        <li>RomulanTalShiar</li> </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
  </ThingDef>

</Defs>
