    </graphicData>
    <statBases>
      <WorkToMake>3000</WorkToMake>
      <Mass>0.4</Mass>
      <MarketValue>200</MarketValue>
      <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
      <Insulation_Cold>10</Insulation_Cold>
      <Insulation_Heat>10</Insulation_Heat>
    </statBases>
    <apparel>
      <wornGraphicPath>Things/Item/Apparel/Dominion_Tunic/Vorta</wornGraphicPath>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Arms</li>
        <li>Legs</li>
        <li>Shoulders</li>
      </bodyPartGroups>
      <layers>
        <li>OnSkin</li>
        <li>Middle</li>
      </layers>
      <tags>
        <li>DominionCivil</li>
        <li>DominionVorta</li>
      </tags>
    </apparel>
    <costList>
      <Cloth>80</Cloth>
    </costList>
    <equippedStatOffsets>
      <SocialImpact>0.20</SocialImpact>
      <TradePriceImprovement>0.05</TradePriceImprovement>
    </equippedStatOffsets>
  </ThingDef>

</Defs>