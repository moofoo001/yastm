  </ThingDef>

<!-- ===== FEDERATION: Survival Knife (light, stabby) ===== -->
  <ThingDef ParentName="ST_MeleeBase">
    <defName>UFP_Weapon_SurvivalKnife</defName>
    <label>survival knife</label>
    <description>A versatile survival knife used by Federation explorers and officers. Designed for both utility and combat, it features a sharp blade ideal for close-quarters engagements.</description>  
    <graphicData>
      <texPath>Things/Item/Equipment/Federation_weapons/UFPS_SurvivalKnife</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.6</drawSize>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <weaponTags>
      <li>FederationMelee_SurvivalKnife</li>
      <li>FederationMelee</li>
    </weaponTags>
    <statBases>
      <Mass>0.6</Mass>
      <MarketValue>240</MarketValue>
    </statBases>
    <recipeMaker>
        <workAmount>7000</workAmount>
        <skillRequirements><Crafting>6</Crafting></skillRequirements>
        <recipeUsers><li>ElectricSmithy</li></recipeUsers>
        <researchPrerequisite>ST_Starfleet_Melee_I</researchPrerequisite>
    </recipeMaker>
    <costList>
      <Plasteel>2</Plasteel>
      <Steel>12</Steel>
      <Gold>10</Gold>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <tools>
      <li>
        <label>point</label>
        <capacities><li>Stab</li></capacities>
        <power>9</power>
        <cooldownTime>1.50</cooldownTime>
        <armorPenetration>0.20</armorPenetration>
        <chanceFactor>0.8</chanceFactor>
      </li>
      <li>
        <label>edge</label>
        <capacities><li>Cut</li></capacities>
        <power>5</power>
        <cooldownTime>1.50</cooldownTime>
        <armorPenetration>0.14</armorPenetration>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
    <tradeTags><li>ST_StarfleetSupply</li></tradeTags>
  </ThingDef>

  <!-- ===== FEDERATION: Stun Baton (blunt, control tool) ===== -->
  <ThingDef ParentName="ST_MeleeBase">
    <defName>UFP_Weapon_StunBaton</defName>
    <label>stun baton</label>
    <description>A non-lethal stun baton used by Federation security personnel to incapacitate targets through electric shocks. Ideal for crowd control and subduing hostile individuals without causing permanent harm.</description>  
    <graphicData>
      <texPath>Things/Item/Equipment/Federation_weapons/UFPS_StunBaton</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.7</drawSize>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <weaponTags>
      <li>FederationMelee_StunBaton</li>
      <li>FederationMelee</li>
    </weaponTags>
    <statBases>
      <Mass>1.6</Mass>
      <MarketValue>300</MarketValue>
    </statBases>
    <recipeMaker>
    <workAmount>7000</workAmount>
        <skillRequirements><Crafting>6</Crafting></skillRequirements>
        <recipeUsers><li>ElectricSmithy</li></recipeUsers>
        <researchPrerequisite>ST_Starfleet_Melee_II</researchPrerequisite>
    </recipeMaker>
    <costList>
      <Plasteel>3</Plasteel>
      <Steel>18</Steel>
      <Gold>15</Gold>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <tools>
      <li>
        <label>head</label>
        <capacities><li>Blunt</li></capacities>
        <power>11</power>
        <cooldownTime>1.55</cooldownTime>
        <armorPenetration>0.20</armorPenetration>
        <chanceFactor>0.8</chanceFactor>
      </li>
    </tools>
    <comps>
        <li Class="ST.PhaseWeapons.CompProperties_StunOnMelee">
            <stunTicks>300</stunTicks>         
            <stunOnlyFlesh>true</stunOnlyFlesh> 
            <chance>1.0</chance>               
        </li>
    </comps>
    <tradeTags><li>ST_StarfleetSupply</li></tradeTags>
  </ThingDef>

  <!-- ===== FEDERATION: Vulcan Lirpa (balanced, multi-tool) ===== -->
  <ThingDef ParentName="ST_MeleeBase">
    <defName>ST_VulcanLirpa</defName>
    <label>Lirpa</label>
    <description>A traditional Vulcan weapon consisting of a wooden staff with a semicircular blade at one end and a heavy bludgeon at the other. Historically used in the mating ritual known as Kal-if-fee. While ceremonial, in the hands of a Vulcan, it is a deadly instrument of precision and force.</description>
    
    <graphicData>
      <texPath>Things/Item/Equipment/Federation_weapons/VulcanLirpa</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.2</drawSize>
    </graphicData>

    <weaponTags>
      <li>FederationMelee</li>
      <li>VulcanMelee_Lirpa</li>
    </weaponTags>

    <statBases>
      <WorkToMake>18000</WorkToMake>
      <Mass>3.5</Mass>
      <MarketValue>650</MarketValue>
      <MeleeWeapon_DamageMultiplier>1.1</MeleeWeapon_DamageMultiplier>
      <MeleeWeapon_CooldownMultiplier>0.9</MeleeWeapon_CooldownMultiplier>
    </statBases>

    <equippedStatOffsets>
      <MeleeHitChance>2.0</MeleeHitChance>
      <MeleeDodgeChance>1.0</MeleeDodgeChance>
    </equippedStatOffsets>

    <costList>
      <Plasteel>60</Plasteel>
      <WoodLog>30</WoodLog> </costList>

    <recipeMaker>
      <researchPrerequisite>ST_Starfleet_Melee_II</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>ElectricSmithy</li>
      </recipeUsers>
    </recipeMaker>

    <tools>
      <li>
        <label>blade</label>
        <capacities>
          <li>Cut</li>
          <li>Scratch</li>
        </capacities>
        <power>24</power>
        <cooldownTime>2.0</cooldownTime>
        <armorPenetration>0.35</armorPenetration>
        <chanceFactor>1.2</chanceFactor> </li>
      <li>
        <label>counterweight</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>18</power>
        <cooldownTime>1.6</cooldownTime>
        <armorPenetration>0.15</armorPenetration>
        <chanceFactor>0.8</chanceFactor> <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>14</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>handle</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.2</cooldownTime>
        <chanceFactor>0.1</chanceFactor>
      </li>
    </tools>
  </ThingDef>

