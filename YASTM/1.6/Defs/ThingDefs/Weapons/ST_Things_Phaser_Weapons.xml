<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!--  FEDERATION  -->
  <!-- Base ST Phaser -->
  <ThingDef Name="ST_Base_Gun" Abstract="True">
    <category>Item</category>
    <thingClass>ThingWithComps</thingClass>
    <equipmentType>Primary</equipmentType>
    <pathCost>10</pathCost>
    <useHitPoints>True</useHitPoints>
    <selectable>True</selectable>
    <graphicData>
      <onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
    </graphicData>
    <drawGUIOverlay>true</drawGUIOverlay>
    <weaponTags>
      <li>StarfleetPhaser</li>
    </weaponTags>
    <thingCategories>
      <li>WeaponsRanged</li>
      <li>FederationWeapons</li>
    </thingCategories>
    <inspectorTabs>
      <li>ITab_Art</li>
    </inspectorTabs>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
      <SellPriceFactor>0.5</SellPriceFactor>
    </statBases>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>True</alwaysHaulable>
    <tickerType>Never</tickerType>
    <techLevel>Spacer</techLevel>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
      <unfinishedThingDef>UnfinishedGun</unfinishedThingDef>
    </recipeMaker>
    <smeltProducts>
      <Steel>50</Steel>
    </smeltProducts>
	  <smeltable>true</smeltable>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
      <li>
        <compClass>CompEquippable</compClass>
      </li>
    </comps>
  </ThingDef>
 

<!-- Phaser Type I (Multi)-->

  <ThingDef ParentName="ST_Base_Gun">
    <defName>Gun_Phaser_TypeI</defName>
    <label>Phaser Type-I</label>
    <description>A compact Starfleet phaser used for non-lethal or precision operations. Easily concealable, but low-powered.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/Federation_weapons/Phaser_TypeI</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(0.7,0.7)</drawSize>
    </graphicData>
    <uiIconScale>1.5</uiIconScale>
    <soundInteract>Metal_Drop</soundInteract>
    <weaponTags>
      <li>StarfleetPhaser</li>
      <li>ST_Phaser_T1</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>YASTM.Verb_PhaserShoot</verbClass>
        <defaultProjectile>Bullet_PhaserPulse_TypeI</defaultProjectile>
        <hasStandardCommand>true</hasStandardCommand>
        <burstShotCount>1</burstShotCount>
        <ticksBetweenBurstShots>15</ticksBetweenBurstShots>
        <warmupTime>0.40</warmupTime>
        <range>26</range>
        <soundCast>Phaser_T1</soundCast>
        <targetParams><canTargetLocations>true</canTargetLocations></targetParams>
      </li>
    </verbs>
    <statBases>
  <Mass>0.6</Mass>
      <RangedWeapon_Cooldown>1.60</RangedWeapon_Cooldown>
      <AccuracyShort>0.80</AccuracyShort>
      <AccuracyMedium>0.53</AccuracyMedium>
      <AccuracyLong>0.26</AccuracyLong>
      <AccuracyTouch>0.85</AccuracyTouch>
      <WorkToMake>3000</WorkToMake>
      <MarketValue>750</MarketValue>
    </statBases>
    <comps>
          <li Class="YASTM.CompProperties_MultiModeWeapon">
            <modes>     
              <li>
                <label>Setting: Stun</label>
                <iconPath>UI/Icons/Gizmos/PhaserStun_n</iconPath>
                <projectileDef>Bullet_PhaserPulse_Stun</projectileDef>
                <soundInteract>Interact_Rifle</soundInteract>
              </li>
              <li>
                <label>Setting: Kill</label>
                <iconPath>UI/Icons/Gizmos/PhaserLethal_n</iconPath>
                <projectileDef>Bullet_PhaserPulse_TypeI</projectileDef>
                <soundInteract>Interact_Rifle</soundInteract>
              </li>
              <li>
                <label>Setting: Overload</label>
                <iconPath>UI/Icons/Gizmos/PhaserOverload_n</iconPath>
                <projectileDef>Bullet_PhaserPulse_Overcharge</projectileDef>
                <soundInteract>Interact_Rifle</soundInteract>
                <isOverload>true</isOverload>
                <overloadSelfExplodeChance>0.05</overloadSelfExplodeChance>
              </li>
            </modes>
          </li>
    </comps>
    <recipeMaker>
      <workAmount>12000</workAmount>
      <skillRequirements><Crafting>8</Crafting></skillRequirements>
      <recipeUsers>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <researchPrerequisite>ST_Federation_Phaser_I</researchPrerequisite>
    </recipeMaker>
    <costList>
      <Silver>100</Silver>
      <Plasteel>5</Plasteel>
	    <Gold>25</Gold>
	    <Steel>30</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <tradeTags>
      <li>ST_StarfleetSupply</li>
    </tradeTags>
  <alwaysHaulable>true</alwaysHaulable>
  </ThingDef>

  <!-- Weapon: Type-II (Multi) -->
  <ThingDef ParentName="ST_Base_Gun">
    <defName>Gun_Phaser_TypeII</defName>
    <label>phaser type-II </label>
    <description>Standard Starfleet sidearm with lethal and non-lethal setting.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/Federation_weapons/Phaser_TypeII</texPath> 
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <soundInteract>Metal_Drop</soundInteract>
    <weaponTags>
      <li>StarfleetPhaser</li>
      <li>ST_Phaser_T2</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>YASTM.Verb_PhaserShoot</verbClass>
        <defaultProjectile>Bullet_PhaserPulse_TypeII</defaultProjectile>
        <hasStandardCommand>true</hasStandardCommand>
        <burstShotCount>1</burstShotCount>
        <warmupTime>0.50</warmupTime>
        <range>27</range>
        <soundCast>Phaser_T2</soundCast>
        <muzzleFlashScale>0.6</muzzleFlashScale>
        <targetParams><canTargetLocations>true</canTargetLocations></targetParams>
      </li>
    </verbs>
    <statBases>
      <AccuracyTouch>0.80</AccuracyTouch>
      <AccuracyShort>0.83</AccuracyShort>
      <AccuracyMedium>0.55</AccuracyMedium>
      <AccuracyLong>0.30</AccuracyLong>
      <RangedWeapon_Cooldown>1.80</RangedWeapon_Cooldown>
      <Mass>1.1</Mass>
      <WorkToMake>5000</WorkToMake>
      <MarketValue>540</MarketValue>
    </statBases>
        <comps>
          <li Class="YASTM.CompProperties_MultiModeWeapon">
            <modes>     
              <li>
                <label>Setting: Stun</label>
                <iconPath>UI/Icons/Gizmos/PhaserStun_n</iconPath>
                <projectileDef>Bullet_PhaserPulse_Stun</projectileDef>
                <soundInteract>Interact_Rifle</soundInteract>
              </li>
              <li>
                <label>Setting: Kill</label>
                <iconPath>UI/Icons/Gizmos/PhaserLethal_n</iconPath>
                <projectileDef>Bullet_PhaserPulse_TypeII</projectileDef>
                <soundInteract>Interact_Rifle</soundInteract>
              </li>
              <li>
                <label>Setting: Overload</label>
                <iconPath>UI/Icons/Gizmos/PhaserOverload_n</iconPath>
                <projectileDef>Bullet_PhaserPulse_Overcharge</projectileDef>
                <soundInteract>Interact_Rifle</soundInteract>
                <isOverload>true</isOverload>
                <overloadSelfExplodeChance>0.05</overloadSelfExplodeChance>
              </li>
            </modes>
          </li>
        </comps>
    <recipeMaker>
      <workAmount>12000</workAmount>
      <skillRequirements><Crafting>8</Crafting></skillRequirements>
      <recipeUsers>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <researchPrerequisite>ST_Federation_Phaser_II</researchPrerequisite>
    </recipeMaker>
    <costList>
      <Silver>100</Silver>
      <Plasteel>10</Plasteel>
	    <Gold>25</Gold>
	    <Steel>50</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <tradeTags>
      <li>ST_StarfleetSupply</li>
    </tradeTags>
  </ThingDef>

<!-- Phase Rifle -->
  <ThingDef ParentName="ST_Base_Gun">
    <defName>Gun_Phaser_Rifle</defName>
    <label>Phaser Rifle</label>
    <description>A high-power directed energy rifle used in heavy combat scenarios. Federation issue, reliable and accurate at long ranges.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/Federation_weapons/PhaserRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconScale>1</uiIconScale>
    <soundInteract>Metal_Drop</soundInteract>
    <weaponTags>
      <li>Starfleet Phasers Security SNW</li>
    </weaponTags>
  <verbs>
    <li>
    <verbClass>YASTM.Verb_PhaserShoot</verbClass>
    <hasStandardCommand>true</hasStandardCommand>
    <defaultProjectile>Bullet_PhaserRifle</defaultProjectile>
    <burstShotCount>3</burstShotCount>
    <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
    <warmupTime>0.60</warmupTime>
    <range>30</range>
    <soundCast>Phaser_Rifle</soundCast>
    <targetParams>
      <canTargetLocations>true</canTargetLocations>
    </targetParams>
    </li> 
  </verbs>
    <tools>
      <li>
        <label>blast rifle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>3</cooldownTime>
      </li>
    </tools>
    <statBases>
      <Mass>4.8</Mass>
      <RangedWeapon_Cooldown>1.9</RangedWeapon_Cooldown>
      <AccuracyTouch>0.88</AccuracyTouch>
      <AccuracyShort>0.87</AccuracyShort>
      <AccuracyMedium>0.67</AccuracyMedium>
      <AccuracyLong>0.42</AccuracyLong>
      <WorkToMake>7000</WorkToMake>
      <MarketValue>1800</MarketValue>
    </statBases>
    <comps>
      <li Class="YASTM.CompProperties_MultiModeWeapon">
        <modes>
          <li>
            <label>Setting: Lethal</label>
            <iconPath>UI/Icons/Gizmos/PhaserLethal_n</iconPath>
            <projectileDef>Bullet_PhaserRifle</projectileDef>
            <soundInteract>Interact_Rifle</soundInteract>
          </li>
          <li>
            <label>Setting: Lethal AP</label>
            <iconPath>UI/Icons/Gizmos/PhaserLethalAP</iconPath>
            <projectileDef>Bullet_PhaserRifle_AP</projectileDef>
            <soundInteract>Interact_Rifle</soundInteract>
            <isOverload>false</isOverload>
            <overloadSelfExplodeChance>0.0</overloadSelfExplodeChance>
          </li>
          <li>
            <label>Setting: Stun</label>
            <iconPath>UI/Icons/Gizmos/PhaserStun_n</iconPath>
            <projectileDef>Bullet_PhaserPulse_Stun</projectileDef>
            <soundInteract>Interact_Rifle</soundInteract>
          </li>
        </modes>
      </li>
    </comps>
    <recipeMaker>
      <workAmount>16000</workAmount>
      <skillRequirements><Crafting>10</Crafting></skillRequirements>
      <recipeUsers>
        <li>ElectricSmithy</li>
      </recipeUsers>
      <researchPrerequisite>ST_Federation_Phaser_Rifle</researchPrerequisite>
    </recipeMaker>
    <costList>
      <Silver>200</Silver>
      <Plasteel>30</Plasteel>
	    <Gold>30</Gold>
	    <Steel>800</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
   <alwaysHaulable>true</alwaysHaulable>
    <tradeTags>
      <li>ST_StarfleetSupply</li>
    </tradeTags>
  </ThingDef>

  <!-- FERENGI -->
  <ThingDef ParentName="ST_DisruptorBase">
    <defName>FE_Weapon_HandPhaser</defName>
    <label>ferengi hand phaser</label>
    <description>The Ferengi hand phaser, or simply Ferengi phaser, was a type of hand phaser classified as a plasma weapon that was used by the Ferengi and their military personnel.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/Ferengi_weapons/HandPhaser</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <weaponTags>
      <li>FerengiDisruptor</li>
      <li>FerengiPhaser</li>
    </weaponTags>
    <statBases>
      <Mass>1.5</Mass>
      <RangedWeapon_Cooldown>1.7</RangedWeapon_Cooldown>
      <AccuracyShort>0.70</AccuracyShort>
      <AccuracyMedium>0.48</AccuracyMedium>
      <AccuracyLong>0.22</AccuracyLong>
      <MarketValue>500</MarketValue>
    </statBases>
    <verbs>
      <li>
        <verbClass>YASTM.Verb_PhaserShoot</verbClass>
        <defaultProjectile>Bullet_PhaserPulse_TypeI</defaultProjectile>
        <hasStandardCommand>true</hasStandardCommand>
        <burstShotCount>1</burstShotCount>
        <warmupTime>0.50</warmupTime>
        <range>25</range>
        <soundCast>Phaser_T1</soundCast>
        <muzzleFlashScale>0.6</muzzleFlashScale>
        <targetParams><canTargetLocations>true</canTargetLocations></targetParams>
      </li>
    </verbs>
    <comps>
      <li Class="YASTM.CompProperties_MultiModeWeapon">
        <modes>     
          <li>
            <label>Setting: Stun</label>
            <iconPath>UI/Icons/Gizmos/PhaserStun_n</iconPath>
            <projectileDef>Bullet_PhaserPulse_Stun</projectileDef>
            <soundInteract>Interact_Rifle</soundInteract>
          </li>
          <li>
            <label>Setting: Kill</label>
            <iconPath>UI/Icons/Gizmos/PhaserLethal_n</iconPath>
            <projectileDef>Bullet_PhaserPulse_TypeI</projectileDef>
            <soundInteract>Interact_Rifle</soundInteract>
          </li>
          <li>
            <label>Setting: Overload</label>
            <iconPath>UI/Icons/Gizmos/PhaserOverload_n</iconPath>
            <projectileDef>Bullet_PhaserPulse_Overcharge</projectileDef>
            <soundInteract>Interact_Rifle</soundInteract>
            <isOverload>true</isOverload>
            <overloadSelfExplodeChance>0.05</overloadSelfExplodeChance>
          </li>
        </modes>
      </li>
    </comps>
    <recipeMaker>
       <workAmount>5000</workAmount>
       <skillRequirements><Crafting>7</Crafting></skillRequirements>
       <recipeUsers><li>ElectricSmithy</li></recipeUsers>
       <researchPrerequisite>ST_Ferengi_Security_I</researchPrerequisite>
    </recipeMaker>  
    <costList>
      <Silver>50</Silver>
      <Plasteel>5</Plasteel>
      <Steel>40</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <tradeTags>
      <li>ST_FerengiGoods</li>
    </tradeTags>  
  </ThingDef>


</Defs>