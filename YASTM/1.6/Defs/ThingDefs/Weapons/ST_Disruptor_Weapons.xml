<Defs>

  <!-- Disruptor base -->
  <ThingDef Name="ST_DisruptorBase" ParentName="BaseHumanMakeableGun" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <uiIconScale>1.2</uiIconScale>
    <statBases>
      <WorkToMake>4500</WorkToMake>
      <Mass>1.0</Mass>
      <RangedWeapon_Cooldown>1.75</RangedWeapon_Cooldown>
      <AccuracyShort>0.80</AccuracyShort>
      <AccuracyMedium>0.65</AccuracyMedium>
      <AccuracyLong>0.40</AccuracyLong>
      <MarketValue>520</MarketValue>
    </statBases>
    <recipeMaker>
      <workAmount>5000</workAmount>
      <skillRequirements><Crafting>7</Crafting></skillRequirements>
      <recipeUsers>
        <li>ElectricSmithy</li>
      </recipeUsers>
    </recipeMaker>
    <weaponTags>
      <li>Disruptor</li>
        <li>Ultra</li>
    </weaponTags>
  </ThingDef>

  <!-- KLINGONEN -->
  <ThingDef ParentName="ST_DisruptorBase">
    <defName>KL_Weapon_Disruptor_Pistol</defName>
    <label>klingon disruptor pistol</label>
    <description>A compact energy weapon favored by Klingon warriors for its concealability and effectiveness in close-quarters combat. The disruptor pistol delivers powerful energy blasts capable of incapacitating targets quickly.</description> 
    <graphicData>
      <texPath>Things/Item/Equipment/Klingon_weapons/Disruptor_Pistol</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.8,0.8)</drawSize>
    </graphicData>
    <uiIconScale>1.3</uiIconScale>
    <weaponTags>
      <li>KlingonDisruptor</li>
      <li>KlingonDisruptor_Pistol</li>
    </weaponTags>
    <statBases>
      <Mass>3</Mass>
      <RangedWeapon_Cooldown>1.75</RangedWeapon_Cooldown>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.48</AccuracyMedium>
      <AccuracyLong>0.22</AccuracyLong>
      <MarketValue>450</MarketValue>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>KL_Projectile_Disruptor_Pistol</defaultProjectile>
        <hasStandardCommand>true</hasStandardCommand>
        <burstShotCount>1</burstShotCount>
        <warmupTime>0.50</warmupTime>
        <range>26</range>
        <soundCast>Disruptor_Pistol</soundCast>
        <targetParams><canTargetLocations>true</canTargetLocations></targetParams>
      </li>
    </verbs>
    <recipeMaker>
     <workAmount>5500</workAmount>
     <skillRequirements><Crafting>7</Crafting></skillRequirements>
     <recipeUsers><li>ElectricSmithy</li></recipeUsers>
     <researchPrerequisite>ST_Klingon_Disruptor_I</researchPrerequisite>
    </recipeMaker>
    <costList>
      <Plasteel>12</Plasteel>
        <Steel>60</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <tradeTags>
      <li>ST_KlingonArms</li> 
    </tradeTags>
  </ThingDef>

  <ThingDef ParentName="ST_DisruptorBase">
    <defName>KL_Weapon_Disruptor_Rifle</defName>
    <label>klingon disruptor rifle</label>
    <description>A high-powered energy weapon commonly used by Klingon warriors and military forces. Known for its reliability and stopping power, the disruptor rifle is a favored choice for front-line combat and tactical engagements.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/Klingon_weapons/Disruptor_Rifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <uiIconScale>1.3</uiIconScale>
    <weaponTags>
      <li>KlingonDisruptor</li>
      <li>KlingonDisruptor_Rifle</li>
    </weaponTags>
    <statBases>
      <Mass>10</Mass>
      <RangedWeapon_Cooldown>2.10</RangedWeapon_Cooldown>
      <AccuracyShort>0.80</AccuracyShort>
      <AccuracyMedium>0.60</AccuracyMedium>
      <AccuracyLong>0.35</AccuracyLong>
      <MarketValue>1600</MarketValue>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <defaultProjectile>KL_Projectile_Disruptor_Rifle</defaultProjectile>
        <hasStandardCommand>true</hasStandardCommand>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <warmupTime>0.60</warmupTime>
        <range>30</range>
        <soundCast>Disruptor_Rifle</soundCast>
        <targetParams><canTargetLocations>true</canTargetLocations></targetParams>
      </li>
    </verbs>
    <recipeMaker>
     <workAmount>10000</workAmount>
     <skillRequirements><Crafting>7</Crafting></skillRequirements>
     <recipeUsers><li>ElectricSmithy</li></recipeUsers>
     <researchPrerequisite>ST_Klingon_Disruptor_II</researchPrerequisite>
    </recipeMaker>
    <costList>
      <Silver>100</Silver>
      <Plasteel>30</Plasteel>
	    <Steel>150</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <tradeTags>
      <li>ST_KlingonArms</li> 
    </tradeTags>
  </ThingDef>

