<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <DamageDef>
    <defName>ST_PhaserStun</defName>
    <workerClass>DamageWorker_Stun</workerClass>
    <defaultDamage>1</defaultDamage>
    <armorCategory>Blunt</armorCategory>
    <makesBlood>false</makesBlood>
  </DamageDef>

  <!-- Base bullet definition -->
  <ThingDef Name="BaseBullet" Abstract="True">
    <category>Projectile</category>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Projectile</altitudeLayer>
    <thingClass>Bullet</thingClass>
    <label>bullet</label>
    <useHitPoints>False</useHitPoints>
    <neverMultiSelect>True</neverMultiSelect>
    <graphicData>
      <shaderType>Transparent</shaderType>
    </graphicData>
  </ThingDef>

  <!-- Phaser Stun -->
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_PhaserPulse_Stun</defName>
    <label>phaser pulse (stun)</label>
    <thingClass>ST.PhaseWeapons.Projectile_Phaser</thingClass>
    <projectile>
      <damageDef>ST_PhaserStun</damageDef>
      <damageAmountBase>5</damageAmountBase> 
      <armorPenetrationBase>0</armorPenetrationBase>
      <stoppingPower>1.5</stoppingPower>
      <speed>70</speed>
    </projectile>
    <graphicData>
      <texPath>Things/Projectile/PhaserPulse_Stun</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <modExtensions>
      <li Class="ST.PhaseWeapons.ModExtension_PhaserSettings">
        <stunChance>1.0</stunChance>
        <stunOnlyFlesh>true</stunOnlyFlesh>
        <stunTicks>300</stunTicks>
      </li>
    </modExtensions>
  </ThingDef>

<ThingDef ParentName="BaseBullet">
  <defName>Bullet_PhaserPulse_TypeI</defName>
  <thingClass>ST.PhaseWeapons.Projectile_Phaser</thingClass> <!-- WICHTIG -->
  <graphicData>
    <texPath>Things/Projectile/PhaserPulse</texPath>
    <graphicClass>Graphic_Single</graphicClass>
  </graphicData>
  <modExtensions>
    <li Class="ST.PhaseWeapons.ModExtension_PhaserSettings">
      <stunOnlyFlesh>true</stunOnlyFlesh>
      <stunChance>1.0</stunChance>
      <stunTicks>240</stunTicks>
    </li>
  </modExtensions>
  <projectile>
    <flyOverhead>false</flyOverhead>
    <damageDef>Burn</damageDef>
    <damageAmountBase>11</damageAmountBase>
    <armorPenetrationBase>0.14</armorPenetrationBase>
    <speed>120</speed>
  </projectile>
</ThingDef>

  <!-- Hand phaser TII -->
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_PhaserPulse_TypeII</defName>
    <thingClass>ST.PhaseWeapons.Projectile_Phaser</thingClass>

    <graphicData>
      <texPath>Things/Projectile/PhaserPulse</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.80</drawSize>
    </graphicData>

    <projectile>
      <flyOverhead>false</flyOverhead>
      <damageDef>Burn</damageDef>
      <damageAmountBase>12</damageAmountBase>
      <armorPenetrationBase>0.18</armorPenetrationBase>
      <stoppingPower>0.35</stoppingPower>
      <speed>100</speed>
    </projectile>

    <modExtensions>
      <li Class="ST.PhaseWeapons.ModExtension_PhaserSettings">
        <stunTicks>300</stunTicks>
        <stunChance>0.9</stunChance>
        <stunOnlyFlesh>true</stunOnlyFlesh>
      </li>
    </modExtensions>
  </ThingDef>

  <!-- Phase overcharge -->
      <ThingDef ParentName="BaseBullet">
      <defName>Bullet_PhaserPulse_Overcharge</defName>
          <label>phaser pulse (overcharge)</label>
          <thingClass>Bullet</thingClass> <graphicData>
            <texPath>Things/Projectile/PhaserPulse_Overcharge</texPath>
            <graphicClass>Graphic_Single</graphicClass>
             <drawSize>0.50</drawSize>
            </graphicData>
        <projectile>
          <damageDef>Bomb</damageDef> <damageAmountBase>30</damageAmountBase>
          <armorPenetrationBase>0.50</armorPenetrationBase>
          <stoppingPower>2.0</stoppingPower>
          <speed>100</speed>
          <explosionRadius>1.9</explosionRadius>
          <postExplosionSpawnThingDef>Filth_Fuel</postExplosionSpawnThingDef>
          <postExplosionSpawnChance>0.2</postExplosionSpawnChance>
        </projectile>
      </ThingDef>

  <!-- Phaser rifle -->
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_PhaserRifle</defName>
    <thingClass>ST.PhaseWeapons.Projectile_Phaser</thingClass>
    <label>phaser beam (rifle)</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_PhaserRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(1, 0, 0, 1)</color> <!-- greenish -->
    </graphicData>
    <projectile>
    	<flyOverhead>false</flyOverhead>
      <damageDef>Burn</damageDef>
      <damageAmountBase>16</damageAmountBase>
      <armorPenetrationBase>0.25</armorPenetrationBase>
      <speed>90</speed>
    </projectile>
  </ThingDef>

  <!-- Phaser rifle AP -->
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_PhaserRifle_AP</defName>
    <thingClass>ST.PhaseWeapons.Projectile_Phaser</thingClass>
    <label>phaser beam AP (rifle)</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_PhaserRifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(0.1, 0.8, 1, 1)</color>
    </graphicData>
    <projectile>
    	<flyOverhead>false</flyOverhead>
      <damageDef>Burn</damageDef>
      <damageAmountBase>14</damageAmountBase>
      <armorPenetrationBase>0.5</armorPenetrationBase>
      <speed>90</speed>
    </projectile>
  </ThingDef>

  <!-- Compression Rifle Heavy Beam -->
  <ThingDef ParentName="BaseBullet">
      <defName>ST_Bullet_CompressionPhaser</defName>
      <label>compression phaser beam</label>
      <graphicData>
        <texPath>Things/Projectile/Heavy_Beam</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <drawSize>1.5</drawSize>
        <color>(0.4, 0.8, 1, 1)</color> 
      </graphicData>
      <projectile>
        <damageDef>Burn</damageDef> 
        <damageAmountBase>24</damageAmountBase>
        <armorPenetrationBase>0.65</armorPenetrationBase> 
        <speed>120</speed>
        <stoppingPower>1.5</stoppingPower>
      </projectile>
    </ThingDef>

</Defs>
