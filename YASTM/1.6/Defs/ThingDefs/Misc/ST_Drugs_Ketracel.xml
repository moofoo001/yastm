<?xml version="1.0" encoding="utf-8" ?>
<Defs>



<ThingDef ParentName="MakeableDrugBase">
    <defName>ST_KetracelWhite</defName>
    <label>Ketracel White vial</label>
    <description>An isogenic enzyme formulated to provide all necessary nutrients for Jem'Hadar physiology. Without it, their circulatory system collapses. Contains sedatives to suppress aggression and stimulants to replace the need for sleep.</description>
    <descriptionHyperlinks>
      <ChemicalDef>ST_Chemical_Ketracel</ChemicalDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Item/Drug/KetracelWhite</texPath> <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <rotatable>false</rotatable>
    <statBases>
      <WorkToMake>600</WorkToMake>
      <MarketValue>25</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <techLevel>Spacer</techLevel>
    <ingestible>
      <foodType>Fluid, Processed</foodType>
      <drugCategory>Medical</drugCategory>
      <baseIngestTicks>100</baseIngestTicks>
      <ingestSound>Ingest_Inject</ingestSound>
      <ingestHoldOffsetStanding>
        <northDefault>
          <offset>(0.18,0,0)</offset>
        </northDefault>
      </ingestHoldOffsetStanding>
      <ingestCommandString>Administer {0}</ingestCommandString>
      <ingestReportString>Administering {0}.</ingestReportString>
      <chairSearchRadius>0</chairSearchRadius>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>ST_Hediff_KetracelHigh</hediffDef>
          <severity>1.0</severity>
        </li>
        <li Class="IngestionOutcomeDoer_OffsetNeed">
          <need>Food</need>
          <offset>0.9</offset>
        </li>
        <li Class="IngestionOutcomeDoer_OffsetNeed">
          <need>Rest</need>
          <offset>1.0</offset>
        </li>
      </outcomeDoers>
    </ingestible>
    <recipeMaker>
      <researchPrerequisite>ST_Dominion_KetracelProduction</researchPrerequisite>
      <recipeUsers>
        <li>ST_Building_KetracelSynthesizer</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <Chemfuel>1</Chemfuel>
      <Neutroamine>1</Neutroamine> </costList>
    <comps>
      <li Class="CompProperties_Drug">
        <chemical>ST_Chemical_Ketracel</chemical>
        <addictiveness>1.00</addictiveness> <needLevelOffset>1.00</needLevelOffset>
        <listOrder>100</listOrder>
      </li>
    </comps>
  </ThingDef>

<HediffDef>
    <defName>ST_Hediff_KetracelHigh</defName>
    <label>white active</label>
    <description>Ketracel White is coursing through the system, providing clarity and strength.</description>
    <hediffClass>Hediff_High</hediffClass>
    <defaultLabelColor>(179,137,255)</defaultLabelColor> <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.0</severityPerDay> <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0.5</painFactor> <capMods>
          <li><capacity>Consciousness</capacity><offset>0.10</offset></li>
          <li><capacity>Moving</capacity><offset>0.10</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  
<HediffDef ParentName="AddictionBase">
    <defName>ST_Hediff_KetracelDependency</defName>
    <label>Ketracel withdrawal</label>
    <description>Genetically engineered dependency. Without regular doses of Ketracel White, the circulatory system will fail, accompanied by severe paranoia, uncontrollable homicidal rage, and agonizing pain.</description>
    <hediffClass>Hediff_Addiction</hediffClass>
    <chemicalNeed>Chemical_ST_Chemical_Ketracel</chemicalNeed>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.1</severityPerDay>
        <showDaysToRecover>false</showDaysToRecover>
      </li>
    </comps>
    <stages>
      <li></li> 
      <li>
        <label>withdrawal</label>
        <painFactor>3.0</painFactor>
        <capMods>
           <li><capacity>Consciousness</capacity><offset>-0.30</offset></li>
        </capMods>
        <mentalStateGivers>
          <li>
            <mentalState>Berserk</mentalState>
            <mtbDays>0.4</mtbDays> 
          </li>
        </mentalStateGivers>
        <lifeThreatening>true</lifeThreatening>
      </li>
    </stages>
  </HediffDef>

  <GeneDef>
    <defName>Gene_ChemicalDependency_ST_Chemical_Ketracel</defName>
    <label>Ketracel dependency</label>
    <description>Carriers of this gene need to ingest Ketracel White on a regular basis to survive.</description>
    <geneClass>Gene_ChemicalDependency</geneClass> 
    <labelShortAdj>Ketracel-dependent</labelShortAdj>
    <iconPath>UI/Icons/Genes/Gene_KetracelDependency</iconPath> 
    
    <chemical>ST_Chemical_Ketracel</chemical>
    
    <displayCategory>ST_Category_Dominion</displayCategory>
    <displayOrderInCategory>0</displayOrderInCategory>
    
    <biostatCpx>1</biostatCpx>
    <biostatMet>4</biostatMet> 
    <minAgeActive>13</minAgeActive>
    
    <symbolPack>
      <prefixSymbols>
        <li><symbol>white</symbol></li>
        <li><symbol>ketra</symbol></li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>

<ChemicalDef>
    <defName>ST_Chemical_Ketracel</defName>
    <label>Ketracel White</label>
    <addictionHediff>ST_Hediff_KetracelDependency</addictionHediff>
    <geneOverdoseChanceFactorResist>0.5</geneOverdoseChanceFactorResist>
    <geneOverdoseChanceFactorImmune>0</geneOverdoseChanceFactorImmune>
</ChemicalDef>

  <NeedDef ParentName="DrugAddictionNeedBase">
    <defName>Chemical_ST_Chemical_Ketracel</defName>
    <needClass>Need_Chemical</needClass>
    <label>Ketracel White</label>
    <description>Because of a genetic dependency or addiction, this person needs to regularly consume Ketracel White to avoid death.</description>
    <listPriority>45</listPriority>
  </NeedDef>
</Defs>