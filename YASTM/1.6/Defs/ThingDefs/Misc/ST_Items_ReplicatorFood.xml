<?xml version="1.0" encoding="utf-8"?>
<Defs>

<ThingDef ParentName="ResourceBase">
  <defName>ST_ReplicatorFeedstock</defName>
  <label>replicator feedstock</label>
  <description>Processed material condensed into a form suitable for use as feedstock in matter replication systems.</description>
  <thingClass>ThingWithComps</thingClass>
  <graphicData>
      <texPath>Things/Item/Meal/ReplicatorFeedstock</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    <drawSize>1,1</drawSize>
  </graphicData>
  <stackLimit>20</stackLimit>
  <statBases>
    <MarketValue>2.0</MarketValue>
    <Mass>2</Mass>
  </statBases>
  <thingCategories>
    <li>ResourcesRaw</li>
  </thingCategories>
</ThingDef>

<ThingDef ParentName="MealFineBase">
  <defName>ST_Replicated_LuxuryMeal</defName>
  <label>replicated luxury meal</label>
    <description>A carefully calibrated pattern of gourmet Federation cuisine.
Nutritionally perfect and beautifully presented, but true chefs
still claim they can taste the replicator in every bite.</description>
  <graphicData>
      <texPath>Things/Item/Meal/ST_LuxuryMeal</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    <drawSize>(1.3,1.3)</drawSize>
  </graphicData>
  <statBases>
    <MarketValue>24</MarketValue>
    <WorkToMake>550</WorkToMake>
    <Nutrition>0.9</Nutrition>
  </statBases>
  <ingestible>
    <preferability>MealFine</preferability>
    <tasteThought>ST_Thought_AteReplicatedLuxuryMeal</tasteThought>
    <ingestEffect>EatVegetarian</ingestEffect>
    <ingestSound>Meal_Eat</ingestSound>
    <chairSearchRadius>80</chairSearchRadius>
  </ingestible>
      <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>40</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
      <li Class="CompProperties_Ingredients">
        <noIngredientsFoodKind>Meat</noIngredientsFoodKind>
      </li>
    </comps>
</ThingDef>

<ThingDef ParentName="MealBase">
  <defName>ST_Emergency_Ration</defName>
  <label>replicated emergency ration</label>
    <description>A dense, long-life ration block designed for lifeboats,
away teams, and disaster kits. Keeps you alive and
operational for a long time, but nobody eats this for fun.</description>
  <graphicData>
      <texPath>Things/Item/Meal/ST_EmergencyMeal</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(1.3,1.3)</drawSize>
  </graphicData>
  <statBases>
    <MarketValue>25</MarketValue>
    <WorkToMake>500</WorkToMake>
    <Nutrition>0.9</Nutrition>
  </statBases>
  <ingestible>
      <preferability>MealSimple</preferability>
      <optimalityOffsetHumanlikes>2</optimalityOffsetHumanlikes>
      <optimalityOffsetFeedingAnimals>-50</optimalityOffsetFeedingAnimals>
      <tasteThought>ST_Thought_AteEmergencyRation</tasteThought>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <chairSearchRadius>40</chairSearchRadius>
  </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>70</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
      <li Class="CompProperties_Ingredients">
        <noIngredientsFoodKind>Meat</noIngredientsFoodKind>
      </li>
    </comps>
</ThingDef>

<ThingDef ParentName="MealBase">
  <defName>ST_Replicated_SimpleMeal</defName>
  <label>replicated simple meal</label>
  <description>A basic nutritional meal created via Federation replicator patterns.
    Its flavor is acceptable, though slightly synthetic compared to real cooking.</description>
  <graphicData>
      <texPath>Things/Item/Meal/ST_SimpleMeal</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    <drawSize>(1.3,1.3)</drawSize>
  </graphicData>
   <statBases>
    <MarketValue>10</MarketValue>
    <WorkToMake>350</WorkToMake>
    <Nutrition>0.8</Nutrition>
  </statBases>
  <ingestible>
      <preferability>MealSimple</preferability>
      <tasteThought>ST_Thought_AteReplicatedSimpleMeal</tasteThought>
      <optimalityOffsetHumanlikes>-3</optimalityOffsetHumanlikes>
      <optimalityOffsetFeedingAnimals>-100</optimalityOffsetFeedingAnimals>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <chairSearchRadius>40</chairSearchRadius>
  </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>20</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
      <li Class="CompProperties_Ingredients">
        <noIngredientsFoodKind>Meat</noIngredientsFoodKind>
      </li>
      <li Class="CompProperties_FoodPoisonable" />
    </comps>
</ThingDef>

<ThingDef ParentName="MealBase">
  <defName>ST_Drink_Raktajino</defName>
  <label>replicated raktajino</label>
  <description>A strong Klingon coffee blend popular throughout Starfleet.
Rich, bitter, and heavily caffeinated – ideal for late-shift
bridge crews and overworked engineers.</description>
  <graphicData>
      <texPath>Things/Item/Meal/ST_Drink_Raktajino</texPath>
    <graphicClass>Graphic_StackCount</graphicClass>
        <drawSize>(1.3,1.3)</drawSize>
  </graphicData>
  <statBases>
    <MarketValue>12</MarketValue>
    <WorkToMake>250</WorkToMake>
    <Nutrition>0.08</Nutrition>
  </statBases>
  <ingestible>
    <preferability>MealSimple</preferability>
    <joy>0.14</joy>
    <joyKind>Gluttonous</joyKind>
    <tasteThought>ST_Thought_DrankRaktajino</tasteThought>
    <ingestEffect>EatVegetarian</ingestEffect>
    <ingestSound>Meal_Eat</ingestSound>
    <chairSearchRadius>40</chairSearchRadius>
  </ingestible>
</ThingDef>

<ThingDef ParentName="MealBase">
    <defName>ST_Drink_BananaWater</defName>
    <label>hot banana water</label>
    <description>A mug containing heated water infused with banana extract. It is surprisingly soothing, rich in potassium, and a favorite of certain Starfleet commanders who find coffee too jittery.\n\n"Keep it coming!"</description>
    <graphicData>
      <texPath>Things/Item/Meal/ST_Drink_BananaWater</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(1.3,1.3)</drawSize>
    </graphicData>
    <stackLimit>25</stackLimit>
    <statBases>
      <MarketValue>5</MarketValue>
      <Mass>0.3</Mass>
      <Nutrition>0.25</Nutrition> </statBases>
    <ingestible>
      <preferability>MealSimple</preferability>
      <foodType>Liquor</foodType>
      <joy>0.30</joy>
      <joyKind>Social</joyKind>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Ingest_Drink</ingestSound>
      <optimalityOffsetHumanlikes>10</optimalityOffsetHumanlikes>
    </ingestible>
  </ThingDef>

  <ThingDef ParentName="MealBase">
    <defName>ST_Meal_PlomeekSoup</defName>
    <label>plomeek soup</label>
    <description>A traditional Vulcan breakfast broth. It is reddish-orange, extremely nutritious, mild in flavor, and perfectly logical. \n\nHistorically known for its aerodynamic properties when thrown at bulkheads during Pon Farr.</description>
    <graphicData>
      <texPath>Things/Item/Meal/ST_PlomeekSoup</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(1.3,1.3)</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>20</MarketValue>
      <Mass>0.4</Mass>
      <Nutrition>0.90</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealFine</preferability>
      <tasteThought>AteFineMeal</tasteThought>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
    </ingestible>
  </ThingDef>

<ThingDef ParentName="MealBase">
    <defName>ST_Drink_MachineOil</defName>
    <label>warm poly-lubricant</label>
    <description>A cup of industrial-grade synthetic lubricant. Perfectly tailored for android servos and positronic neural nets.\n\nWarning: Consumption by organic lifeforms may result in severe indigestion, nausea, and questioning of one's life choices.</description>
    <graphicData>
      <texPath>Things/Item/Meal/ST_Drink_MachineOil</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(1.3,1.3)</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>8</MarketValue>
      <Mass>0.3</Mass>
      <Nutrition>0.10</Nutrition>
    </statBases>
    <ingestible>
      <preferability>NeverForNutrition</preferability>
      <foodType>Liquor</foodType>
      <joy>0.10</joy>
      <joyKind>Chemical</joyKind>
      <ingestEffect>Smoke_Joint</ingestEffect>
      <ingestSound>Ingest_Drink</ingestSound>
      <optimalityOffsetHumanlikes>-30</optimalityOffsetHumanlikes> <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>FoodPoisoning</hediffDef>
          <chance>0.3</chance>
        </li>
      </outcomeDoers>
    </ingestible>
  </ThingDef>

  <ThingDef ParentName="MealBase">
    <defName>ST_Drink_PruneJuice</defName>
    <label>chilled prune juice</label>
    <description>An opaque, purple liquid derived from dried plums. While considered a geriatric aid by some species, Klingons revere it for its bold texture and cleansing properties.\n\n"A warrior's drink!"</description>
    <graphicData>
      <texPath>Things/Item/Meal/ST_Drink_PruneJuice</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>(1.3,1.3)</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>10</MarketValue>
      <Mass>0.3</Mass>
      <Nutrition>0.4</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealSimple</preferability>
      <foodType>Liquor</foodType>
      <joy>0.40</joy>
      <joyKind>Social</joyKind>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Ingest_Drink</ingestSound>
    </ingestible>
  </ThingDef>

</Defs>