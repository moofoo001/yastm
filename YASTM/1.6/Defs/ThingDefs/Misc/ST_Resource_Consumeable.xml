<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="DrugBase">
    <defName>ST_Bloodwine</defName>
    <label>Bloodwine</label>
    <description>A popular alcoholic beverage among the Klingons, traditionally served warm. Highly intoxicating and twice as potent as whiskey. It is known to induce aggression and high pain tolerance in those who can stomach it.\n\n"2309. There is no finer vintage!"</description>
    <graphicData>
      <texPath>Things/Item/Meal/ST_KlingonBloodwine</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>

    <rotatable>false</rotatable>
    <stackLimit>25</stackLimit>
    <statBases>
      <MarketValue>35</MarketValue>
      <Mass>0.4</Mass>
      <DeteriorationRate>0.5</DeteriorationRate>
      <Nutrition>0.15</Nutrition>
    </statBases>

    <ingestible>
      <foodType>Fluid, Processed, Liquor</foodType>
      <joyKind>Chemical</joyKind>
      <joy>0.60</joy>
      <nurseable>true</nurseable>
      <drugCategory>Social</drugCategory>
      <ingestSound>Ingest_Beer</ingestSound>
      <ingestHoldOffsetStanding>
        <northDefault>
          <offset>(0.18,0,0)</offset>
        </northDefault>
      </ingestHoldOffsetStanding>
      <ingestCommandString>Drink {0}</ingestCommandString>
      <ingestReportString>Drinking {0}.</ingestReportString>
      <chairSearchRadius>25</chairSearchRadius>
      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>AlcoholHigh</hediffDef>
          <severity>0.35</severity>
          <toleranceChemical>Alcohol</toleranceChemical>
        </li>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          <hediffDef>AlcoholTolerance</hediffDef>
          <toleranceChemical>Alcohol</toleranceChemical>
          <severity>0.04</severity>
          <divideByBodySize>true</divideByBodySize>
        </li>
      </outcomeDoers>
    </ingestible>
    
    <equipmentType>Primary</equipmentType>
    <techLevel>Spacer</techLevel>
    
    <comps>
      <li Class="CompProperties_Drug">
        <chemical>Alcohol</chemical>
        <addictiveness>0.02</addictiveness>
        <minToleranceToAddict>0.25</minToleranceToAddict>
        <existingAddictionSeverityOffset>0.20</existingAddictionSeverityOffset>
        <needLevelOffset>0.9</needLevelOffset>
        <listOrder>10</listOrder>
      </li>
     <li>
        <compClass>CompEquippable</compClass>
      </li>
    </comps>

    <weaponClasses>
      <li>Melee</li>
      <li>MeleeBlunt</li>
    </weaponClasses>
    <tools>
      <li>
        <label>bottle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>neck</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    
    <researchPrerequisites>
      <li>Brewing</li>
      <li>Klingon_Standard</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>