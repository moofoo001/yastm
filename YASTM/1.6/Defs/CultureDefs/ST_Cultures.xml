<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <CultureDef>
    <defName>post_scarcity_society</defName>
    <label>Post-Scarcity Society</label>
    <description>Culturally, the Federation embodies a post-scarcity society where poverty,
    hunger,and economic inequality have been eradicated. This transformation,
    driven by technologies like replicators, allows individuals to pursue self-fulfillment rather than survival.
    </description>
    <ideoNameMaker>NamerIdeoName_Starfleet</ideoNameMaker>
    <deityNameMaker>NamerDeity_UFP</deityNameMaker>
    <deityTypeMaker>DeityTypeMaker_UFP</deityTypeMaker>
    <leaderTitleMaker>NamerLeaderTitle_Starfleet</leaderTitleMaker>
    <festivalNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerFestivalAstropolitan</festivalNameMaker>
    <allowedPlaceTags>
      <li>OriginSpacer</li>
    </allowedPlaceTags>
    <iconPath>UI/Icons/IdeoIcons/ps_society</iconPath>
    <styleItemTags>
      <li>
        <tag>Urban</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoBeard</tag>
        <baseWeight>10</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>BeardRural</tag>
        <baseWeight>0.1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>BeardUrban</tag>
        <baseWeight>0.2</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
      <li>
        <tag>NoTattoo</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
    </styleItemTags>
  </CultureDef>


