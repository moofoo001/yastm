<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <JoyKindDef>
    <defName>ST_RessikanMemory</defName>
    <label>Ressikan flute</label>
    <needsThing>true</needsThing>
  </JoyKindDef>

  <JobDef>
    <defName>ST_PlayRessikanFluteBoxJob</defName>
    <driverClass>JobDriver_WatchBuilding</driverClass>
    <reportString>playing the Ressikan flute.</reportString>
    <joyDuration>3000</joyDuration>
    <joyMaxParticipants>1</joyMaxParticipants>
    <joySkill>Artistic</joySkill> <joyXpPerTick>0.005</joyXpPerTick>
    <joyKind>ST_RessikanMemory</joyKind>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JoyGiverDef>
    <defName>ST_PlayRessikanFluteBox</defName>
    <giverClass>JoyGiver_InteractBuildingInteractionCell</giverClass>
    <baseChance>2.5</baseChance> <thingDefs>
      <li>ST_RessikanFluteBox</li> </thingDefs>
    <jobDef>ST_PlayRessikanFluteBoxJob</jobDef>
    <joyKind>ST_RessikanMemory</joyKind>
    <requiredCapacities>
      <li>Manipulation</li> <li>Hearing</li> </requiredCapacities>
  </JoyGiverDef>

</Defs>