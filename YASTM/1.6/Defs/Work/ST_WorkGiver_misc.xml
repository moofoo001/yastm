      <li>ST_HoloEmitter</li>
    </fixedBillGiverDefs>
    <verb>training</verb>
    <gerund>training at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

<!-- Ketracel Synthesizer-->
<WorkGiverDef>
    <defName>DoBill_ST_KetracelSynthesizer</defName>
    <label>synthesize Ketracel White</label>
    <giverClass>WorkGiver_DoBill</giverClass>       
    <workType>Crafting</workType> <priorityInType>90</priorityInType>
    <fixedBillGiverDefs>
      <li>ST_Building_KetracelSynthesizer</li>
    </fixedBillGiverDefs>
    <verb>synthesize</verb>
    <gerund>synthesizing at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

<!-- Cloning Vat -->
  <WorkGiverDef>
    <defName>DoBill_ST_CloningVat</defName>
    <label>operate cloning vat</label>
    <giverClass>WorkGiver_DoBill</giverClass>       
    <workType>Crafting</workType> <priorityInType>85</priorityInType>
    <fixedBillGiverDefs>
      <li>ST_Building_CloningVat</li>
    </fixedBillGiverDefs>
    <verb>sequence clone</verb>
    <gerund>sequencing clone at</gerund>
