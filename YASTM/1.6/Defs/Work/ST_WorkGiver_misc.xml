<!-- Ship Ops -->
  <WorkTypeDef>
    <defName>ST_WorkType_ShipOps</defName>
    <labelShort>Bridge</labelShort>
    <pawnLabel>Officer</pawnLabel>
    <gerundLabel>manning bridge</gerundLabel>
    <description>Manning bridge stations.</description>
    <naturalPriority>1000</naturalPriority>
    <alwaysStartActive>true</alwaysStartActive>
  </WorkTypeDef>

<!-- Bridge -->
  <WorkGiverDef>
    <defName>ST_WorkGiver_ManBridge</defName>
    <label>man bridge station</label>
    <giverClass>YASTM.WorkGiver_ManBridgeStation</giverClass>
    <verb>man</verb>
    <gerund>manning</gerund>
    <priorityInType>100</priorityInType>
    <workType>ST_WorkType_ShipOps</workType> 
  </WorkGiverDef>


</Defs>
