<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- Obelisk scan -->


 <WorkGiverDef>
    <defName>ST_UseMedicalTricorder</defName>
    <label>use medical tricorder</label>
    <giverClass>YASTM.WorkGiver_UseMedicalTricorder</giverClass>
    <workType>Doctor</workType>
    <priorityInType>9999</priorityInType>
    <emergency>true</emergency>
    <verb>scan</verb>
    <gerund>scanning</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>DoBill_ST_MatterConverter</defName>
    <label>operate matter converter</label>
    <giverClass>WorkGiver_DoBill</giverClass>       
    <workType>Crafting</workType>
    <priorityInType>80</priorityInType>
    <fixedBillGiverDefs>
      <li>ST_MatterConverter</li>
    </fixedBillGiverDefs>
    <verb>operate matter converter</verb>
    <gerund>extracting from</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

	<WorkGiverDef>
		<defName>DoBill_ST_Replicator</defName>
		<label>replicate anything ...</label>
		<giverClass>WorkGiver_DoBill</giverClass>
		<workType>Cooking</workType>
		<priorityInType>100</priorityInType>
		<fixedBillGiverDefs>
			<li>ST_Replicator</li>
		</fixedBillGiverDefs>
		<verb>cook</verb>
		<gerund>replicating at</gerund>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
		<prioritizeSustains>true</prioritizeSustains>
	</WorkGiverDef>

<WorkGiverDef>
    <defName>ST_DoBillsHolodeck</defName>
    <label>train on holodeck</label>
    <giverClass>WorkGiver_DoBill</giverClass>
    <workType>Research</workType> 
    <priorityInType>100</priorityInType>
    <fixedBillGiverDefs>
      <li>ST_HoloEmitter</li>
    </fixedBillGiverDefs>
    <verb>training</verb>
    <gerund>training at</gerund>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

</Defs>
