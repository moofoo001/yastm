<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <TraderKindDef>
    <defName>ST_Trader_Starfleet_Supplies</defName>
    <label>Starfleet supplies</label>
    <commonality>1.6</commonality>
    <orbital>false</orbital>
    <stockGenerators>
        <!-- Resources -->
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>750~1200</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentIndustrial</thingDef>
        <countRange>30~40</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentSpacer</thingDef>
        <countRange>-10~2</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Steel</thingDef>
        <countRange>250~400</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Cloth</thingDef>
        <countRange>250~400</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Chemfuel</thingDef>
        <countRange>250~400</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Neutroamine</thingDef>
        <countRange>70~160</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Beer</thingDef>
        <totalPriceRange>-100~100</totalPriceRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Chocolate</thingDef>
        <totalPriceRange>10~40</totalPriceRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Dye</thingDef>
        <countRange>15~20</countRange>
      </li>
      <li Class="StockGenerator_ReinforcedBarrels">
        <countRange>1~4</countRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>FoodRaw</categoryDef>
        <thingDefCountRange>3~3</thingDefCountRange>
        <totalPriceRange>150~600</totalPriceRange>
        <excludedCategories>
          <li>EggsFertilized</li>
        </excludedCategories>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>Textiles</categoryDef>
        <excludedThingDefs>
          <li MayRequire="Ludeon.RimWorld.Anomaly">Leather_Dread</li>
        </excludedThingDefs>
      </li>
      <li Class="StockGenerator_MultiDef">
        <thingDefs>
          <li>Chocolate</li>
          <li>Kibble</li>
          <li>Pemmican</li>
        </thingDefs>
      </li>
    
    <!-- Techprints -->
      <li Class="StockGenerator_Techprints">
        <countChances>
          <li>
            <count>2</count>
            <chance>0.5</chance>
          </li>
          <li>
            <count>3</count>
            <chance>0.5</chance>
          </li>
        </countChances>
      </li>

      <!-- Books -->
      <li Class="StockGenerator_Category">
        <categoryDef>Books</categoryDef>
        <excludedThingDefs>
          <li MayRequire="Ludeon.RimWorld.Anomaly">Tome</li> <!-- only available in Anomaly, handled seperately -->
        </excludedThingDefs>
        <thingDefCountRange>2</thingDefCountRange>
        <countRange>-2~1</countRange>
      </li>  
      
      <li MayRequire="Ludeon.RimWorld.Anomaly" Class="StockGenerator_Tomes">
        <countRange>-2~1</countRange>
      </li>

      <li Class="StockGenerator_SingleDef">
        <thingDef>Schematic</thingDef>
        <countRange>1~1</countRange>
      </li>

      <!-- Apparel -->
      <li Class="StockGenerator_MarketValue">
        <tradeTag>BasicClothing</tradeTag>
        <countRange>8~12</countRange>
      </li>
      <li Class="StockGenerator_MarketValue">
        <tradeTag>Clothing</tradeTag>
        <countRange>2~4</countRange>
      </li>
      <li Class="StockGenerator_MarketValue">
        <tradeTag>Armor</tradeTag>
        <countRange>2~4</countRange>
      </li>

      <!-- Implants -->
      <li Class="StockGenerator_Tag">
        <tradeTag>TechHediff</tradeTag>
        <thingDefCountRange>2~4</thingDefCountRange>
        <countRange>1~1</countRange>
      </li>

      <!-- Buildings -->
      <li Class="StockGenerator_Category">
        <categoryDef>BuildingsFurniture</categoryDef>
        <thingDefCountRange>3~4</thingDefCountRange>
        <countRange>1~2</countRange>
      </li>
      <li Class="StockGenerator_MarketValue">
        <tradeTag>Art</tradeTag>
        <countRange>5~10</countRange>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>Television</tradeTag>
        <thingDefCountRange>1~2</thingDefCountRange>
        <countRange>1~2</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Telescope</thingDef>
        <countRange>0~1</countRange>
      </li>

      <!-- Exotic -->
      <li Class="StockGenerator_Tag">
        <tradeTag>Artifact</tradeTag>
        <thingDefCountRange>1~4</thingDefCountRange>
        <countRange>1~1</countRange>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>ExoticMisc</tradeTag>
        <thingDefCountRange>1~4</thingDefCountRange>
        <countRange>1~2</countRange>
        <excludedThingDefs>
          <li>Luciferium</li> <!-- already handled by drugs -->
          <li>ComponentSpacer</li> <!-- already handled by single def -->
        </excludedThingDefs>
        <customCountRanges>
          <MedicineUltratech>2~15</MedicineUltratech>
          <Hyperweave>50~200</Hyperweave>
        </customCountRanges>
      </li>

      <!-- Genepacks -->
      <li MayRequire="Ludeon.RimWorld.Biotech" Class="StockGenerator_SingleDef">
        <thingDef>Genepack</thingDef>
        <countRange>0~4</countRange>
      </li>

      <!-- Serums -->
      <li MayRequire="Ludeon.RimWorld.Anomaly" Class="StockGenerator_Tag">
        <tradeTag>Serum</tradeTag>
        <thingDefCountRange>4~4</thingDefCountRange>
        <countRange>-3~1</countRange> <!-- 20% chance of appearing -->
        <excludedThingDefs>
          <li>VoidsightSerum</li>
        </excludedThingDefs>
      </li>

      <!-- Animals -->
      <li Class="StockGenerator_Animals">
        <tradeTagsSell>
          <li>AnimalFarm</li>
          <li>AnimalPet</li>
        </tradeTagsSell>
        <tradeTagsBuy>
          <li>AnimalUncommon</li>
          <li>AnimalExotic</li>
        </tradeTagsBuy>
        <kindCountRange>2~4</kindCountRange>
        <countRange>3~8</countRange>
        <createMatingPair>
          <li>AnimalFarm</li>
        </createMatingPair>
      </li>



      <!-- Department tunics -->
      <li Class="StockGenerator_SingleDef"><thingDef>ST_Apparel_StarfleetTunic_Command</thingDef><countRange>1~2</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>ST_Apparel_StarfleetTunic_Operations</thingDef><countRange>1~2</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>ST_Apparel_StarfleetTunic_Science</thingDef><countRange>1~2</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>ST_Apparel_StarfleetTunic_Medical</thingDef><countRange>1~2</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>ST_Apparel_StarfleetPants</thingDef><countRange>2~5</countRange></li>
      
      <!-- Field gear -->
      <li Class="StockGenerator_SingleDef"><thingDef>ST_Apparel_TricorderBelt</thingDef><countRange>0~2</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>ST_Tricorder_Medical</thingDef><countRange>0~2</countRange></li>

      <!-- EV suit -->
      <li Class="StockGenerator_SingleDef"><thingDef>ST_Apparel_Starfleet_EVS</thingDef><countRange>0~1</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>ST_Apparel_Starfleet_EVS_Helmet</thingDef><countRange>0~1</countRange></li>

      <!-- Core support -->
      <li Class="StockGenerator_SingleDef"><thingDef>ComponentIndustrial</thingDef><countRange>8~20</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>MedicineIndustrial</thingDef><countRange>6~18</countRange></li>

      <!-- Buying -->
      <li Class="StockGenerator_BuyExpensiveSimple" />
      <li Class="StockGenerator_BuyTradeTag"><tag>Art</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>MusicalInstrument</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>AnimalPart</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>UtilitySpecial</tag></li>
    </stockGenerators>
  </TraderKindDef>

  <!-- Ferengi: „Bulk + Exotics“-Mischung -->
  <TraderKindDef>
    <defName>Trader_Ferengi_CommerceGuild</defName>
    <label>Ferengi commerce guild caravan</label>
    <commonality>2</commonality>
    <orbital>false</orbital>
    <stockGenerators>
      <li Class="StockGenerator_Category"><categoryDef>ResourcesRaw</categoryDef><countRange>30~70</countRange></li>
      <li Class="StockGenerator_Category"><categoryDef>Manufactured</categoryDef><countRange>25~50</countRange></li>
      <li Class="StockGenerator_Category"><categoryDef>Foods</categoryDef><countRange>30~60</countRange></li>
      <li Class="StockGenerator_Category"><categoryDef>Medicine</categoryDef><countRange>8~16</countRange></li>
      <li Class="StockGenerator_Category"><categoryDef>Drugs</categoryDef><countRange>6~14</countRange></li>
      <!-- bisschen Exotik -->
      <li Class="StockGenerator_Tag"><tradeTag>ExoticMisc</tradeTag><countRange>2~6</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>Gold</thingDef><countRange>10~30</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>ComponentIndustrial</thingDef><countRange>10~25</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>ComponentSpacer</thingDef><countRange>4~10</countRange></li>
    </stockGenerators>
  </TraderKindDef>

  <TraderKindDef>
    <defName>Trader_Ferengi_Exotics</defName>
    <label>Ferengi exotics caravan</label>
    <commonality>1</commonality>
    <orbital>false</orbital>
    <stockGenerators>
      <li Class="StockGenerator_Tag"><tradeTag>ExoticMisc</tradeTag><countRange>6~12</countRange></li>
      <li Class="StockGenerator_Category"><categoryDef>Manufactured</categoryDef><countRange>15~30</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>ComponentSpacer</thingDef><countRange>6~12</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>Gold</thingDef><countRange>20~50</countRange></li>
      <li Class="StockGenerator_Category"><categoryDef>Drugs</categoryDef><countRange>8~16</countRange></li>
      <li Class="StockGenerator_Category"><categoryDef>Medicine</categoryDef><countRange>8~16</countRange></li>
    </stockGenerators>
  </TraderKindDef>

  <!-- Klingonen: kampflastig (Combat Supplier-ähnlich) -->
  <TraderKindDef>
    <defName>Trader_Klingon_Armory</defName>
    <label>Klingon armory caravan</label>
    <commonality>1.4</commonality>
    <orbital>false</orbital>
    <stockGenerators>
      <li Class="StockGenerator_Category"><categoryDef>WeaponsMelee</categoryDef><countRange>6~12</countRange></li>
      <li Class="StockGenerator_Category"><categoryDef>WeaponsRanged</categoryDef><countRange>5~10</countRange></li>
      <li Class="StockGenerator_Category"><categoryDef>Apparel</categoryDef><countRange>10~20</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>ComponentIndustrial</thingDef><countRange>8~16</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>ComponentSpacer</thingDef><countRange>4~10</countRange></li>
      <li Class="StockGenerator_Category"><categoryDef>Medicine</categoryDef><countRange>6~12</countRange></li>
    </stockGenerators>
  </TraderKindDef>

  <!-- Romulaner: leise/high-tech -->
  <TraderKindDef>
    <defName>Trader_Romulan_BlackOps</defName>
    <label>Romulan logistics caravan</label>
    <commonality>1.2</commonality>
    <orbital>false</orbital>
    <stockGenerators>
      <li Class="StockGenerator_Category"><categoryDef>WeaponsRanged</categoryDef><countRange>4~8</countRange></li>
      <li Class="StockGenerator_Category"><categoryDef>Apparel</categoryDef><countRange>8~16</countRange></li>
      <li Class="StockGenerator_SingleDef"><thingDef>ComponentSpacer</thingDef><countRange>4~10</countRange></li>
      <li Class="StockGenerator_Category"><categoryDef>Medicine</categoryDef><countRange>8~16</countRange></li>
      <li Class="StockGenerator_Tag"><tradeTag>ExoticMisc</tradeTag><countRange>2~5</countRange></li>
      <li Class="StockGenerator_Category"><categoryDef>Drugs</categoryDef><countRange>6~12</countRange></li>
    </stockGenerators>
  </TraderKindDef>


  <!-- ========================= -->
  <!-- Ferengi Commerce Exchange -->
  <!-- ========================= -->
  <TraderKindDef>
    <defName>ST_Ferengi_CommerceExchange</defName>
    <label>Ferengi commerce exchange</label>
    <requestable>true</requestable>
    <stockGenerators>
      <!-- Luxus & Konsum -->
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Chocolate</thingDef><countRange>20~60</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Beer</thingDef><countRange>18~50</countRange></li>

      <!-- Drogen (Profit) -->
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Yayo</thingDef><countRange>10~30</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Flake</thingDef><countRange>10~30</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>GoJuice</thingDef><countRange>4~10</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>WakeUp</thingDef><countRange>8~18</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>SmokeleafJoint</thingDef><countRange>12~40</countRange></li>

      <!-- Exoten/teures Kleinzeug -->
      <li Class="RimWorld.StockGenerator_Tag"><tradeTag>ExoticMisc</tradeTag><countRange>2~6</countRange></li>

      <!-- Komponenten / Technik -->
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>ComponentIndustrial</thingDef><countRange>10~24</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>ComponentSpacer</thingDef><countRange>2~6</countRange></li>

      <!-- Medizin -->
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>MedicineIndustrial</thingDef><countRange>8~20</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>MedicineUltratech</thingDef><countRange>2~6</countRange></li>

      <!-- Rohstoffe / Edelmetalle -->
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Gold</thingDef><countRange>6~20</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Uranium</thingDef><countRange>10~28</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Plasteel</thingDef><countRange>16~48</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Steel</thingDef><countRange>80~200</countRange></li>

      <!-- Kunst (optional, Vanilla) -->
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>SculptureSmall</thingDef><countRange>1~3</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>SculptureLarge</thingDef><countRange>0~2</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>SculptureGrand</thingDef><countRange>0~1</countRange></li>

      <!-- Hook für Trek-Güter -->
      <li Class="RimWorld.StockGenerator_Tag"><tradeTag>ST_FerengiGoods</tradeTag><countRange>2~6</countRange></li>
    </stockGenerators>
  </TraderKindDef>

  <!-- ====================== -->
  <!-- Klingonischer Waffendealer -->
  <!-- ====================== -->
  <TraderKindDef>
    <defName>ST_Klingon_ArmsDealer</defName>
    <label>klingon arms dealer</label>
    <requestable>true</requestable>
    <stockGenerators>
      <!-- Nahkampf (korrekte Vanilla-DefNames) -->
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>MeleeWeapon_Knife</thingDef><countRange>1~3</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>MeleeWeapon_Mace</thingDef><countRange>1~3</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>MeleeWeapon_LongSword</thingDef><countRange>1~2</countRange></li>

      <!-- Fernkampf -->
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Gun_Autopistol</thingDef><countRange>1~3</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Gun_HeavySMG</thingDef><countRange>1~2</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Gun_BoltActionRifle</thingDef><countRange>1~2</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Gun_AssaultRifle</thingDef><countRange>1~2</countRange></li>

      <!-- Explosives & Basis-Rüstung -->
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Shell_HighExplosive</thingDef><countRange>2~6</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Apparel_FlakVest</thingDef><countRange>1~3</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Apparel_FlakJacket</thingDef><countRange>1~2</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Apparel_FlakPants</thingDef><countRange>1~2</countRange></li>

      <!-- Hook für Trek-Waffen/Rüstungen -->
      <li Class="RimWorld.StockGenerator_Tag"><tradeTag>ST_KlingonArms</tradeTag><countRange>2~5</countRange></li>
    </stockGenerators>
  </TraderKindDef>

  <!-- ======================= -->
  <!-- Romulan Intelligence Broker -->
  <!-- ======================= -->
  <TraderKindDef>
    <defName>ST_Romulan_IntelligenceBroker</defName>
    <label>romulan intelligence broker</label>
    <requestable>true</requestable>
    <stockGenerators>
      <!-- Kleine Mengen High-Tech & Rare -->
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>ComponentSpacer</thingDef><countRange>1~3</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>MedicineUltratech</thingDef><countRange>1~3</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Uranium</thingDef><countRange>6~18</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Plasteel</thingDef><countRange>12~30</countRange></li>
      <li Class="RimWorld.StockGenerator_Tag"><tradeTag>ExoticMisc</tradeTag><countRange>1~3</countRange></li>

      <!-- Hook für Trek-Spionage/Tech -->
      <li Class="RimWorld.StockGenerator_Tag"><tradeTag>ST_RomulanIntel</tradeTag><countRange>1~3</countRange></li>
    </stockGenerators>
  </TraderKindDef>

  <!-- ======================= -->
  <!-- Starfleet Logistics Convoy -->
  <!-- ======================= -->
  <TraderKindDef>
    <defName>ST_Starfleet_LogisticsConvoy</defName>
    <label>starfleet logistics convoy</label>
    <requestable>true</requestable>
    <stockGenerators>
      <!-- Medizin & Versorgung -->
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>MedicineHerbal</thingDef><countRange>12~36</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>MedicineIndustrial</thingDef><countRange>12~28</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>MedicineUltratech</thingDef><countRange>2~6</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>MealSurvivalPack</thingDef><countRange>24~64</countRange></li>

      <!-- Bauteile & Grundstoffe -->
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>ComponentIndustrial</thingDef><countRange>10~24</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Steel</thingDef><countRange>80~200</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>Plasteel</thingDef><countRange>12~40</countRange></li>
      <li Class="RimWorld.StockGenerator_SingleDef"><thingDef>ComponentSpacer</thingDef><countRange>1~3</countRange></li>

      <!-- Hook für Starfleet-Supplies -->
      <li Class="RimWorld.StockGenerator_Tag"><tradeTag>ST_StarfleetSupply</tradeTag><countRange>2~6</countRange></li>
    </stockGenerators>
  </TraderKindDef>

</Defs>
