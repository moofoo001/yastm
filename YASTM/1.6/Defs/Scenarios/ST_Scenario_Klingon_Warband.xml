<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ScenarioDef ParentName="ScenarioBase">
    <defName>ST_Scenario_Klingon_Rite</defName>
    <label>Klingon Rite: Age Of Ascension</label>
    <description>Age Of Ascension.\n\nThree Klingon youths seeking glory on a harsh world, beginning their path as warriors.</description>
    <scenario>
      <summary>Three Klingon warriors - Qapla'!</summary>
      <playerFaction>
        <def>PlayerFaction</def>
        <factionDef>ST_Player_KlingonHouse</factionDef>
      </playerFaction>
      <parts>
      
        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs">
          <def>ConfigurePawnsKindDefs</def>
          <pawnChoiceCount>3</pawnChoiceCount>
          <kindCounts>
            <li><kindDef>KLG_Warrior</kindDef><count>3</count><requiredAtStart>true</requiredAtStart></li>
           </kindCounts>
        </li>

        <!-- Player pawns modifiers -->
        <li Class="ScenPart_PawnFilter_Age">
          <def>PawnFilter_Age</def>
          <allowedAgeRange>13~18</allowedAgeRange>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>DropPods</method>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>KL_Weapon_Batleth</thingDef>
          <stuff>Steel</stuff>
          <count>2</count>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>KL_Weapon_Disruptor_Pistol</thingDef>
          <count>1</count>
        </li>

        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsAnywhere</def>
          <thingDef>ST_Bloodwine</thingDef>
          <count>20</count>
        </li>

        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsAnywhere</def>
          <thingDef>Steel</thingDef>
          <count>500</count>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>ScatterThingsAnywhere</def>
          <thingDef>WoodLog</thingDef>
          <count>300</count>
        </li>
        <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>StartingThing_Defined</def>
          <thingDef>Pemmican</thingDef>
          <count>500</count>
        </li>
       
       <li Class="ScenPart_ScatterThingsNearPlayerStart">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineHerbal</thingDef>
          <count>20</count>
        </li>

        <li Class="ScenPart_ForcedTrait">
          <def>ForcedTrait</def>
          <chance>0.5</chance>
          <trait>Bloodlust</trait>
        </li>

        <li Class="YASTM.ScenPart_KlingonRiteMarker" /> 

        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_KindDefs" />

        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>Klingon_Standard</project>
        </li>

        <li Class="ScenPart_GameStartDialog">
          <def>GameStartDialog</def>
          <text>Today I am a Warrior. I must show you my heart. I travel the river of blood.</text>
          <closeSound>GameStartSting</closeSound>
        </li>
        
      </parts>
    </scenario>
  </ScenarioDef>

</Defs>