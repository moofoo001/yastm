<?xml version="1.0" encoding="utf-8" ?>
<Defs>


  <RecipeDef>
    <defName>ST_RefineDilithium</defName>
    <label>refine dilithium</label>
    <description>Process raw dilithium crystals into a stable form suitable for warp cores.</description>
    <jobString>Refining dilithium.</jobString>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <workAmount>1000</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ST_DilithiumCrystal</li> </thingDefs>
        </filter>
        <count>10</count> </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ST_DilithiumCrystal</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <ST_Dilithium_Refined>5</ST_Dilithium_Refined> </products>
    <recipeUsers>
      <li>FabricationBench</li> 
    </recipeUsers>
    <researchPrerequisites>
      <li>ST_MatterConversion_Tech</li>
    </researchPrerequisites>
  </RecipeDef>

    <RecipeDef>
      <defName>ST_Make_Bloodwine_Must</defName>
      <label>stomp serpent worms</label>
      <description>Crush live serpent worms with bare feet to extract the fluids for bloodwine fermentation.</description>
      <jobString>Stomping worms.</jobString>
      <ingredients>
        <li>
          <filter>
            <thingDefs>
              <li>ST_RawSerpentWorms</li>
            </thingDefs>
          </filter>
          <count>20</count>
        </li>
      </ingredients>
      </RecipeDef>


    <RecipeDef ParentName="SurgeryFlesh">
        <defName>ST_InstallNeuralInterface</defName>
        <label>install neural interface</label>
        <description>Implant a neural interface port connecting directly to the brain.</description>
        <workerClass>Recipe_InstallImplant</workerClass>
        <jobString>Installing neural interface.</jobString>
        <workAmount>2500</workAmount>
        <recipeUsers>
          <li>Human</li>
        </recipeUsers>
        <skillRequirements>
          <Medicine>8</Medicine>
        </skillRequirements>
        <ingredients>
          <li>
            <filter>
              <thingDefs>
                <li>ST_NeuralInterfaceKit</li>
              </thingDefs>
            </filter>
            <count>1</count>
          </li>
        </ingredients>
        <fixedIngredientFilter>
          <thingDefs>
            <li>ST_NeuralInterfaceKit</li>
          </thingDefs>
        </fixedIngredientFilter>
        <appliedOnFixedBodyParts>
          <li>Brain</li> 
        </appliedOnFixedBodyParts>
        <addsHediff>ST_Hediff_NeuralInterface</addsHediff>
    </RecipeDef>
  
</Defs>