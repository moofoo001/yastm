<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <RecipeDef>
    <defName>ST_Program_TransporterTraining</defName>
    <label>run program: Transporter Certification</label>
    <description>Trains the user in transporter operations using the provided data chip.</description>
    <jobString>Training on Holodeck.</jobString>
    <workAmount>4000</workAmount>
    <workSpeedStat>ResearchSpeed</workSpeedStat>
    <soundWorking>Recipe_Machining</soundWorking>
    <workerClass>YASTM.Recipe_GiveTraitUniversal</workerClass> 

    <modExtensions>
      <li Class="YASTM.DefModExtension_GiveTrait">
        <traitDef>ST_TransporterEngineer</traitDef> </li>
    </modExtensions>
    
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ST_IsoChip_Transporter</li> </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ST_IsoChip_Transporter</li>
      </thingDefs>
    </fixedIngredientFilter>
    
    <recipeUsers>
      <li>ST_HoloEmitter</li>
    </recipeUsers>
  </RecipeDef>


  <RecipeDef>
    <defName>ST_Program_PilotTraining</defName>
    <label>run program: Shuttle Pilot School</label>
    <description>Intensive flight training simulation. Grants the Pilot trait.</description>
    <jobString>Flying simulation.</jobString>
    <workAmount>6000</workAmount> <workerClass>YASTM.Recipe_GiveTraitUniversal</workerClass> 
    <modExtensions>
      <li Class="YASTM.DefModExtension_GiveTrait">
        <traitDef>Pilot_Cadet</traitDef>
        <degree>0</degree>
      </li>
    </modExtensions>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ST_IsoChip_Pilot</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>ST_IsoChip_Pilot</li>
      </thingDefs>
    </fixedIngredientFilter>
    <recipeUsers>
      <li>ST_HoloEmitter</li>
    </recipeUsers>
  </RecipeDef>

