<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- clonning -->

<RecipeDef>
    <defName>ST_Recipe_GrowJemHadar</defName>
    <label>grow Jem'Hadar</label>
    <description>Synthesize a Jem'Hadar soldier using organic matter and chemical accelerators. Takes roughly 1.5 to 2 days of active supervision.</description>
    <jobString>Decanting Jem'Hadar...</jobString>
    <workAmount>40000</workAmount> 
    <unfinishedThingDef>ST_UnfinishedClone</unfinishedThingDef> 
    <workSpeedStat>MedicalTendSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <customSummary>protein</customSummary>
          <categories>
            <li>MeatRaw</li>
            <li>AnimalProductRaw</li>
          </categories>
        </filter>
        <count>100</count>
      </li>
      <li>
        <filter><thingDefs><li>Neutroamine</li></thingDefs></filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
        <li>AnimalProductRaw</li>
      </categories>
      <thingDefs>
        <li>Neutroamine</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <ST_Item_JemHadarPod>1</ST_Item_JemHadarPod>
    </products>
    <recipeUsers>
      <li>ST_Building_CloningVat</li>
    </recipeUsers>
  </RecipeDef>

  <RecipeDef>
    <defName>ST_Recipe_CloneVorta</defName>
    <label>sequence Vorta</label>
    <description>Carefully construct a Vorta clone body and implant memory engrams. A highly complex process taking several days.</description>
    <jobString>Sequencing Vorta...</jobString>
    <workAmount>80000</workAmount>
    <unfinishedThingDef>ST_UnfinishedClone</unfinishedThingDef>
    <workSpeedStat>MedicalTendSpeed</workSpeedStat>
    <ingredients>
      <li>
        <filter>
          <customSummary>protein</customSummary>
          <categories>
            <li>MeatRaw</li>
            <li>AnimalProductRaw</li>
          </categories>
        </filter>
        <count>100</count>
      </li>
      <li>
        <filter><thingDefs><li>Neutroamine</li></thingDefs></filter>
        <count>15</count>
      </li>
      <li>
        <filter><thingDefs><li>ComponentSpacer</li></thingDefs></filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <categories>
        <li>MeatRaw</li>
        <li>AnimalProductRaw</li>
      </categories>
      <thingDefs>
        <li>Neutroamine</li>
        <li>ComponentSpacer</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <ST_Item_VortaPod>1</ST_Item_VortaPod>
    </products>
    <recipeUsers>
      <li>ST_Building_CloningVat</li>
    </recipeUsers>
  </RecipeDef>

</Defs>
