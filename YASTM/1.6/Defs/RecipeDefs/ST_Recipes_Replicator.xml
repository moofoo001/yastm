<?xml version="1.0" encoding="UTF-8"?>
<Defs>

  <!-- Safe smoke-test recipe for the replicator -->
  <RecipeDef>
    <defName>ST_Replicate_SimpleMeal</defName>
    <label>replicate simple meal</label>
    <description>Replicate a basic meal using nanomatter patterns.</description>

    <!-- keep ints to avoid "Parsed 0.1 as int" -->
    <workAmount>400</workAmount>
    <workSkill>Cooking</workSkill>
    <workSkillLearnFactor>1</workSkillLearnFactor>
    <effectWorking>Cook</effectWorking>
    <soundWorking>ST_SFX_LCARS_Click</soundWorking>

    <!-- RimWorld erlaubt die Kurzschreibweise pro Skill -->
    <skillRequirements>
      <Cooking>2</Cooking>
    </skillRequirements>

    <!-- Tag-Style verhindert das bekannte "thingDef+count klebt zusammen"-Problem -->
    <products>
      <MealSimple>1</MealSimple>
    </products>

    <recipeUsers>
      <li>ST_Replicator</li>
    </recipeUsers>
  </RecipeDef>

</Defs>
