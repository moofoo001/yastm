<?xml version="1.0" encoding="UTF-8"?>
<Defs>

<!-- Matter converter recipe
      Raw materials -->

<RecipeDef>
    <defName>ST_Condense_ReplicatorFeedstock</defName>
    <label>condense replicator feedstock</label>
    <description>Condense atmospheric water, trace inorganics and raw biomass into feedstock suitable for replicator patterns.</description>

    <workAmount>800</workAmount>
    <workSkill>Construction</workSkill>
    <workSkillLearnFactor>0.8</workSkillLearnFactor>
    <effectWorking>ConstructMetal</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <recipeUsers>
      <li>ST_MatterConverter</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <customSummary>inorganics and raw biomass</customSummary>
          <categories>

            <li>StoneChunks</li>
            <li>StoneBlocks</li>
            <li>RawMinerals</li>

            <li>PlantFoodRaw</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
    </ingredients>

    <fixedIngredientFilter>
      <categories>
        <li>StoneChunks</li>
        <li>StoneBlocks</li>
        <li>RawMinerals</li>
        <li>PlantFoodRaw</li>
      </categories>
    </fixedIngredientFilter>

    <defaultIngredientFilter>
      <categories>
        <li>StoneChunks</li>
        <li>StoneBlocks</li>
        <li>RawMinerals</li>
        <li>PlantFoodRaw</li>
      </categories>
    </defaultIngredientFilter>

    <products>
      <ST_ReplicatorFeedstock>10</ST_ReplicatorFeedstock>
    </products>

    <researchPrerequisite>ST_MatterConversion_Tech</researchPrerequisite>
    
  </RecipeDef>

  <!-- Scrap to feedstock -->
  <RecipeDef>
  <defName>ST_ReclaimScrapToFeedstock</defName>
  <label>reclaim scrap into replicator feedstock</label>
  <description>Break down obsolete weapons and apparel into generic matter that can be refined into replicator feedstock.</description>
  <jobString>Reclaiming scrap into feedstock.</jobString>

  <workAmount>800</workAmount>
  <workSpeedStat>SmeltingSpeed</workSpeedStat>
  <effectWorking>Smelt</effectWorking>
  <soundWorking>Recipe_Smelt</soundWorking>
    <recipeUsers>
      <li>ST_MatterConverter</li>
    </recipeUsers>
  
  <ingredients>
    <li>
      <filter>
        <categories>
          <li>Weapons</li>
          <li>Apparel</li>
        </categories>
      </filter>
      <count>1</count>
    </li>
  </ingredients>

  <fixedIngredientFilter>
    <categories>
      <li>Weapons</li>
      <li>Apparel</li>
    </categories>
  </fixedIngredientFilter>

  <defaultIngredientFilter>
    <categories>
      <li>Weapons</li>
      <li>Apparel</li>
    </categories>

    <disallowedThingDefs>
      <li>Gun_DoomsdayRocket</li>
      <li>Gun_TripleRocket</li>
      <li>TornadoGenerator</li>
      <li>OrbitalTargeterPowerBeam</li>
      <li>OrbitalTargeterBombardment</li>
    </disallowedThingDefs>
  </defaultIngredientFilter>

  <products>
    <ST_ReplicatorFeedstock>1</ST_ReplicatorFeedstock>
  </products>

  <researchPrerequisite>ST_Replicator_Tech</researchPrerequisite>
</RecipeDef>

 
 <!-- Replicator recipe 
