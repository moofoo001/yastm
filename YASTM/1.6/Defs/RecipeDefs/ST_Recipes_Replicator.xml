    </skillRequirements>
    <ingredients/>

    <!-- old ingredients format preserved for reference
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ST_ReplicatorFeedstock</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    
  <fixedIngredientFilter>
    <thingDefs>
      <li>ST_ReplicatorFeedstock</li>
    </thingDefs>
  </fixedIngredientFilter>

  <defaultIngredientFilter>
    <thingDefs>
      <li>ST_ReplicatorFeedstock</li>
    </thingDefs>
  </defaultIngredientFilter>
  -->

