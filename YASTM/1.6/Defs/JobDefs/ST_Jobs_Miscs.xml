<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Ktarian Headset -->
  <JobDef>
    <defName>ST_PlayKtarianHeadset</defName>
    <driverClass>YASTM.JobDriver_PlayKtarianHeadset</driverClass>
    <reportString>using the Ktarian headset.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
    <alwaysShowWeapon>false</alwaysShowWeapon>
  </JobDef>

  <!-- medical Tricorder -->
  <JobDef>
    <defName>ST_ScanAllyMedical</defName>
    <driverClass>YASTM.JobDriver_ScanAllyMedical</driverClass>
    <reportString>scanning patient.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
  </JobDef>

  <!-- scientific Tricorder -->
  <JobDef>
    <defName>ST_ScanAreaScience</defName>
    <driverClass>YASTM.JobDriver_ScanAreaScience</driverClass>
    <reportString>scanning area.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
  </JobDef>

  <!-- security Tricorder -->
  <JobDef>
    <defName>ST_ScanAreaSecurity</defName>
    <driverClass>YASTM.JobDriver_ScanAreaSecurity</driverClass>
    <reportString>performing a tactical sweep.</reportString>
    <casualInterruptible>true</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
  </JobDef>

  <!-- science console scan operation -->
  <JobDef>
    <defName>YASTM_OperateScienceConsoleScan</defName>
    <driverClass>YASTM.Jobs.JobDriver_OperateScienceConsoleScan</driverClass>
    <reportString>operating the science console.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

  <!-- Obelisk scan -->
  <JobDef>
    <defName>ST_ScanObelisk</defName>
    <label>scan obelisk</label>
    <driverClass>YASTM.Jobs.JobDriver_ScanObelisk</driverClass>
    <reportString>scanning the obelisk TargetA.</reportString>
    <playerInterruptible>true</playerInterruptible>
    <casualInterruptible>true</casualInterruptible>
    <alwaysShowWeapon>false</alwaysShowWeapon>
   <checkOverrideOnDamage>OnlyIfInstigatorNotJobTarget</checkOverrideOnDamage>
  </JobDef>

  <!-- Badgey purge -->
  <JobDef>
    <defName>ST_Job_PurgeBadgey</defName>
    <driverClass>YASTM.JobDriver_PurgeBadgey</driverClass>
    <reportString>purging AI systems.</reportString>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <!-- Bridge station operation -->
  <JobDef>
    <defName>ST_Job_ManBridgeStation</defName>
    <driverClass>YASTM.Jobs.JobDriver_ManBridgeStation</driverClass>
    <reportString>manning station.</reportString>
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
    <suspendable>false</suspendable>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>

</Defs>
