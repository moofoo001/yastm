<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Briefing completed -->
  <ThoughtDef>
    <defName>ST_Thought_Briefing_Completed</defName>
    <label>briefing completed</label>
    <description>A concise team briefing left me focused and aligned.</description>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>briefing completed</label>
        <baseMoodEffect>3</baseMoodEffect>
        <description>The briefing clarified our objectives and boosted my confidence.</description>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Shore leave completed -->
  <ThoughtDef>
    <defName>ST_Thought_ShoreLeave_Completed</defName>
    <label>shore leave</label>
    <description>Time off with the crew helped me unwind.</description>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>shore leave</label>
        <baseMoodEffect>5</baseMoodEffect>
        <description>Relaxing time with the crew left me refreshed and ready for action.</description>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Ktarian craving -->  
<ThoughtDef>
  <defName>ST_KtarianCraving</defName>
  <label>ktarian craving</label>
  <description>A lingering urge to return to the Ktarian game.</description>
  <durationDays>1.5</durationDays>
  <stackLimit>1</stackLimit>
  <thoughtClass>Thought_Memory</thoughtClass>
  <stages>
    <li>
      <label>ktarian craving</label>
      <baseMoodEffect>-6</baseMoodEffect>
      <description>A lingering urge to return to the Ktarian game.</description> 
    </li>
  </stages>
</ThoughtDef>

  <!-- Promotion honored -->
  <ThoughtDef>
    <defName>ST_PromotionHonored</defName>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <thoughtClass>Thought_Memory</thoughtClass>
    <stages>
      <li>
        <label>honored by promotion</label>
        <description>Was formally recognized for service. Crew morale is up.</description>
        <baseMoodEffect>6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Tribble purr comfort -->
  <ThoughtDef>
    <defName>ST_Tribbles_Purr</defName>
    <durationDays>0.08</durationDays> <!-- ~4800 Ticks -->
    <stackLimit>1</stackLimit>
    <thoughtClass>Thought_Memory</thoughtClass>
    <stages>
      <li>
        <label>comforted by tribble</label>
        <description>The gentle purring of a tribble soothes the mind.</description>
        <baseMoodEffect>+3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Tribble Tribble Tribble Tribble Tribble Tribble Tribble Tribble !!!!! -->
  <ThoughtDef>
    <defName>ST_Tribbles_Overrun</defName>
    <durationDays>0.2</durationDays>
    <stackLimit>1</stackLimit>
    <thoughtClass>Thought_Memory</thoughtClass>
    <stages>
      <li>
        <label>overrun by tribbles</label>
        <description>They are everywhere…</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Positiver Moodlet, wenn verehrtes Tier in der Nähe -->
  <ThoughtDef>
    <defName>ST_VeneratedAnimal_Presence</defName>
    <durationDays>0.05</durationDays>           <!-- ~3000 Ticks -->
    <stackLimit>1</stackLimit>
    <thoughtClass>Thought_Memory</thoughtClass>
    <stages>
      <li>
        <label>near a venerated animal</label>
        <description>The presence of a venerated animal soothes the spirit.</description>
        <baseMoodEffect>+4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

<!-- Simple replicated meal: okay but synthetic -->
  <ThoughtDef>
    <defName>ST_Thought_AteReplicatedSimpleMeal</defName>
    <label>ate replicated meal</label>
    <durationDays>0.4</durationDays>
    <stackLimit>1</stackLimit>
    <thoughtClass>Thought_Memory</thoughtClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>ate a replicated meal</label>
        <description>A meal straight from the replicator. Efficient and consistent, but the taste is a little too perfect.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Emergency ration: keeps you alive, not happy -->
  <ThoughtDef>
    <defName>ST_Thought_AteEmergencyRation</defName>
    <label>ate emergency ration</label>
    <durationDays>0.8</durationDays>
    <stackLimit>2</stackLimit>
    <thoughtClass>Thought_Memory</thoughtClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>ate an emergency ration</label>
        <description>I had to rely on an emergency ration. Functional, but hardly enjoyable.</description>
        <baseMoodEffect>-2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Luxury replicated meal: base fine-meal feeling, Ferengi get extra -->
  <ThoughtDef>
    <defName>ST_Thought_AteReplicatedLuxuryMeal</defName>
    <label>enjoyed replicated luxury meal</label>
    <description>A carefully patterned luxury dish from the replicator. Almost indistinguishable from the real thing.</description>
    <durationDays>0.9</durationDays>
    <stackLimit>1</stackLimit>
    <thoughtClass>StarTrekFactions.Thoughts.Thought_Memory_ReplicatedLuxuryMeal</thoughtClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>enjoyed a replicated luxury meal</label>
        <description>A carefully patterned luxury dish from the replicator. Almost indistinguishable from the real thing.</description>
        <!-- baseline, Ferengi get extra in C# -->
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Raktajino: small universal buff, big buff for Starfleet -->
  <ThoughtDef>
    <defName>ST_Thought_DrankRaktajino</defName>
    <label>drank raktajino</label>
    <description>A strong cup of raktajino. Perfect for staying alert on duty.</description>
    <durationDays>0.35</durationDays>
    <stackLimit>1</stackLimit>
    <thoughtClass>StarTrekFactions.Thoughts.Thought_Memory_Raktajino</thoughtClass>
    <validWhileDespawned>false</validWhileDespawned>
    <stages>
      <li>
        <label>drank raktajino</label>
        <description>A strong cup of raktajino. Perfect for staying alert on duty.</description>
        <baseMoodEffect>2</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Ferengi profit blessing -->
  <ThoughtDef>
    <defName>ST_Thought_Ferengi_ProfitBlessing</defName>
    <label>profit blessing</label>
    <description>I am blessed by the Rules of Acquisition. Prosperity will follow me.</description>
    <thoughtClass>Thought_Memory</thoughtClass>
    <stackLimit>1</stackLimit>
    <durationDays>2</durationDays>
    <stages>
      <li>
        <label>profit-blessed</label>
        <description>I am blessed by the Rules of Acquisition. Prosperity will follow me.</description>
        <baseMoodEffect>+6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Situational mood buff when the colony owns the Sword of Kahless -->
  <ThoughtDef>
    <defName>ST_SwordOfKahless_Inspiration</defName>
    <label>presence of the Sword of Kahless</label>
    <description>The legendary Sword of Kahless is in the hands of the House. Every true Klingon
      feels the call to glorious battle and unity.</description>
    <workerClass>YASTM.Thoughts.ThoughtWorker_SwordOfKahless</workerClass>
    <durationDays>-1</durationDays>
    <stackLimit>1</stackLimit>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>inspired by the Sword of Kahless</label>
        <description>The legendary Sword of Kahless is in the hands of the House. Every true Klingon
          feels the call to glorious battle and unity. </description>
        <baseMoodEffect>10</baseMoodEffect> <!-- +10 Mood -->
      </li>
    </stages>
  </ThoughtDef>

</Defs>
