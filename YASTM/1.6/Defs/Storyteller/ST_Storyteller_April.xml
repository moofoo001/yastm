<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <StorytellerDef ParentName="BaseStoryteller">
    <defName>ST_Storyteller_AdmiralApril</defName>
    <label>Admiral Robert April</label>
    <description>A measured Starfleet approach: more missions and science opportunities, fewer relentless assaults, and longer recovery after major incidents.</description>

    <!-- KORREKTE Feldnamen für 1.6 -->
    <portraitLarge>UI/Storytellers/Starfleet/April</portraitLarge>
    <portraitTiny>UI/Storytellers/Starfleet/AprilSmall</portraitTiny>

    <listOrder>15</listOrder>

    <!-- Eigene Komps (keine Vererbung vom Parent) -->
    <comps Inherit="False">

      <!-- sanfter Start -->
      <li Class="RimWorld.StorytellerCompProperties_ClassicIntro"/>

      <!-- Große Bedrohungen -->
      <li Class="RimWorld.StorytellerCompProperties_OnOffCycle">
        <category>ThreatBig</category>
        <minDaysPassed>11</minDaysPassed>
        <onDays>5</onDays>
        <offDays>7</offDays>
        <minSpacingDays>2</minSpacingDays>
        <numIncidentsRange>1~2</numIncidentsRange>
        <forceRaidEnemyBeforeDaysPassed>20</forceRaidEnemyBeforeDaysPassed>
        <disallowedTargetTags>
          <li>Map_RaidBeacon</li>
        </disallowedTargetTags>
      </li>

      <!-- „Beacon“-Bedrohungen separat -->
      <li Class="RimWorld.StorytellerCompProperties_ThreatsGenerator">
        <allowedTargetTags>
          <li>Map_RaidBeacon</li>
        </allowedTargetTags>
        <parms>
          <allowedThreats>Raids</allowedThreats>
          <onDays>1</onDays>
          <offDays>1</offDays>
          <minSpacingDays>1</minSpacingDays>
          <numIncidentsRange>1~2</numIncidentsRange>
          <minThreatPoints>550</minThreatPoints>
        </parms>
      </li>

      <!-- Kleine Bedrohungen -->
      <li Class="RimWorld.StorytellerCompProperties_OnOffCycle">
        <category>ThreatSmall</category>
        <minDaysPassed>11</minDaysPassed>
        <onDays>5</onDays>
        <offDays>7</offDays>
        <minSpacingDays>1</minSpacingDays>
        <numIncidentsRange>0~1</numIncidentsRange>
        <acceptPercentFactorPerThreatPointsCurve>
          <points>
            <li>(800, 1)</li>
            <li>(2400, 0.35)</li>
            <li>(3000, 0)</li>
          </points>
        </acceptPercentFactorPerThreatPointsCurve>
      </li>

      <!-- „Serienalltag“ -->
      <li Class="RimWorld.StorytellerCompProperties_CategoryMTB">
        <category>Misc</category>
        <allowedTargetTags>
          <li>Map_PlayerHome</li>
        </allowedTargetTags>
        <minDaysPassed>5</minDaysPassed>
        <mtbDays>5</mtbDays>
      </li>

      <li Class="RimWorld.StorytellerCompProperties_ShipChunkDrop"/>

      <!-- Krankheiten etwas später -->
      <li Class="RimWorld.StorytellerCompProperties_Disease">
        <category>DiseaseHuman</category>
        <minDaysPassed>9</minDaysPassed>
      </li>
      <li Class="RimWorld.StorytellerCompProperties_Disease">
        <category>DiseaseAnimal</category>
        <minDaysPassed>9</minDaysPassed>
      </li>

      <!-- Fraktions-Interaktionen -->
      <li Class="RimWorld.StorytellerCompProperties_FactionInteraction">
        <incident>RaidFriendly</incident>
        <baseIncidentsPerYear>15</baseIncidentsPerYear>
        <minSpacingDays>0.4</minSpacingDays>
        <fullAlliesOnly>true</fullAlliesOnly>
        <minDanger>High</minDanger>
      </li>
      <li Class="RimWorld.StorytellerCompProperties_FactionInteraction">
        <incident>TraderCaravanArrival</incident>
        <minDaysPassed>5</minDaysPassed>
        <baseIncidentsPerYear>6</baseIncidentsPerYear>
        <minSpacingDays>5</minSpacingDays>
        <allowedTargetTags>
          <li>Map_PlayerHome</li>
        </allowedTargetTags>
      </li>
      <li Class="RimWorld.StorytellerCompProperties_FactionInteraction">
        <incident>VisitorGroup</incident>
        <minDaysPassed>3</minDaysPassed>
        <baseIncidentsPerYear>5</baseIncidentsPerYear>
        <minSpacingDays>4</minSpacingDays>
        <allowedTargetTags>
          <li>Map_PlayerHome</li>
        </allowedTargetTags>
      </li>
      <li Class="RimWorld.StorytellerCompProperties_FactionInteraction">
        <incident>TravelerGroup</incident>
        <minDaysPassed>1</minDaysPassed>
        <baseIncidentsPerYear>7</baseIncidentsPerYear>
        <minSpacingDays>0.9</minSpacingDays>
        <allowedTargetTags>
          <li>Map_PlayerHome</li>
        </allowedTargetTags>
      </li>

      <!-- Biome-spezifische Zufälle -->
      <li Class="RimWorld.StorytellerCompProperties_CategoryIndividualMTBByBiome">
        <category>Misc</category>
        <allowedTargetTags>
          <li>Caravan</li>
          <li>Map_TempIncident</li>
        </allowedTargetTags>
      </li>
      <li Class="RimWorld.StorytellerCompProperties_CategoryIndividualMTBByBiome">
        <category>ThreatSmall</category>
        <applyCaravanVisibility>true</applyCaravanVisibility>
        <allowedTargetTags>
          <li>Caravan</li>
          <li>Map_TempIncident</li>
        </allowedTargetTags>
      </li>
      <li Class="RimWorld.StorytellerCompProperties_CategoryIndividualMTBByBiome">
        <category>ThreatBig</category>
        <applyCaravanVisibility>true</applyCaravanVisibility>
        <allowedTargetTags>
          <li>Caravan</li>
          <li>Map_TempIncident</li>
        </allowedTargetTags>
      </li>

      <!-- Quests – mit/ohne Royalty -->
      <li Class="RimWorld.StorytellerCompProperties_RandomQuest">
        <category>GiveQuest</category>
        <allowedTargetTags>
          <li>World</li>
        </allowedTargetTags>
        <onDays>10</onDays>
        <numIncidentsRange>1</numIncidentsRange>
        <acceptFractionByDaysPassedCurve>
          <points>
            <li>(8, 0)</li>
            <li>(15, 1)</li>
          </points>
        </acceptFractionByDaysPassedCurve>
        <minSpacingDays>2.7</minSpacingDays>
        <disableIfAnyModActive>
          <li>Ludeon.RimWorld.Royalty</li>
        </disableIfAnyModActive>
      </li>

      <li Class="RimWorld.StorytellerCompProperties_RandomQuest">
        <category>GiveQuest</category>
        <allowedTargetTags>
          <li>World</li>
        </allowedTargetTags>
        <onDays>12</onDays>
        <numIncidentsRange>2</numIncidentsRange>
        <acceptFractionByDaysPassedCurve>
          <points>
            <li>(8, 0)</li>
            <li>(15, 1)</li>
          </points>
        </acceptFractionByDaysPassedCurve>
        <minSpacingDays>2.7</minSpacingDays>
        <enableIfAnyModActive>
          <li>Ludeon.RimWorld.Royalty</li>
        </enableIfAnyModActive>
      </li>

      <!-- Weltweite Misc -->
      <li Class="RimWorld.StorytellerCompProperties_CategoryMTB">
        <category>Misc</category>
        <allowedTargetTags>
          <li>World</li>
        </allowedTargetTags>
        <minDaysPassed>15</minDaysPassed>
        <mtbDays>14</mtbDays>
      </li>

      <!-- Orbit-Händler -->
      <li Class="RimWorld.StorytellerCompProperties_OnOffCycle">
        <incident>OrbitalTraderArrival</incident>
        <onDays>7</onDays>
        <offDays>7</offDays>
        <numIncidentsRange>1</numIncidentsRange>
      </li>

      <!-- Kleiner „Story-Hook“ -->
      <li Class="RimWorld.StorytellerCompProperties_Triggered">
        <incident>StrangerInBlackJoin</incident>
        <delayTicks>180</delayTicks>
      </li>

    </comps>
  </StorytellerDef>

</Defs>
