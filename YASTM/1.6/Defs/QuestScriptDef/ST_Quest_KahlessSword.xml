<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <QuestScriptDef>
    <defName>STQ_Quest_KahlessSword</defName>
    <label>Quest: The Sword of Kahless</label>

    <description>Tales speak of the legendary Sword of Kahless...</description>

    <rootSelectionWeight>0</rootSelectionWeight>
    <rootMinPoints>0</rootMinPoints>
    <autoAccept>false</autoAccept>

    <expireDaysRange>
      <min>10</min>
      <max>20</max>
    </expireDaysRange>

    <questNameRules>
      <rulesStrings>
        <li>questName->[sword_name] of Kahless</li>
        <li>sword_name->The Sword</li>
        <li>sword_name->Blade</li>
      </rulesStrings>
    </questNameRules>

    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->
          Tales speak of the legendary Sword of Kahless...
        </li>
      </rulesStrings>
    </questDescriptionRules>

    <root Class="QuestNode_Sequence">
      <nodes>

        <li Class="QuestNode_Letter">
          <inSignal>QuestAccepted</inSignal>
          <label>The Sword of Kahless</label>
          <text>A Klingon talespinner has given you a lead...</text>
          <letterDef>PositiveEvent</letterDef>
        </li>
        
        <li Class="YASTM.Source.Quest.QuestNode_KahlessGenerateSite">
           </li>

        <li Class="YASTM.Source.Quest.QuestNode_EndOnSignal">
          <inSignal>QuestAccepted</inSignal>
          <outcome>Success</outcome>
        </li>

        <li Class="YASTM.Source.Quest.QuestNode_SpawnRewardsOnSignal">
            <inSignal>QuestAccepted</inSignal>
            <dropPod>true</dropPod>
            <rewards>
             <li><thingDef>ST_SwordOfKahless</thingDef><count>1</count></li>
            </rewards>
        </li>

      </nodes>
    </root>
  </QuestScriptDef>
</Defs>