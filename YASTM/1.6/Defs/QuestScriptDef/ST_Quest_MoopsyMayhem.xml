<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <QuestScriptDef>
    <defName>ST_Quest_MoopsyContract</defName>
    <rootSelectionWeight>0.6</rootSelectionWeight>
    <expireDaysRange>4~8</expireDaysRange>  
    <rootMinPoints>0</rootMinPoints>
    <autoAccept>false</autoAccept>
    
    <questNameRules>
      <rulesStrings>
        <li>questName->The Moopsy Mayhem</li>
        <li>questName->DaiMon's Pet</li>
        <li>questName->Biological Asset</li>
        <li>questName->A Deal with the Devil</li>
      </rulesStrings>
    </questNameRules>
    
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->A Ferengi DaiMon named Grab is offering a lucrative contract. He needs a temporary holding facility for a highly dangerous biological asset: a Moopsy.\n\nIf you accept, the creature will drop into your colony. Keep it alive for exactly 15 days.\n\nWARNING: The Moopsy feeds on bones. If it dies, mercenaries will attack.\n\nReward: 5000 Silver.</li>
      </rulesStrings>
    </questDescriptionRules>
    
    <root Class="QuestNode_Sequence">
      <nodes>
        
        <li Class="QuestNode_GetMap" />

        <li Class="QuestNode_GetFaction">
          <allowEnemy>true</allowEnemy>
          <storeAs>enemyFaction</storeAs>
        </li>

        <li Class="QuestNode_GeneratePawn">
          <kindDef>ST_Moopsy</kindDef>
          <storeAs>moopsy</storeAs>
        </li>

        <li Class="QuestNode_AddToList">
          <name>cargoList</name>
          <value>$moopsy</value>
        </li>

        <li Class="QuestNode_Sequence">
          <inSignal>Quest.Accept</inSignal>
          <nodes>
            
            <li Class="QuestNode_Letter">
              <label>Asset Arrived</label>
              <text>The Moopsy is inbound! Watch the skies.</text>
            </li>

            <li Class="QuestNode_SetFaction">
              <things>$cargoList</things>
              <faction>OfPlayer</faction>
            </li>

            <li Class="QuestNode_DropPods">
              <contents>$cargoList</contents>
            </li>

            <li Class="QuestNode_Delay">
              <delayTicks>900000</delayTicks> 
              <isQuestTimeout>false</isQuestTimeout>
              <node Class="QuestNode_Sequence">
                <nodes>
                  
                  <li Class="QuestNode_GenerateThing">
                    <def>Silver</def>
                    <amount>5000</amount>
                    <storeAs>rewardSilver</storeAs>
                  </li>
                  
                  <li Class="QuestNode_DropPods">
                    <contents>$rewardSilver</contents>
                  </li>
                  
                  <li Class="QuestNode_Letter">
                    <label>Contract Fulfilled</label>
                    <text>DaiMon Grab has dropped 5000 Silver. Enjoy your new pet.</text>
                    <letterDef>PositiveEvent</letterDef>
                  </li>
                  
                  <li Class="QuestNode_End">
                    <outcome>Success</outcome>
                  </li>
                  
                </nodes>
              </node>
            </li>

          </nodes>
        </li>

        <li Class="QuestNode_Signal">
          <inSignal>moopsy.Destroyed</inSignal> 
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label>Contract Failed!</label>
                <text>The Moopsy is dead! Mercenaries are attacking!</text>
                <letterDef>ThreatBig</letterDef>
              </li>
              <li Class="QuestNode_Set">
                <name>incidentPoints</name>
                <value>1500</value>
              </li>
              <li Class="QuestNode_CreateIncidents">
                <incidentDef>RaidEnemy</incidentDef>
                <points>$incidentPoints</points>
                <faction>$enemyFaction</faction>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
              </li>
            </nodes>
          </node>
        </li>

      </nodes>
    </root>
  </QuestScriptDef>

</Defs>