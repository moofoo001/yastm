<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- UNITED FEDERATION OF PLANETS -->
  <IdeoPresetDef>
    <defName>ST_Ideo_UFP</defName>
    <label>Federation Doctrine</label>
    <description>A progressive, exploratory philosophy rooted in diplomacy, science, and cooperation.</description>
    <iconPath>UI/Icons/IdeoIcons/Federation_Doctrine</iconPath>
    <memes>
      <li>VME_Egalitarian</li>
      <li>ST_Meme_Starfleet</li>
      <li>Individualist</li>
      <li>HAR_Xenophilia</li>
    </memes>
    <precepts>
      <li>ST_Venerate_Tribbles</li>
      <li>ST_Venerate_Sehlat</li>
    </precepts>
  </IdeoPresetDef>

  <!-- KLINGON EMPIRE -->
  <IdeoPresetDef>
    <defName>ST_Ideo_KlingonHonor</defName>
    <label>Klingon Honor Code</label>
    <description>A warrior-centric philosophy emphasizing honor, combat prowess, and loyalty to the Empire.</description>
    <iconPath>UI/Icons/IdeoIcons/KlingonHonor</iconPath>
    <memes>
      <li>Supremacist</li>
      <li>VME_Bushido</li>
      <li>Raider</li>
    </memes>
    <precepts>
      <li>ST_Venerate_Targ</li>
    </precepts>
  </IdeoPresetDef>

  <!-- ROMULAN STAR EMPIRE -->
  <IdeoPresetDef>
    <defName>ST_Ideo_RomulanCommand</defName>
    <label>Romulan Command Philosophy</label>
    <description>A secretive and strategic doctrine focused on survival, intelligence and state supremacy.</description>
    <iconPath>UI/Icons/IdeoIcons/RomulanCommand</iconPath>
    <memes>
      <li>Structure_TheistAbstract</li>
      <li>VME_Structure_Authoritarianism</li>
      <li>Collectivist</li>
      <li>VFEA_Isolationist</li>
      <li>VME_Anonymity</li>
    </memes>
  </IdeoPresetDef>

  <!-- FERENGI ALLIANCE -->
  <IdeoPresetDef>
    <defName>ST_Ideo_FerengiCommerce</defName>
    <label>Ferengi Commerce Code</label>
    <description>A profit-driven philosophy centered on trade, wealth accumulation and personal gain.</description>
    <iconPath>UI/Icons/IdeoIcons/FerengiCommerce</iconPath>
    <memes>
      <li>VME_Trader</li>
      <li>VME_Structure_Corporate</li>
      <li>Loyalist</li>
      <li>Structure_Ideological</li>
    </memes>
  </IdeoPresetDef>

</Defs>
