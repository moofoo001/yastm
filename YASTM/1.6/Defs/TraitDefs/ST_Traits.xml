<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Command Training -->
  <TraitDef>
    <defName>ST_Trait_CommandTraining</defName>
    <label>command training</label>
    <description>Formal leadership training: calm authority and efficient coordination.</description>
    <commonality>0.5</commonality>
    <degreeDatas>
      <li>
        <label>command training</label>
        <description>Leadership training enhances social presence and work efficiency.</description>
        <degree>0</degree>
        <statOffsets>
          <SocialImpact>0.05</SocialImpact>
          <NegotiationAbility>0.05</NegotiationAbility>
          <WorkSpeedGlobal>0.03</WorkSpeedGlobal> 
          <MentalBreakThreshold>-0.02</MentalBreakThreshold>
        </statOffsets>
      </li>
    </degreeDatas>
  </TraitDef>

  <!-- Security Officer -->
    <TraitDef>
        <defName>ST_Trait_SecurityOfficer</defName>
        <label>security officer</label>
        <description>Trained for tactical response and overwatch procedures.</description>
        <commonality>0.7</commonality>
        <degreeDatas>
          <li>
            <label>security officer</label>
            <description>Specialized training in combat tactics and threat assessment.</description>
          </li>
        </degreeDatas>
        
        <modExtensions>
          <li Class="YASTM.ST_GrantAbilitiesExtension">
            <abilities>
              <li>ST_Ability_TacticalAnalysis</li>
            </abilities>
          </li>
        </modExtensions>
      </TraitDef>

<!-- Pilot (cadet) -->
<TraitDef>
  <defName>Pilot_Cadet</defName>
  <label>pilot (cadet)</label>
  <description>{PAWN_nameDef} trained the basics of low-grav and craft maneuvering.</description>
  <commonality>0.12</commonality>
  <degreeDatas>
    <li>
      <label>Pilot Cadet</label>
      <description>Basic piloting discipline and stress handling.</description>
      <degree>0</degree>
      <statOffsets>
        <PilotingAbility MayRequire="Ludeon.RimWorld.Odyssey">0.15</PilotingAbility>
        <MentalBreakThreshold>-0.03</MentalBreakThreshold>
      </statOffsets>
    </li>
  </degreeDatas>
  <conflictingTraits>
    <li>Wimp</li>
    <li>Undergrounder</li>
  </conflictingTraits>
</TraitDef>

<!-- Pilot (officer) -->
<TraitDef>
  <defName>Pilot_Officer</defName>
  <label>pilot (officer)</label>
  <description>{PAWN_nameDef} is a trained starship pilot.</description>
  <commonality>0.07</commonality>
  <degreeDatas>
    <li>
      <label>Pilot</label>
      <description>Advanced flight under pressure.</description>
      <degree>0</degree>
      <statOffsets>
        <PilotingAbility MayRequire="Ludeon.RimWorld.Odyssey">0.25</PilotingAbility>
        <MentalBreakThreshold>-0.05</MentalBreakThreshold>
      </statOffsets>
    </li>
  </degreeDatas>
  <conflictingTraits>
    <li>Wimp</li>
    <li>Undergrounder</li>
  </conflictingTraits>
</TraitDef>

<!-- Pilot (ace) -->
<TraitDef>
  <defName>Pilot_Ace</defName>
  <label>Pilot (ace)</label>
  <description>{PAWN_nameDef} has nerves of steel and unmatched flight instincts.</description>
  <commonality>0.03</commonality>
  <degreeDatas>
    <li>
      <label>ace</label>
      <description>Elite maneuvering, rock-solid nerves.</description>
      <degree>0</degree>
      <statOffsets>
        <PilotingAbility MayRequire="Ludeon.RimWorld.Odyssey">0.40</PilotingAbility>
        <MentalBreakThreshold>-0.08</MentalBreakThreshold>
      </statOffsets>
    </li>
  </degreeDatas>
  <conflictingTraits>
    <li>Wimp</li>
    <li>Undergrounder</li>
  </conflictingTraits>
</TraitDef>

  <!-- Starfleet Training -->
  <TraitDef>
    <defName>ST_Trait_StarfleetTraining</defName>
    <label>Starfleet training</label>
    <description>Formal Starfleet training: calm under pressure, solid fundamentals and a knack for learning.</description>
    <commonality>1.2</commonality>
    <degreeDatas>
      <li>
        <label>Starfleet training</label>
        <description>Thorough Starfleet training helps in stressful situations and accelerates learning.</description>
        <degree>0</degree>
        <statOffsets>
          <GlobalLearningFactor>0.03</GlobalLearningFactor>
          <MentalBreakThreshold>-0.02</MentalBreakThreshold>
        </statOffsets>
        <skillGains>
          <Shooting>2</Shooting>
          <Medicine>1</Medicine>
        </skillGains>
      </li>
    </degreeDatas>
  </TraitDef>

  <!-- IDIC-Mindset -->
  <TraitDef>
    <defName>ST_Trait_IDICMindset</defName>
    <label>IDIC mindset</label>
    <description>Logic and the pursuit of understanding: faster research, slightly stiffer social presence.</description>
    <commonality>0.6</commonality>
    <degreeDatas>
      <li>
        <label>IDIC mindset</label>
        <description>An open yet logical mindset that favors knowledge and reason.</description>
        <degree>0</degree>
        <statOffsets>
          <ResearchSpeed>0.08</ResearchSpeed>
          <SocialImpact>-0.05</SocialImpact>
        </statOffsets>
      </li>
    </degreeDatas>
  </TraitDef>

  <!-- Prime Directive Minded -->
  <TraitDef>
    <defName>ST_Trait_PrimeDirectiveMinded</defName>
    <label>prime directive-minded</label>
    <description>Committed to the Prime Directive: favors negotiation and restraint in conflict.</description>
    <commonality>0.8</commonality>
    <degreeDatas>
      <li>
        <label>prime directive-minded</label>
        <description>Prioritizes non-interference and diplomacy.</description>
        <degree>0</degree>
        <statOffsets>
          <NegotiationAbility>0.08</NegotiationAbility>
          <MeleeHitChance>-0.02</MeleeHitChance>
        </statOffsets>
      </li>
    </degreeDatas>
  </TraitDef>

  <!-- Rules of Acquisition -->
  <TraitDef>
    <defName>ST_RulesOfAcquisition</defName>
    <label>rules of acquisition</label>
    <description>Lives by profit. Sees margins where others see dust.</description>
    <degreeDatas>
      <li>
        <label>ferengi trader</label>
        <description>Knows every margin and every loophole.</description>
        <degree>0</degree>
        <statOffsets>
          <TradePriceImprovement>0.10</TradePriceImprovement>
          <SocialImpact>0.05</SocialImpact>
        </statOffsets>
        <commonality>1.8</commonality>
      </li>
    </degreeDatas>
    <conflictingTraits>
       <li>Ascetic</li> 
    </conflictingTraits>
  </TraitDef>

  <!-- Brak'lul Trait -->
  <TraitDef>
   <defName>ST_BraklUl</defName>
    <label>brak'lul</label>
    <description>Redundant organs and a warrior’s tolerance for pain.</description>
    <degreeDatas>
      <li>
        <label>hardened physiology</label>
        <description>Possesses redundant organs and a high pain tolerance.</description>
        <degree>0</degree>
        <statOffsets>
          <PainShockThreshold>0.08</PainShockThreshold>
          <ImmunityGainSpeed>0.05</ImmunityGainSpeed>
          <MeleeHitChance>0.03</MeleeHitChance>
        </statOffsets>
        <commonality>1.2</commonality>
      </li>
    </degreeDatas>
    <conflictingTraits>
      <li>Wimp</li>
    </conflictingTraits>
  </TraitDef>

  <TraitDef>
    <defName>ST_TransporterEngineer</defName>
    <label>Transporter Chief</label>
    <commonality>0.0</commonality>
    <degreeDatas>
      <li>
      <description>This person has completed the advanced subspace geometry protocols. They are qualified to operate transporter buffers safely.</description>
        <statOffsets>
          <GeneralLaborSpeed>0.10</GeneralLaborSpeed>
          <ResearchSpeed>0.05</ResearchSpeed>
        </statOffsets>
      </li>
    </degreeDatas>
  </TraitDef>

  <TraitDef>
      <defName>ST_Training_CommsOfficer</defName>
      <label>comms officer training</label>
      <description>Has completed the specialized Holodeck simulation for communication arrays.</description>
      <degreeDatas>
        <li>
          <label>comms officer training</label>
          <description>Certified to operate high-level communication equipment.</description>
        </li>
      </degreeDatas>
      <commonality>0.0</commonality>
    </TraitDef>

    <TraitDef>
    <defName>ST_Training_Science</defName>
    <label>science certification</label>
    <description>Has completed the Starfleet Science Officer training via Holodeck.</description>
    <degreeDatas>
      <li>
        <label>science officer</label>
        <description>Certified to operate advanced sensor arrays and lab equipment.</description>
      </li>
    </degreeDatas>
    <commonality>0.0</commonality>
  </TraitDef>

  <TraitDef>
    <defName>ST_Training_Security</defName>
    <label>security certification</label>
    <description>Has completed the Starfleet Tactical/Security training via Holodeck.</description>
    <degreeDatas>
      <li>
        <label>security officer</label>
        <description>Certified to operate weapon systems and tactical stations.</description>
      </li>
    </degreeDatas>
    <commonality>0.0</commonality>
  </TraitDef>
  
</Defs>