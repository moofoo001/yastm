<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Lt. (jg) – leichter Command-Lead -->
  <PawnKindDef ParentName="FederationBasePawn">
    <defName>FederationPawn_Command_LtJG</defName>
    <label>Starfleet lieutenant (jg)</label>

    <minGenerationAge>24</minGenerationAge>
    <maxGenerationAge>34</maxGenerationAge>

    <backstoryFiltersOverride>
      <li>
        <categoriesChildhood>
          <li>Starfleet_Operations</li>
          <li>Starfleet_Engineering</li>
          <li>Starfleet_Security</li>
          <li>Starfleet_Science</li>
          <li>Starfleet_Medical</li>
        </categoriesChildhood>
        <categoriesAdulthood>
          <li>Starfleet_Operations</li>
        </categoriesAdulthood>
      </li>
    </backstoryFiltersOverride>

    <skills>
      <li>
        <skill>Social</skill><range>6~10</range>
        <skill>Shooting</skill><range>5~9</range>
        <skill>Melee</skill><range>3~6</range>
        <skill>Intellectual</skill><range>4~7</range>
        <skill>Construction</skill><range>3~6</range>
      </li>
    </skills>

    <forcedTraits>
      <Pilot_Cadet>0</Pilot_Cadet>
      <ST_Rank_LieutenantJG>0</ST_Rank_LieutenantJG>
    </forcedTraits>

    <weaponTags><li>ST_Phaser_T2</li></weaponTags>
    <weaponMoney>750~1200</weaponMoney>

    <apparelRequired>
      <li>ST_Apparel_StarfleetTunic</li>
      <li>ST_Apparel_StarfleetPants</li>
      <li>Fed_Combadge_TNG</li>
    </apparelRequired>
    <apparelTags><li>StarfleetUniform</li></apparelTags>
    <apparelMoney>300~700</apparelMoney>

    <itemQuality>Good</itemQuality>
    <gearHealthRange>0.8~1.0</gearHealthRange>
    <combatPower>45</combatPower>

    <inventoryOptions>
      <skipChance>0.8</skipChance>
      <subOptionsChooseOne>
        <li><thingDef>MedicineIndustrial</thingDef><countRange>4~6</countRange></li>
        <li><thingDef>Silver</thingDef><countRange>90~140</countRange></li>
      </subOptionsChooseOne>
    </inventoryOptions>
  </PawnKindDef>

