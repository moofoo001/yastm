<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <BackstoryDef>
    <defName>ST_BS_JemHadar_VatGrown</defName>
    <title>vat-grown soldier</title>
    <titleShort>vat-grown</titleShort>
    <baseDesc>Grown in a birthing pod, reaching maturity in a matter of days. Implanted with genetic loyalty to the Founders and a dependency on Ketracel White, he knows only combat and obedience.</baseDesc>
    <slot>Childhood</slot>
    <shuffleable>true</shuffleable>
    <spawnCategories>
      <li>ST_Dominion_JemHadar</li>
    </spawnCategories>
    <workDisables>
      <li>Artistic</li>
      <li>Caring</li>
      <li>PlantWork</li>
      <li>Animals</li>
      <li>Social</li>
    </workDisables>
    <skillGains>
      <Melee>4</Melee>
      <Shooting>4</Shooting>
    </skillGains>
    <forcedTraits>
      <Psychopath>0</Psychopath> </forcedTraits>
    <disallowedTraits>
      <Wimp>0</Wimp>
      <Kind>0</Kind>
    </disallowedTraits>
  </BackstoryDef>

  <BackstoryDef>
    <defName>ST_BS_JemHadar_Trooper</defName>
    <title>Dominion trooper</title>
    <titleShort>trooper</titleShort>
    <baseDesc>Has served the Founders in numerous campaigns across the Gamma Quadrant. Victory is life.</baseDesc>
    <slot>Adulthood</slot>
    <shuffleable>true</shuffleable>
    <spawnCategories>
      <li>ST_Dominion_JemHadar</li>
    </spawnCategories>
    <workDisables>
      <li>Intellectual</li>
    </workDisables>
    <skillGains>
      <Melee>4</Melee>
      <Shooting>4</Shooting>
      <Construction>2</Construction>
    </skillGains>
  </BackstoryDef>
  
  <BackstoryDef>
    <defName>ST_BS_JemHadar_First</defName>
    <title>Jem'Hadar First</title>
    <titleShort>First</titleShort>
    <baseDesc>Having survived longer than most, he was promoted to 'First'. He leads his unit with brutal efficiency.</baseDesc>
    <slot>Adulthood</slot>
    <shuffleable>true</shuffleable>
    <spawnCategories>
      <li>ST_Dominion_JemHadar</li>
    </spawnCategories>
    <skillGains>
      <Melee>6</Melee>
      <Shooting>6</Shooting>
      <Social>2</Social> </skillGains>
    <forcedTraits>
      <Abrasive>0</Abrasive>
    </forcedTraits>
  </BackstoryDef>


  <BackstoryDef>
    <defName>ST_BS_Vorta_Clone</defName>
    <title>Vorta clone</title>
    <titleShort>clone</titleShort>
    <baseDesc>Decanted from a cloning facility, carrying the memories and instincts of predecessors. Genetically engineered to serve the Founders as administrators.</baseDesc>
    <slot>Childhood</slot>
    <shuffleable>true</shuffleable>
    <spawnCategories>
      <li>ST_Dominion_Vorta</li>
    </spawnCategories>
    <workDisables>
      <li>ManualDumb</li>
      <li>ManualSkilled</li>
    </workDisables>
    <skillGains>
      <Social>5</Social>
      <Intellectual>3</Intellectual>
    </skillGains>
    <disallowedTraits>
      <Brawler>0</Brawler> </disallowedTraits>
  </BackstoryDef>

  <BackstoryDef>
    <defName>ST_BS_Vorta_Supervisor</defName>
    <title>field supervisor</title>
    <titleShort>supervisor</titleShort>
    <baseDesc>Assigned to oversee a Jem'Hadar unit, ensuring their loyalty and dispensing Ketracel White.</baseDesc>
    <slot>Adulthood</slot>
    <shuffleable>true</shuffleable>
