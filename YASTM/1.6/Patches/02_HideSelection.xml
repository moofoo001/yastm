<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Allen Precepts, die das Pattern LeaderSpeech, RoleChange oder DanceParty und Execution verwenden,
       fügen wir das Dummy-Meme hinzu.  Die zwei Operationen sorgen dafür, dass
       der Knoten existiert bzw. ergänzt wird. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/PreceptDef[ritualPatternBase="LeaderSpeech" or ritualPatternBase="RoleChange" or ritualPatternBase="DanceParty"  or ritualPatternBase="Execution"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- wenn requiredMemes vorhanden: Liste erweitern -->
        <li Class="PatchOperationAdd">
          <xpath>Defs/PreceptDef[ritualPatternBase="LeaderSpeech" or ritualPatternBase="RoleChange" or ritualPatternBase="DanceParty" or ritualPatternBase="Execution"]/requiredMemes</xpath>
          <value><li>ST_Meme_HiddenVanilla</li></value>
        </li>
        <!-- wenn requiredMemes noch gar nicht existiert: neu erzeugen -->
        <li Class="PatchOperationAdd">
          <xpath>Defs/PreceptDef[ritualPatternBase="LeaderSpeech" or ritualPatternBase="RoleChange" or ritualPatternBase="DanceParty" or ritualPatternBase="Execution"][not(requiredMemes)]</xpath>
          <value>
            <requiredMemes>
              <li>ST_Meme_HiddenVanilla</li>
            </requiredMemes>
          </value>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>




