<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Add ST_PilotConsole as a valid facility for the grav engine -->
  <Operation Class="PatchOperationAdd">
    <xpath>
      Defs/ThingDef[defName="GravEngine"]
        /comps/li[@Class="CompProperties_AffectedByFacilities"]
        /linkableFacilities
    </xpath>
    <value>
      <li>ST_PilotConsole</li>
    </value>
  </Operation>


</Patch>
