<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/IdeoDef[defName="ST_Ideo_UFP"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationAdd">
      <xpath>Defs/IdeoDef[defName="ST_Ideo_UFP"]/precepts</xpath>
      <value>
        <li>ST_Venerate_Tribbles</li>
        <li>ST_Venerate_Sehlat</li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/IdeoDef[defName="ST_Ideo_KlingonHonor"]</xpath>
    <success>Always</success>
    <match Class="PatchOperationAdd">
      <xpath>Defs/IdeoDef[defName="ST_Ideo_KlingonHonor"]/precepts</xpath>
      <value>
        <li>ST_Venerate_Targ</li>
      </value>
    </match>
  </Operation>
</Patch>



