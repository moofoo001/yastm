<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Target -->
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>YASTM</AssemblyName>
    <RootNamespace>StarTrekFactions</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>

    <!-- Clean output layout under Source\ -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)\bin\$(MSBuildProjectName)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>$(MSBuildProjectDirectory)\obj\$(MSBuildProjectName)\</IntermediateOutputPath>

    <!-- Build quality -->
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>1591;1701;1702</NoWarn>

    <!-- Do not copy dependency DLLs next to our mod DLL -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Configuration-specific tweaks -->
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- NuGet refs (no hard-coded game paths) -->
  <ItemGroup>
    <!-- Provides Verse, Assembly-CSharp, RimWorld, Unity refs -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="*" PrivateAssets="all" />
    <!-- Ensures .NET 4.7.2 reference assemblies are present -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="*" PrivateAssets="all" />
    <!-- Harmony (compile-time); game ships its own at runtime -->
    <PackageReference Include="Lib.Harmony" Version="2.2.2" PrivateAssets="all" />
  </ItemGroup>

  <!-- Post-build: drop the DLL (and PDB if present) into the mod -->
  <Target Name="PostBuild" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\1.6\Assemblies\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\1.6\Assemblies\" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb"
          Condition="Exists('$(TargetDir)$(AssemblyName).pdb')"
          DestinationFolder="$(MSBuildProjectDirectory)\..\1.6\Assemblies\" />
  </Target>

</Project>
