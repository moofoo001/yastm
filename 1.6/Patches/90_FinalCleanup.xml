<?xml version="1.0" encoding="UTF-8"?>
<Patch>

  <!-- Altlastige Role-Apparel-Requirements entfernen, falls fehlerhafte Felder -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/PreceptDef[starts-with(defName,"IdeoRole_Federation")]/roleApparelRequirements</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/PreceptDef[starts-with(defName,"IdeoRole_Federation")]/roleApparelRequirements</xpath>
    </match>
  </Operation>


