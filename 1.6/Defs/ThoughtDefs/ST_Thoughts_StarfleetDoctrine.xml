<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- After a team briefing or cross-disciplinary success -->
  <ThoughtDef>
    <defName>ST_Thought_IDIC_Encouraged</defName>
    <label>diversity encouraged</label>
    <description>After a team briefing or cross-disciplinary success</description>
    <durationDays>0.8</durationDays>
    <stackLimit>1</stackLimit>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>diversity encouraged</label>
        <baseMoodEffect>2</baseMoodEffect>
        <description>Collaboration across different perspectives renewed my motivation.</description>
      </li>
    </stages>
    <icon>UI/Icons/Starfleet/Thought_IDIC</icon>
  </ThoughtDef>

  <!-- After resolving a situation without lethal force / minimal interference -->
  <ThoughtDef>
    <defName>ST_Thought_NonInterference_Kept</defName>
    <label>restraint maintained</label>
    <description>After resolving a situation without lethal force / minimal interference</description>
    <durationDays>0.8</durationDays>
    <stackLimit>1</stackLimit>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>restraint maintained</label>
        <baseMoodEffect>3</baseMoodEffect>
        <description>We chose a careful path that respected local culture and life.</description>
      </li>
    </stages>
    <icon>UI/Icons/Starfleet/Thought_NonInterference</icon>
  </ThoughtDef>

  <!-- Promotion ceremony outcome -->
  <ThoughtDef>
    <defName>ST_Thought_Promotion_Ceremony</defName>
    <label>recognized promotion</label>
    <description>Promotion ceremony outcome</description>
    <durationDays>2.0</durationDays>
    <stackLimit>1</stackLimit>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>recognized promotion</label>
        <baseMoodEffect>4</baseMoodEffect>
        <description>The formal recognition of rank strengthens my sense of duty and belonging.</description>
      </li>
    </stages>
    <icon>UI/Icons/Starfleet/Thought_Promotion</icon>
  </ThoughtDef>

<!-- Honoree -->
  <ThoughtDef>
    <defName>ST_PromotionCeremony_Honoree_Best</defName>
    <label>celebrated promotion (unforgettable)</label>
    <description>A flawless ceremony marked this promotion.</description>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <thoughtClass>Thought_Memory</thoughtClass>
    <stages>
      <li>
      <label>celebrated promotion</label>
      <baseMoodEffect>12</baseMoodEffect>
      <description>A flawless ceremony marked this promotion.</description>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>ST_PromotionCeremony_Honoree_Good</defName>
    <label>celebrated promotion</label>
    <description>The ceremony honored this promotion.</description>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <thoughtClass>Thought_Memory</thoughtClass>
    <stages>
      <li>
      <label>celebrated promotion</label>
      <baseMoodEffect>7</baseMoodEffect>
      <description>The ceremony honored this promotion.</description>
      </li>
    </stages>
  </ThoughtDef>
  <ThoughtDef>
    <defName>ST_PromotionCeremony_Honoree_Bad</defName>
    <label>botched promotion ceremony</label>
    <description>The ceremony fell short of expectations.</description>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <thoughtClass>Thought_Memory</thoughtClass>
    <stages>
      <li>
      <label>botched promotion ceremony</label>
      <baseMoodEffect>-4</baseMoodEffect>
      <description>The ceremony fell short of expectations.</description>
      </li>
    </stages>
  </ThoughtDef>

