<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- BRIEFING: based LeaderSpeech -->
<PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
  <defName>Precept_Ritual_Starfleet_Briefing</defName>
  <label>briefing</label>
  <iconPath>UI/Icons/Starfleet/Ritual_Briefing</iconPath>
  <description>A short, structured team briefing to synchronize plans.</description>
  <issue>Ritual</issue>
  <preceptClass>Precept_Ritual</preceptClass>
  <impact>Low</impact>
  <ritualPatternBase>LeaderSpeech</ritualPatternBase>
  <allowDuplicates>false</allowDuplicates>
  <countsTowardsPreceptLimit>true</countsTowardsPreceptLimit>
  <displayOrderInIssue>4099</displayOrderInIssue>
  <requiredMemes><li>ST_Meme_Starfleet</li></requiredMemes>
</PreceptDef>


  <!-- PROMOTION: based on RoleChange -->
<PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
  <defName>Precept_Ritual_Starfleet_Promotion</defName>
  <label>promotion ceremony</label>
  <iconPath>UI/Icons/Starfleet/Ritual_Promotion</iconPath>
  <description>A formal Starfleet promotion ceremony acknowledging exemplary service.</description>
  <issue>Ritual</issue>
  <preceptClass>Precept_Ritual</preceptClass>
  <impact>Low</impact>
  <ritualPatternBase>RoleChange</ritualPatternBase>
  <allowDuplicates>false</allowDuplicates>
  <countsTowardsPreceptLimit>true</countsTowardsPreceptLimit>
  <displayOrderInIssue>4100</displayOrderInIssue>
  <requiredMemes><li>ST_Meme_Starfleet</li></requiredMemes>
</PreceptDef>

  <PreceptDef MayRequire="Ludeon.RimWorld.Ideology">
