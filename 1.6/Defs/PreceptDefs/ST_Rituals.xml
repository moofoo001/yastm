    <iconPath>UI/Icons/Starfleet/Ritual_ShoreLeave</iconPath>
    <description>Time set aside for crew to relax and decompress together.</description>

    <issue>Ritual</issue>
    <preceptClass>Precept_Ritual</preceptClass>
