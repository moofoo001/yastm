<Defs>

  <!-- melee base -->
  <ThingDef Name="ST_MeleeBase" ParentName="BaseMeleeWeapon" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <useHitPoints>true</useHitPoints>
    <statBases>
      <MarketValue>240</MarketValue>
    </statBases>
    <costStuffCount>60</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
 
    </stuffCategories>
    <recipeMaker>
      <workAmount>8000</workAmount>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>ElectricSmithy</li>
      </recipeUsers>
    </recipeMaker>
    <soundInteract>Metal_Drop</soundInteract>
  </ThingDef>

<!-- ===== FEDERATION: Survival Knife (light, stabby) ===== -->
  <ThingDef ParentName="ST_MeleeBase">
    <defName>UFP_Weapon_SurvivalKnife</defName>
    <label>survival knife</label>
    <graphicData>
      <texPath>Things/Item/Equipment/Federation_weapons/UFPS_SurvivalKnife</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.6</drawSize>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <weaponTags>
      <li>FederationMelee_SurvivalKnife</li>
      <li>FederationMelee</li>
    </weaponTags>
    <statBases>
      <Mass>0.6</Mass>
      <MarketValue>240</MarketValue>
    </statBases>
    <recipeMaker>
        <workAmount>7000</workAmount>
        <skillRequirements><Crafting>6</Crafting></skillRequirements>
        <recipeUsers><li>ElectricSmithy</li></recipeUsers>
        <researchPrerequisite>ST_UFP_Melee</researchPrerequisite>
    </recipeMaker>
    <costList>
      <Plasteel>2</Plasteel>
      <Steel>12</Steel>
      <Gold>10</Gold>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <tools>
      <li>
        <label>point</label>
        <capacities><li>Stab</li></capacities>
        <power>9</power>
        <cooldownTime>1.50</cooldownTime>
        <armorPenetration>0.20</armorPenetration>
        <chanceFactor>0.8</chanceFactor>
      </li>
      <li>
        <label>edge</label>
        <capacities><li>Cut</li></capacities>
        <power>5</power>
        <cooldownTime>1.50</cooldownTime>
        <armorPenetration>0.14</armorPenetration>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
  </ThingDef>

  <!-- ===== FEDERATION: Stun Baton (blunt, control tool) ===== -->
  <ThingDef ParentName="ST_MeleeBase">
    <defName>UFP_Weapon_StunBaton</defName>
    <label>stun baton</label>
    <graphicData>
      <texPath>Things/Item/Equipment/Federation_weapons/UFPS_StunBaton</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.7</drawSize>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <weaponTags>
      <li>FederationMelee_StunBaton</li>
      <li>FederationMelee</li>
    </weaponTags>
    <statBases>
      <Mass>1.6</Mass>
      <MarketValue>300</MarketValue>
    </statBases>
    <recipeMaker>
    <workAmount>7000</workAmount>
        <skillRequirements><Crafting>6</Crafting></skillRequirements>
        <recipeUsers><li>ElectricSmithy</li></recipeUsers>
        <researchPrerequisite>ST_UFP_Melee</researchPrerequisite>
    </recipeMaker>
    <costList>
      <Plasteel>3</Plasteel>
      <Steel>18</Steel>
      <Gold>15</Gold>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <tools>
      <li>
        <label>head</label>
        <capacities><li>Blunt</li></capacities>
        <power>11</power>
        <cooldownTime>1.55</cooldownTime>
        <armorPenetration>0.20</armorPenetration>
        <chanceFactor>0.8</chanceFactor>
      </li>
    </tools>
    <comps>
        <li Class="ST.PhaseWeapons.CompProperties_StunOnMelee">
            <stunTicks>300</stunTicks>         
            <stunOnlyFlesh>true</stunOnlyFlesh> 
            <chance>1.0</chance>               
        </li>
    </comps>
  </ThingDef>

