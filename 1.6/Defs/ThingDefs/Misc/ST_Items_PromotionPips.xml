 <!-- Ein Template (Gold + Stahl), pro Pip ein Rezept -->
  <RecipeDef>
    <defName>Make_ST_PromotionPip_Ensign</defName>
    <label>make promotion pip (ensign)</label>
    <jobString>crafting a promotion pip (ensign).</jobString>
    <workAmount>800</workAmount>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter><thingDefs><li>Gold</li></thingDefs></filter>
        <count>5</count>
      </li>
      <li>
        <filter><thingDefs><li>Steel</li></thingDefs></filter>
        <count>10</count>
      </li>
    </ingredients>
    <products>
      <ST_PromotionPip_Ensign>1</ST_PromotionPip_Ensign>
    </products>
    <recipeUsers>
      <li>ElectricSmithy</li>
      <li>TableMachining</li>
    </recipeUsers>
  </RecipeDef>

