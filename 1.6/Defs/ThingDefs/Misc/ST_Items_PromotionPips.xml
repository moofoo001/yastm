<Defs>

  <!-- rank system test promo pip  -->

  <ThingDef ParentName="ResourceBase">
    <defName>ST_PromotionPip_Ensign</defName>
    <label>promotion pip (ensign)</label>
    <description>Commission pip authorizing promotion to Ensign.</description>
    <category>Item</category>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <graphicData>
        <texPath>Things/Item/Accessory/pip/pip_ensign</texPath>
        <graphicClass>Graphic_Single</graphicClass>
     </graphicData>
    <tradeability>Sellable</tradeability>
    <useHitPoints>false</useHitPoints>
    <statBases>
        <Mass>0.03</Mass>
    </statBases>
    <comps>
      <li Class="CompProperties_Usable">
        <useLabel>Promote to Ensign</useLabel>
        <useDuration>60</useDuration>
          <useJob>UseItem</useJob>    
      </li>
      <li Class="YASTM.CompProperties_PromoteToRank">
        <targetRankTrait>ST_Rank_Ensign</targetRankTrait>
      </li>
    </comps>
  </ThingDef>

