<Defs>

 <!-- For later usage !! -->

 
  <!-- Dilithium Crystal: seltener, wertig, stapelbar -->
  <ThingDef ParentName="ResourceBase">
    <defName>STQ_DilithiumCrystal</defName>
    <label>dilithium crystal</label>
    <description>Refined dilithium suitable for warp power regulation and high-energy experiments.</description>
    <graphicData>
      <texPath>Things/Item/Special/ST_Crate_Placeholder</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>75</stackLimit>
    <statBases>
      <MarketValue>28</MarketValue>
      <Mass>0.03</Mass>
    </statBases>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
  </ThingDef>

  <!-- Tritanium Ingots: robustes Stuff (wie „Stahl++“) -->
  <ThingDef ParentName="ResourceBase" Name="STQ_TritaniumIngotBase">
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <stuffProps>
      <categories>
        <li>Metallic</li>
      </categories>
      <statOffsets>
        <MaxHitPoints>40</MaxHitPoints>
      </statOffsets>
      <statFactors>
        <ArmorRating_Sharp>1.12</ArmorRating_Sharp>
        <Beauty>1</Beauty>
      </statFactors>
    </stuffProps>
  </ThingDef>
  <ThingDef ParentName="STQ_TritaniumIngotBase">
    <defName>STQ_TritaniumIngot</defName>
    <label>tritanium ingot</label>
    <description>Super-hard structural alloy used in starship hulls.</description>
    <graphicData>
      <texPath>Things/Item/Special/ST_Crate_Placeholder</texPath>
    </graphicData>
    <stackLimit>150</stackLimit>
    <statBases>
      <MarketValue>3.2</MarketValue>
      <Mass>0.012</Mass>
    </statBases>
  </ThingDef>

  <!-- Isolinear Chips: High-tech Komponente (leicht über Komponenten) -->
  <ThingDef ParentName="ResourceBase">
    <defName>STQ_IsolinearChip</defName>
    <label>isolinear chip</label>
    <description>Advanced data/logic substrate for Federation-grade electronics.</description>
    <graphicData>
      <texPath>TThings/Item/Special/ST_Crate_Placeholder</texPath>
    </graphicData>
    <stackLimit>50</stackLimit>
    <statBases>
      <MarketValue>18</MarketValue>
      <Mass>0.01</Mass>
    </statBases>
    <tradeTags>
      <li>HiTech</li>
    </tradeTags>
  </ThingDef>

  <!-- Subspace Transceiver Parts: selten, Richtung „Adv. Component“ -->
  <ThingDef ParentName="ResourceBase">
    <defName>STQ_SubspaceTransceiverParts</defName>
    <label>subspace transceiver parts</label>
    <description>Precision parts for long-range subspace communications.</description>
    <graphicData>
      <texPath>Things/Item/Special/ST_Crate_Placeholder</texPath>
    </graphicData>
    <stackLimit>25</stackLimit>
    <statBases>
      <MarketValue>60</MarketValue>
      <Mass>0.04</Mass>
    </statBases>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
  </ThingDef>

</Defs>
