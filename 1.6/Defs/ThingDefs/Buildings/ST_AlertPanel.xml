<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>ST_AlertPanel</defName>
    <label>alert panel</label>
    <description>Colony-wide alert controls for yellow and red alert.</description>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <fillPercent>0.1</fillPercent>
    <pathCost>0.1</pathCost>
    <graphicData>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <texPath>Things/Building/AlertPanel/AlertPanel</texPath>
      <drawSize>(3,3)</drawSize>
      <drawOffsetNorth>(0,0,-0.2)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,0.2)</drawOffsetSouth>
      <drawOffsetWest>(0.45,0,0)</drawOffsetWest>
      <drawOffsetEast>(-0.45,0,0)</drawOffsetEast>
      <damageData>
          <enabled>false</enabled>
      </damageData>
      <color>(1, .7, 0.8, 0.75)</color>   
    </graphicData>
    <uiIconPath>Things/Building/AlertPanel/AlertPanel</uiIconPath>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>700</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Mass>8</Mass>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>40</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="YASTM.CompProperties_AlertPanel">
        <redDurationTicks>18000</redDurationTicks>         <!-- ~5h -->
        <redCooldownTicks>90000</redCooldownTicks>         <!-- ~1.5 Tage -->
        <yellowDurationTicks>9000</yellowDurationTicks>    <!-- ~2.5h -->
        <yellowCooldownTicks>45000</yellowCooldownTicks>   <!-- ~0.75 Tage -->
        <playRedSirenLoop>true</playRedSirenLoop>          <!-- Sustainer während Blink -->
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius>
        <glowColor>(100,100,1,0)</glowColor>  
        <colorPickerEnabled>false</colorPickerEnabled>
        <darklightToggle>false</darklightToggle>
      </li>
    </comps>
    <designationCategory>ST_Designation</designationCategory>
    <uiOrder>2150</uiOrder>
    <researchPrerequisites>       
        <li>ST_AlertProtocols</li>
    </researchPrerequisites>
    <building>
		  <isEdifice>false</isEdifice>
		  <isAttachment>true</isAttachment>
		</building>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <placeWorkers>
			<li>Placeworker_AttachedToWall</li>
		</placeWorkers>
  </ThingDef>

</Defs>
