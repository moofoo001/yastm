<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<ThingDef ParentName="TableGatherSpotBase">
		<defName>ST_ShipTable</defName>
		<label>UFP standard table</label>
		<description>A comfortable and elegant table. For home and Starfleet Ship interioirs</description>
		<size>(2,1)</size>
		<graphicData>
			<texPath>Things/Building/Interiors/ST_table_mid</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2.0,2.0)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<uiIconScale>1</uiIconScale>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<WorkToBuild>200</WorkToBuild>
			<Mass>25</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>5</Beauty>
		</statBases>
		<costStuffCount>50</costStuffCount>
		<costList>
			<Gold>10</Gold>
		</costList>
		<building>
			<paintable>true</paintable>
		</building>
		<researchPrerequisites>
			<li>ST_UFP_Interior</li>
		</researchPrerequisites>
		<designationCategory>ST_Designation</designationCategory>
	</ThingDef>

	<ThingDef ParentName="ArtableFurnitureBase">
		<defName>ST_ShipChair</defName>
		<label>UFP standard chair</label>
		<description>A comfortable and elegant chair. For home and Starfleet Ship interioirs</description>
		<size>(1,1)</size>
		<graphicData>
			<texPath>Things/Building/Interiors/ST_chair</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1.2,1.2)</drawSize>
			<damageData>
				<rectN>(0,0,1,0.703125)</rectN>
				<rectS>(0.09375,0,0.84375,1)</rectS>
				<rectE>(0,0,0.84375,0.625)</rectE>
				<rectW>(0.15625,0,0.84375,0.625)</rectW>
			</damageData>
			<shadowData>
				<volume>(0.25, 0.28, 0.25)</volume>
			</shadowData>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<uiIconScale>1</uiIconScale>
		<statBases>
			<MaxHitPoints>20</MaxHitPoints>
			<WorkToBuild>150</WorkToBuild>
			<Mass>8</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>5</Beauty>
			<Comfort>0.70</Comfort>
		</statBases>
		<socialPropernessMatters>true</socialPropernessMatters>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>100</costStuffCount>
		<pathCost>30</pathCost>
		<fillPercent>0.35</fillPercent>
		<defaultPlacingRot>South</defaultPlacingRot>
		<!--uiIconOffset>0,0.15</uiIconOffset-->
		<building>
			<isSittable>true</isSittable>
			<paintable>true</paintable>
		</building>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<researchPrerequisites>
			<li>ST_UFP_Interior</li>
		</researchPrerequisites>
		<designationCategory>ST_Designation</designationCategory>
	</ThingDef>

  <!-- A) LCARS Wall Light -->
    <ThingDef ParentName="BuildingBase">
    <defName>ST_WallLight_LCARS</defName>
    <label>LCARS wall light</label>
    <description>Sleek wall-mounted LCARS light panel.</description>
    <thingClass>Building</thingClass>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <rotatable>true</rotatable>
    <size>(1,1)</size>
    <graphicData>
      <texPath>Things/Building/Interiors/ST_LCARS_light</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
      <drawOffsetNorth>(0,0,-0.2)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,0.2)</drawOffsetSouth>
      <drawOffsetWest>(0.45,0,0)</drawOffsetWest>
      <drawOffsetEast>(-0.45,0,0)</drawOffsetEast>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <costList>
      <Steel>15</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToBuild>300</WorkToBuild>
      <Flammability>0.2</Flammability>
      <Beauty>2</Beauty>
      <MaxHitPoints>120</MaxHitPoints>
    </statBases>
    <placeWorkers>
			<li>Placeworker_AttachedToWall</li>
    </placeWorkers>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>25</basePowerConsumption>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>4</glowRadius>
        <glowColor>(255,230,120,255)</glowColor>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
    <designationCategory>ST_Designation</designationCategory>
    <researchPrerequisites>
      <li>ST_UFP_Interior</li>
    </researchPrerequisites>
  </ThingDef>

  <!--  Biobed  -->
  <ThingDef ParentName="BedBase">
    <defName>ST_Biobed</defName>
    <label>biobed</label>
    <description>Advanced medical bed with integrated diagnostics and stabilizers.</description>
    <thingClass>Building_Bed</thingClass>
    <graphicData>
      <texPath>Things/Building/Interiors/ST_BioBed</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <size>(2,1)</size>
    <statBases>
      <WorkToBuild>2200</WorkToBuild>
      <MaxHitPoints>220</MaxHitPoints>
	  <Mass>25</Mass>
      <Flammability>0.2</Flammability>
      <ImmunityGainSpeedFactor>0.07</ImmunityGainSpeedFactor>
      <SurgerySuccessChanceFactor>0.10</SurgerySuccessChanceFactor>
      <MedicalTendQualityOffset>0.10</MedicalTendQualityOffset>
      <BedRestEffectiveness>1.1</BedRestEffectiveness>
      <Comfort>0.7</Comfort>
      <Beauty>5</Beauty>
    </statBases>
    <costList>
      <Steel>60</Steel>
      <Plasteel>20</Plasteel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <MedicineIndustrial>2</MedicineIndustrial>
    </costList>
    <building>
      <bed_showSleeperBody>true</bed_showSleeperBody>
      <bed_healPerDay>5</bed_healPerDay>
      <bed_defaultMedical>true</bed_defaultMedical>
      <paintable>true</paintable>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>120</basePowerConsumption>
      </li>
    </comps>
    <designationCategory>ST_Designation</designationCategory>
    <researchPrerequisites>
      <li>ST_UFP_Interior</li>
	  <li>ST_Medical_diagnostics</li>
    </researchPrerequisites>
  </ThingDef>


  <!-- C) LCARS Research Console -->
  <ThingDef ParentName="BuildingBase">
    <defName>ST_LCARS_ResearchConsole</defName>
    <label>LCARS research console</label>
    <description>LCARS auxiliary console that boosts nearby research benches.</description>
    <thingClass>Building</thingClass>
    <size>(1,1)</size>
    <graphicData>
      <texPath>Things/Building/ST_LCARSC</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <costList>
      <Steel>35</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToBuild>700</WorkToBuild>
      <MaxHitPoints>150</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <Beauty>2</Beauty>
    </statBases>
    <comps>
      <li Class="CompProperties_Facility">
        <statOffsets>
          <li>
            <stat>ResearchSpeedFactor</stat>
            <offset>0.06</offset>
          </li>
        </statOffsets>
        <maxSimultaneous>2</maxSimultaneous>
        <linkableBuildings>
          <li>HiTechResearchBench</li>
          <li>SimpleResearchBench</li>
        </linkableBuildings>
        <requireSameFaction>true</requireSameFaction>
        <researchPrerequisites>
          <li>ST_Shipboard_Interiors</li>
        </researchPrerequisites>
      </li>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>80</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
    </comps>
    <designationCategory>ST_Designation</designationCategory>
    <researchPrerequisites>
      <li>ST_UFP_Interior</li>
    </researchPrerequisites>
  </ThingDef>

</Defs>