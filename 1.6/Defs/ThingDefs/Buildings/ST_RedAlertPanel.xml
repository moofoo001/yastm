<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>ST_RedAlertPanel</defName>
    <label>red alert panel</label>
    <description>Colony-wide alert trigger. Temporarily boosts movement, but reduces focused work.</description>
    <size>(1,1)</size>
    <rotatable>true</rotatable>
    <graphicData>
    <drawSize>(3,3)</drawSize>
      <texPath>Things/Building/AlertPanel/AlertPanel</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
    <drawOffsetNorth>(0,0,-0.2)</drawOffsetNorth>
    <drawOffsetSouth>(0,0,0.2)</drawOffsetSouth>
    <drawOffsetWest>(0.45,0,0)</drawOffsetWest>
    <drawOffsetEast>(-0.45,0,0)</drawOffsetEast>
    <damageData>
        <enabled>false</enabled>
    </damageData>
    </graphicData>
    <uiIconPath>Things/Building/AlertPanel/AlertPanel</uiIconPath>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Flammability>0.5</Flammability>
      <Mass>8</Mass>
    </statBases>
    <costList>
      <Steel>40</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="YASTM.CompProperties_RedAlertPanel">
        <durationTicks>18000</durationTicks>   <!-- ~5h -->
        <cooldownTicks>90000</cooldownTicks>   <!-- ~1.5 Tage -->
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>3</glowRadius>
        <glowColor>(214,1,1,0)</glowColor>
        <colorPickerEnabled>false</colorPickerEnabled>
        <darklightToggle>false</darklightToggle>
      </li>
    </comps>
    <designationCategory>ST_Designation</designationCategory>
    <uiOrder>2150</uiOrder>
    <researchPrerequisites>       
        <li>ST_RedAlertProtocols</li>
    </researchPrerequisites>
    <building>
		  <isEdifice>false</isEdifice>
		  <isAttachment>true</isAttachment>
		</building>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <placeWorkers>
			<li>Placeworker_AttachedToWall</li>
		</placeWorkers>
  </ThingDef>

  <ResearchProjectDef>
    <defName>ST_RedAlertProtocols</defName>
    <label>red alert protocols</label>
    <description>Implements colony-wide alert routing and EPS priority to enable the Red Alert panel.</description>
    <baseCost>400</baseCost>
    <techLevel>Spacer</techLevel>
    <tab>ST_Research</tab>
    <prerequisites>
      <li>Pre_Warp</li>
      <li>Electricity</li>
    </prerequisites>
    <researchViewX>3</researchViewX>
    <researchViewY>0</researchViewY>
  </ResearchProjectDef>

</Defs>
