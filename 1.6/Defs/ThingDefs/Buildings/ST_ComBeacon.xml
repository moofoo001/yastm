<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ========== CRATE / ITEM: per Use „Deploy ComBeacon“ ========== -->
  <ThingDef ParentName="ResourceBase">
    <defName>ST_ComBeacon_Item</defName>
    <label>Starfleet ComBeacon (crate)</label>
    <thingClass>ThingWithComps</thingClass>
    <graphicData>
      <texPath>Things/Item/Special/ST_ComBeacon_Crate</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>8</Mass>
    </statBases>
    <tradeability>Sellable</tradeability>
    <stackLimit>1</stackLimit>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Usable">
        <useLabel>Deploy ComBeacon</useLabel>
        <useJob>UseItem</useJob>
      </li>
      <li Class="StarTrekFactions.Comps.CompProperties_UseEffect_DeployBeacon">
        <buildingDef>ST_ComBeacon</buildingDef>
        <placeNearUser>true</placeNearUser>
      </li>
    </comps>
  </ThingDef>

    <!-- Built Beacon -->
    <ThingDef ParentName="BuildingBase">
    <defName>ST_ComBeacon</defName>
    <label>Starfleet Communications Beacon</label>
    <thingClass>Building_CommsConsole</thingClass>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <selectable>true</selectable>
    <description>Starfleet subspace communication node. Works as a comms console for contacting factions/orbital traders and can transmit a Starfleet subspace ping to initiate missions.</description>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
        <li>BuildingsMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>90</MaxHitPoints>
      <WorkToBuild>1000</WorkToBuild>
      <Flammability>0.3</Flammability>
      <Mass>6</Mass>
    </statBases>
    <graphicData>
      <texPath>Things/Building/ST_ComBeacon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
    </graphicData>
    <uiIconScale>0.5</uiIconScale>
    <costList>
        <Steel>50</Steel>
        <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <designationCategory>ST_Designation</designationCategory>

    <placeWorkers>
         <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>

    <researchPrerequisites>
        <li>MicroelectronicsBasics</li>
        <li>ST_SubspaceTelemetry</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <comps>
      <!-- Power and switch  -->
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>120</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Breakdownable"/>
      <li Class="StarTrekFactions.Comps.CompProperties_UseEffect_SpawnFarAndSignal">
        <inSignal>STQ.Obelisks.BeaconActivated</inSignal>
        <minDist>42</minDist>
        <maxDist>72</maxDist>
        <outsideHome>true</outsideHome>
        <requirePowerOn>true</requirePowerOn>  
        <thingA>ST_Obelisk_A</thingA>
        <thingB>ST_Obelisk_B</thingB>
        <questDefToEnsure>STQ_VE_Obelisks_I_II_Setup</questDefToEnsure>
      </li>
      
      <!-- "Request Starfleet Aid"  -->
      <li Class="YASTM.CompProperties_StarfleetAid">
        <useLabel>Request Starfleet Aid</useLabel>
        <cooldownDays>10</cooldownDays>            <!-- globaler Cooldown in Tagen -->
        <silverCost>200</silverCost>               <!-- 0 = keine Silber-Kosten -->
        <goodwillCost>6</goodwillCost>             <!-- 0 = keine Goodwill-Kosten -->
        <minGoodwill>40</minGoodwill>              <!-- Button nur ab wohlwollender Beziehung -->
        <federationFactionDef>Federation_Of_Planets</federationFactionDef> <!-- dein FactionDefName -->
        <useDuration>120</useDuration>             <!-- "Sendezeit" (Flavor) -->
      </li>

      <!--  Beacon-Flow: Init + Report -->
      <li Class="StarTrekFactions.Comps.CompProperties_BeaconControls">
        <initLabelKey>ST.InitializeBeacon</initLabelKey>
        <reportLabelKey>ST.ReportToStarfleet</reportLabelKey>
        <initSignal>STQ.Obelisks.BeaconActivated</initSignal>
        <reportSignal>STQ.Obelisks.DataTransmitted</reportSignal>
        <requireScansForReport>true</requireScansForReport>
        <fireIncidentOnReport>false</fireIncidentOnReport>
        <pointsFactor>1.0</pointsFactor>
        <spawnOnInit>
          <li>
            <thingDef>ST_Obelisk_A</thingDef>
            <count>1</count>
          </li>
          <li>
            <thingDef>ST_Obelisk_B</thingDef>
            <count>1</count>
          </li>
        </spawnOnInit>
      </li>
    </comps>
    </ThingDef>
</Defs>