<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>ST_TransporterBeacon</defName>
    <label>transporter beacon</label>
    <description>Fixed transporter node. Beams nearby colonists to the nearest powered beacon on this map.</description>

    <thingClass>Building</thingClass>
    <size>(1,1)</size>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <rotatable>false</rotatable>
    <selectable>true</selectable>
    <passability>PassThroughOnly</passability>

    <graphicData>
      <texPath>Things/Building/ST_TransportBeacon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>

    <!-- KEIN PlaceWorker_RequireProximityToDef, KEINE ModExtension für Grav-Engine -->

    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>0.2</Flammability>
    </statBases>

    <comps>
      <li Class="CompProperties_Power">
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>350</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />

      <!-- QoL-Gate (Power/Flick/Cooldown-Anzeige), ohne Grav-Anforderung -->
      <li Class="YASTM.CompProperties_TransporterPolish" />

      <!-- Transporter-Logik -->
      <li Class="YASTM.CompProperties_TransporterBeacon">
        <!-- Entweder große Reichweite ... -->
        <maxBeamOutDistance>200</maxBeamOutDistance>
        <!-- ... oder -1 = unbegrenzt auf der Map -->
        <!-- <maxBeamOutDistance>-1</maxBeamOutDistance> -->

        <!-- Zieltyp (leer = jeder Beacon); Standard lassen: -->
        <targetBeaconDefName>ST_TransporterBeacon</targetBeaconDefName>

        <!-- Bediener-Gate optional: min. Rang -->
        <minOperatorRankTraitDefName>ST_Rank_LieutenantJG</minOperatorRankTraitDefName>

        <!-- Bedienung: direkt am Beacon stehen -->
        <requireOperatorAdjacent>true</requireOperatorAdjacent>
        <operatorMaxDistance>1</operatorMaxDistance>

        <!-- Baselines -->
        <maxPawnsPerPulse>1</maxPawnsPerPulse>
        <colonistsOnly>true</colonistsOnly>
        <cooldownBeamInTicks>300000</cooldownBeamInTicks>   <!-- 5 Tage -->
        <cooldownBeamOutTicks>120000</cooldownBeamOutTicks> <!-- 2 Tage -->
        <soundDefName>ST_Transporter_Beam_YASTM</soundDefName>
      </li>

      <li Class="CompProperties_Glower">
        <glowRadius>8</glowRadius>
        <glowColor>(0,218,255,0)</glowColor>
      </li>
    </comps>

    <designationCategory>ST_Designation</designationCategory>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
  </ThingDef>
</Defs>
