<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>ST_TransporterBeacon</defName>
    <label>transporter beacon</label>
    <description>Pairs with other transporter beacons. Use “Beam out” to send a selected pawn from this beacon to a linked beacon within range; use “Beam in” to bring a selected pawn here. Requires power.</description>

    <thingClass>Building</thingClass>
    <size>(3,1)</size>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <rotatable>true</rotatable>
    <selectable>true</selectable>
    <passability>PassThroughOnly</passability>

    <graphicData>
      <texPath>Things/Building/ST_TransportBeacon</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <uiIconScale>1</uiIconScale>

    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
    </costList>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>0.2</Flammability>
    </statBases>

    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>200</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable" />
      <li Class="CompProperties_Breakdownable" />

      <!-- YASTM 2-Beacon Transporter -->
      <li Class="YASTM.CompProperties_TransporterBeacon">
        <!-- pro Beam-Vorgang (nur informativ, derzeit visuell/VFX) -->
        <energyCostPerUse>1200</energyCostPerUse>
        <!-- Warmup bis zum Beam -->
        <warmupTicks>60</warmupTicks>
        <!-- gemeinsamer Cooldown für In/Out -->
        <cooldownTicks>120000</cooldownTicks>  <!-- 2 in-game Stunden -->
        <!-- Maximaler Abstand zwischen Beacon A und B -->
        <maxLinkDistance>100</maxLinkDistance>

        <!-- Mindest-Rang für BEAM OUT (vom aktiven Beacon weg) -->
        <requiredRankTraitsBeamOut>
          <li>ST_Rank_LieutenantJG</li>
          <li>ST_Rank_Lieutenant</li>
          <li>ST_Rank_LtCommander</li>
          <li>ST_Rank_Commander</li>
          <li>ST_Rank_Captain</li>
        </requiredRankTraitsBeamOut>

        <!-- Mindest-Rang für BEAM IN (zum aktiven Beacon her) -->
        <requiredRankTraitsBeamIn>
          <li>ST_Rank_LieutenantJG</li>
          <li>ST_Rank_Lieutenant</li>
          <li>ST_Rank_LtCommander</li>
          <li>ST_Rank_Commander</li>
          <li>ST_Rank_Captain</li>
        </requiredRankTraitsBeamIn>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>8</glowRadius>
        <glowColor>(0,218,255,0)</glowColor>
      </li>
    </comps>

    <designationCategory>ST_Designation</designationCategory>
    <researchPrerequisites>
      <li>Electricity</li>
      <li>ST_TransporterTech</li>
    </researchPrerequisites>
  </ThingDef>
</Defs>
