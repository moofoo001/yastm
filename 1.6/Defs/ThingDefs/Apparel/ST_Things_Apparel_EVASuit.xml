  <!-- Starfleet EVS  -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>ST_Apparel_Starfleet_EVS</defName>
    <label>standard-issue Starfleet EVS</label>
    <description>A standard issue Extra-Vehicular suit for hazardous field operations. Provides strong heat protection and solid overall defense at the cost of mobility.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Apparel/EVSuit/Starfleet_EVS</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>1,1</drawSize>
    </graphicData>
    <uiIconScale>2</uiIconScale>
    <uiIconPath>Things/Item/Apparel/EVSuit/Starfleet_EVS</uiIconPath>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <tradeTags>
      <li>Clothing</li>
    </tradeTags>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>0.4</Flammability>
      <DeteriorationRate>1.5</DeteriorationRate>
      <Mass>5.0</Mass>
      <MarketValue>800</MarketValue>
      <ArmorRating_Sharp>0.24</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
      <ArmorRating_Heat>0.45</ArmorRating_Heat>
      <Insulation_Cold>12</Insulation_Cold>
      <Insulation_Heat>18</Insulation_Heat>
      <MoveSpeed>-0.10</MoveSpeed>
      <WorkSpeedGlobal>-0.04</WorkSpeedGlobal>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-1.25</MoveSpeed>
      <VacuumResistance>0.35</VacuumResistance>
    </equippedStatOffsets>
    <costList>
      <Cloth>60</Cloth>
	    <Plasteel>40</Plasteel>
      <ComponentIndustrial>10</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
    </costList>
    <apparel>
      <wornGraphicPath>Things/Item/Apparel/EVSuit/Starfleet_EVS</wornGraphicPath>
      <layers>
        <li>Shell</li>
      </layers>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <tags>
        <li>StarfleetUniform</li>
        <li>Hazard</li>
      </tags>
      <defaultOutfitTags>
        <li>Hazard</li>
      </defaultOutfitTags>
    </apparel>
    <recipeMaker>
      <workSkill>Crafting</workSkill>
      <effectWorking>Tailor</effectWorking>
      <soundWorking>Recipe_Tailor</soundWorking>
      <recipeUsers>
        <li>ElectricTailoringBench</li>
        <li>HandTailoringBench</li>
      </recipeUsers>
      <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
      <defaultIngredientFilter>
        <categories>
          <li>Root</li>
        </categories>
        <disallowedThingDefs>
          <li>Jade</li>
          <li>Uranium</li>
        </disallowedThingDefs>
      </defaultIngredientFilter>
      <workAmount>20000</workAmount>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <researchPrerequisites>
        <li>ST_EVSuits</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>


  <!-- Starfleet EV Helmet -->
