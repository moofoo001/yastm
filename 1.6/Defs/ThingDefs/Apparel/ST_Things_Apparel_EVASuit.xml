<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- generic EVA Suit -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>ST_EVASuit</defName>
    <label>EVA suit</label>
    <description>Pressurized suit for vacuum/contamination. Bulky but lifesaving.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Apparel/EVSuit/Starfleet_EVS</texPath>
     <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>1,1</drawSize>
    </graphicData>
    <uiIconPath>Things/Item/Apparel/EVSuit/Starfleet_EVS</uiIconPath>
    <apparel>
      <wornGraphicPath>Things/Item/Apparel/EVSuit/Starfleet_EVS</wornGraphicPath>
      <bodyPartGroups>
        <li>Torso</li><li>Arms</li><li>Legs</li>
      </bodyPartGroups>
      <layers>
        <li>OnSkin</li><li>Shell</li>
      </layers>
      <tags>
        <li>IndustrialBasic</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li><li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <statBases>
      <WorkToMake>14000</WorkToMake>
      <Mass>6.0</Mass>
      <StuffEffectMultiplierInsulation_Cold>0.65</StuffEffectMultiplierInsulation_Cold>
      <Insulation_Cold>36</Insulation_Cold>
      <Insulation_Heat>6</Insulation_Heat>
      <MoveSpeed>-0.10</MoveSpeed>
      <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.06</ArmorRating_Blunt>
      <ToxicResistance>0.30</ToxicResistance>
    </statBases>
    <equippedStatOffsets>
      <VacuumResistance>0.35</VacuumResistance>
    </equippedStatOffsets>
    <costList>
      <Cloth>50</Cloth>
      <ComponentIndustrial>2</ComponentIndustrial>
      <ComponentSpacer>1</ComponentSpacer>
      <Plasteel>30</Plasteel>
    </costList>
  </ThingDef>

