<?xml version="1.0" encoding="utf-8"?>
<Defs>


  <ThingDef ParentName="ApparelBase" Name="ST_RankPip_ApparelBase" Abstract="True">
    <defName>ST_RankPip_ApparelBase</defName>
    <label>rank pips (base)</label>
    <description>Base definition for utility rank pips. Invisible on pawn; shown in gear.</description>
    <smeltable>false</smeltable>
    <thingCategories>
      <li>ApparelUtility</li>
    </thingCategories>
    <apparel>
      <layers><li>Belt</li></layers>             
      <bodyPartGroups><li>Waist</li></bodyPartGroups>
      <tags><li>UtilityBelt</li></tags>
      <defaultOutfitTags><li>Worker</li><li>Soldier</li></defaultOutfitTags>
    </apparel>
    <statBases>
      <Mass>0.05</Mass>
    </statBases>
    <tradeability>Sellable</tradeability>
  </ThingDef>

  <!-- Ensign -->
  <ThingDef ParentName="ST_RankPip_ApparelBase">
    <defName>ST_RankPips_Ensign</defName>
    <label>rank pips (ensign)</label>
    <description>Utility rank pips for Ensign. Invisible on pawn; shown in gear.</description>
    <graphicData>
      <texPath>Things/Item/Accessory/pip/pip_ensign</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
  </ThingDef>

