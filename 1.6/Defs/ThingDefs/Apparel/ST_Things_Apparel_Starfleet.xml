<?xml version="1.0" encoding="utf-8" ?>
<Defs>

   <!-- 1) Shared-Base: kein Stuff, keine Kosten, kein recipeMaker -->
  <ThingDef Name="ST_Apparel_StarfleetTunic_shared" ParentName="ApparelMakeableBase" Abstract="True">
    <label>Starfleet tunic</label>
    <description>UFP standard uniform.</description>
    
    <graphicData>
      <texPath>Things/Item/Apparel/Federation_Tunic/FederationTunic</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <!--drawSize>(0.8,1)</drawSize-->
    </graphicData>
    <uiIconScale>2</uiIconScale>
    
    <statBases>
      <WorkToMake>2200</WorkToMake>
      <Mass>0.6</Mass>
      <MarketValue>120</MarketValue>
      <ArmorRating_Sharp>0.20</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.03</ArmorRating_Blunt>
      <ArmorRating_Heat>0.10</ArmorRating_Heat>
      <Insulation_Cold>4</Insulation_Cold>
      <Insulation_Heat>4</Insulation_Heat>
    </statBases>
    
    <thingCategories><li>Apparel</li></thingCategories>

    <apparel>
      <wornGraphicPath>Things/Item/Apparel/Federation_Tunic/FederationTunic</wornGraphicPath>
      <bodyPartGroups><li>Torso</li><li>Arms</li></bodyPartGroups>
      <layers><li>OnSkin</li></layers>
      <tags><li>StarfleetUniform</li></tags>
    </apparel>
    
    <costList>
      <Cloth>80</Cloth>
      <Steel>20</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    
    <equippedStatOffsets><SocialImpact>0.05</SocialImpact></equippedStatOffsets>
      
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable"/>
      <li><compClass>CompQuality</compClass></li>
      <!-- KEIN CompColorable, KEIN CompProperties_Styleable -->
    </comps>

  </ThingDef>

  <!-- 2) Craftbare neutrale Tunic: fügt Stuff/Kosten/Recipe hinzu -->
  <ThingDef ParentName="ST_Apparel_StarfleetTunic_shared">
    <defName>ST_Apparel_StarfleetTunic</defName>
    <label>Starfleet tunic</label>
    <stuffCategories><li>Fabric</li></stuffCategories>
    <costStuffCount>45</costStuffCount>

    <apparel>
      <wornGraphicPath>Things/Item/Apparel/Federation_Tunic/FederationTunic</wornGraphicPath>
      <bodyPartGroups><li>Torso</li><li>Arms</li></bodyPartGroups>
      <layers><li>OnSkin</li></layers>
      <tags><li>StarfleetUniform</li></tags>
    </apparel>

    <recipeMaker>
      <workAmount>5000</workAmount>
      <workSkill>Crafting</workSkill>
      <effectWorking>Tailor</effectWorking>
      <soundWorking>Recipe_Tailor</soundWorking>
      <skillRequirements><Crafting>4</Crafting></skillRequirements>
      <recipeUsers>
        <li>ElectricTailoringBench</li>
        <li>HandTailoringBench</li>
      </recipeUsers>
      <researchPrerequisites>
        <li>Federation_Standard</li>
      </researchPrerequisites>
    </recipeMaker>

    <!-- NICHT zufällig generieren/auswählen -->
    <generateCommonality>0</generateCommonality>
    <tradeability>None</tradeability>
    <alwaysHaulable>true</alwaysHaulable>   <!-- optional, aber robust -->

  </ThingDef>

  <!-- 3) Varianten (spawn-only, keine Stuff/Kosten) -->
  <!-- Command (Gold) -->
  <ThingDef ParentName="ST_Apparel_StarfleetTunic_shared">
    <defName>ST_Apparel_StarfleetTunic_Command</defName>
    <label>Starfleet tunic (command)</label>
    <stuffCategories Inherit="False" />  
    <graphicData><color>(0.85, 0.60, 0.01, 1)</color></graphicData>
    <apparel>
     <tags>
        <li>StarfleetUniform</li>
        <li>ST_CommandOnly</li>               <!-- bzw. ST_OperationsOnly / ST_ScienceOnly / ST_MedicalOnly -->
      </tags>
     </apparel>
     <alwaysHaulable>true</alwaysHaulable>
  </ThingDef>

  <!-- Operations (Rot) -->
  <ThingDef ParentName="ST_Apparel_StarfleetTunic_shared">
    <defName>ST_Apparel_StarfleetTunic_Operations</defName>
    <label>Starfleet tunic (operations)</label>
    <stuffCategories Inherit="False" />  
    <graphicData><color>(0.60, 0.01, 0.01, 1)</color></graphicData>
    <apparel>
      <tags>
        <li>StarfleetUniform</li>
        <li>ST_OperationsOnly</li>               <!-- bzw. ST_OperationsOnly / ST_ScienceOnly / ST_MedicalOnly -->
      </tags>
     </apparel>
     <alwaysHaulable>true</alwaysHaulable>
  </ThingDef>

  <!-- Science (Blau) -->
  <ThingDef ParentName="ST_Apparel_StarfleetTunic_shared">
    <defName>ST_Apparel_StarfleetTunic_Science</defName>
    <label>Starfleet tunic (science)</label>
    <stuffCategories Inherit="False" />  
    <graphicData><color>(0.20, 0.38, 0.63, 1)</color></graphicData>
    <apparel>
      <tags>
        <li>StarfleetUniform</li>
        <li>ST_ScienceOnly</li>               <!-- bzw. ST_OperationsOnly / ST_ScienceOnly / ST_MedicalOnly -->
      </tags>
     </apparel>
     <alwaysHaulable>true</alwaysHaulable>
  </ThingDef>

  <!-- Medical (Hell Blau) -->
  <ThingDef ParentName="ST_Apparel_StarfleetTunic_shared">
    <defName>ST_Apparel_StarfleetTunic_Medical</defName>
    <label>Starfleet tunic (medical)</label>
    <stuffCategories Inherit="False" />  
    <graphicData><color>(0.77, 0.86, 0.92, 1)</color></graphicData>
    <apparel>
        <tags>
          <li>StarfleetUniform</li>
          <li>ST_MedicalOnly</li>               <!-- bzw. ST_OperationsOnly / ST_ScienceOnly / ST_MedicalOnly -->
        </tags>
    </apparel>
    <alwaysHaulable>true</alwaysHaulable>    
  </ThingDef>


<!-- black fancy Pantsy !!! -->
<ThingDef ParentName="ApparelBase">
  <defName>ST_Apparel_StarfleetPants</defName>
  <label>Starfleet duty slacks</label>
  <description>Standard duty slacks used by Starfleet personnel.</description>
  <tradeTags>
    <li>Clothing</li>
  </tradeTags>
  <techLevel>Spacer</techLevel>
  <graphicData>
    <texPath>Things/Pawn/Humanlike/Apparel/Pants/Pants</texPath>
    <graphicClass>Graphic_Single</graphicClass>
    <shaderType>CutoutComplex</shaderType>
    <color>(0.01, 0.01, 0.01, 1)</color>
  </graphicData>
  
  <thingCategories>
    <li>ApparelArmor</li>
  </thingCategories>

  <stuffCategories>
    <li>Fabric</li>
    <li>Leathery</li>
  </stuffCategories>
  <costStuffCount>40</costStuffCount>
  <apparel>
    <bodyPartGroups>
      <li>Legs</li>
    </bodyPartGroups>
    <layers>
      <li>OnSkin</li>
    </layers>
    <tags>
      <li>IndustrialBasic</li>
    </tags>
    <defaultOutfitTags>
      <li>Worker</li>
      <li>Soldier</li>
    </defaultOutfitTags>
  </apparel>

  <statBases>
    <WorkToMake>1800</WorkToMake>
    <MarketValue>90</MarketValue>
    <Mass>0.4</Mass>
    <Insulation_Cold>2</Insulation_Cold>
    <Insulation_Heat>2</Insulation_Heat>
    <ArmorRating_Sharp>0.06</ArmorRating_Sharp>
    <ArmorRating_Blunt>0.02</ArmorRating_Blunt>
    <ArmorRating_Heat>0.05</ArmorRating_Heat>
    <MaxHitPoints>100</MaxHitPoints>
    <Flammability>1.0</Flammability>
  </statBases>

  <recipeMaker>
    <workAmount>1000</workAmount>
    <workSkill>Crafting</workSkill>
    <effectWorking>Tailor</effectWorking>
    <soundWorking>Recipe_Tailor</soundWorking>
    <recipeUsers>
      <li>ElectricTailoringBench</li>
      <li>HandTailoringBench</li>
    </recipeUsers>
    <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
    <researchPrerequisites>
      <li>Federation_Standard</li>
    </researchPrerequisites>
  </recipeMaker>
  <alwaysHaulable>true</alwaysHaulable>

</ThingDef>

<!-- Counselor Sash-->

  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Apparel_FederationCounselorSash</defName>
    <label>Counselor Sash</label>
    <description>A symbolic Apparel for a Starfleet Counselor and a long strip of material worn over one shoulder.</description>
    <graphicData>
      <texPath>Things/Item/Apparel/Counselor_sash/Counselor_sash</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.6</drawSize>
    </graphicData>
    <techLevel>Industrial</techLevel>
    <costStuffCount>25</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <WorkToMake>1000</WorkToMake>
      <Mass>0.5</Mass>
      <StuffEffectMultiplierArmor>0.1</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.1</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.1</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>
        <li>ST_Common_Issue_Gear</li>
      </researchPrerequisite>
      <skillRequirements>
        <Crafting>3</Crafting>
      </skillRequirements>
      <displayPriority>250</displayPriority>
    </recipeMaker>

    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <wornGraphicPath>Things/Item/Apparel/Counselor_sash/Counselor_sash</wornGraphicPath>
      <layers>
        <li>Middle</li>
      </layers>
      <tags>
        <li>StarfleetGear</li>
        <li>StarfleetUtility</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
        <li>Soldier</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>true</canBeDesiredForIdeo>
    </apparel>
    <tradeTags>
      <li>Armor</li>
    </tradeTags>
      <thingCategories>
        <li>Apparel</li>
      </thingCategories>
      <alwaysHaulable>true</alwaysHaulable>
  </ThingDef>

</Defs>