<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--  (under shell, above OnSkin) -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>ST_Apparel_ArmoredVest</defName>
    <label>Starfleet armored vest</label>
    <description>Light protective vest worn under the tunic, designed to stop shrapnel and low-energy fire.</description>

    <graphicData>
      <texPath>Things/Item/Apparel/Starfleet_Vest/Starfleet_Vest</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    <drawSize>1,1</drawSize>
    </graphicData>
    <uiIconScale>2</uiIconScale>

    <thingCategories>
      <li>Apparel</li>

    </thingCategories>

    <statBases>
      <!-- Flak-Weste !≈ -->
      <WorkToMake>4500</WorkToMake>
      <Mass>2.4</Mass>
      <MarketValue>220</MarketValue>
      <ArmorRating_Sharp>0.18</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
      <ArmorRating_Heat>0.22</ArmorRating_Heat>
      <Insulation_Cold>0.5</Insulation_Cold>
      <Insulation_Heat>0.5</Insulation_Heat>
    </statBases>

    <apparel>
    <wornGraphicPath>Things/Item/Apparel/Starfleet_Vest/Starfleet_Vest</wornGraphicPath>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
      </bodyPartGroups>
      <layers>
        <li>Middle</li>
      </layers>
      <tags>
        <li>StarfleetUniform</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>

    <costList>
      <Plasteel>20</Plasteel>
      <Cloth>30</Cloth>
      <ComponentIndustrial>10</ComponentIndustrial>
    </costList>

    <stuffCategories/>
    <tradeTags><li>ClothingArmor</li></tradeTags>

    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <efficiencyStat>GeneralLaborSpeed</efficiencyStat>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
      <researchPrerequisites>
        <li>Federation_Standard</li>
      </researchPrerequisites>
    </recipeMaker>
  </ThingDef>
</Defs>
