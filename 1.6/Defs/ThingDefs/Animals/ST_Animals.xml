<Defs>

  <!-- Tribble (kleines Tier, zaehmbar -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>ST_Animal_Tribble</defName>
    <label>tribble</label>
    <description>Soft, purring and astonishingly prolific.</description>
    <statBases>
      <MarketValue>50</MarketValue>
      <LeatherAmount>1</LeatherAmount>
      <MeatAmount>0</MeatAmount>
      <MoveSpeed>2.3</MoveSpeed>
      <Wildness>0.30</Wildness>
    </statBases>
    <race>
      <herdAnimal>true</herdAnimal>
      <canBePredatorPrey>false</canBePredatorPrey>
      <body>QuadrupedAnimalWithPaws</body>
      <baseBodySize>0.18</baseBodySize>
      <baseHealthScale>0.25</baseHealthScale>
      <baseHungerRate>0.30</baseHungerRate>
      <foodType>VegetarianAnimal</foodType>
      <trainability>None</trainability>
      <lifeExpectancy>6</lifeExpectancy>
      <useMeatFrom>Rat</useMeatFrom>
      <leatherDef>Leather_Light</leatherDef>
      <gestationPeriodDays>0.1</gestationPeriodDays>
      <executionRange>4</executionRange>
      <soundEating>Rodent_Eat</soundEating>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.20</minAge></li>
        <li>
        <def>AnimalAdult</def>
        <minAge>0.40</minAge>
        	<soundWounded>Pawn_Rodent_Wounded</soundWounded>
					<soundDeath>Pawn_Rodent_Death</soundDeath>
					<soundCall>Pawn_Rodent_Call</soundCall>
					<soundAngry>Pawn_Rodent_Angry</soundAngry>
        </li>
      </lifeStageAges>
