  <!-- Klingonischer Targ (einfaches Wildtier/Haustier-Grundgerüst) -->
  <ThingDef ParentName="AnimalThingBase">
    <defName>ST_Animal_Targ</defName>
    <label>targ</label>
    <description>A tusked, boar-like creature favored by Klingons for hunting and herding.</description>
    <statBases>
      <MarketValue>280</MarketValue>
      <MoveSpeed>4.5</MoveSpeed>
      <LeatherAmount>35</LeatherAmount>
      <MeatAmount>80</MeatAmount>
      <FilthRate>4</FilthRate>
      <Wildness>0.70</Wildness>
    </statBases>
		<tools>
			<li>
				<capacities>
					<li>Bite</li>
				</capacities>
				<power>6</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
				<chanceFactor>0.3</chanceFactor>
			</li>
			<li>
				<label>tusk</label>
				<capacities>
          <li>Scratch</li>
          <li>Stab</li>
				</capacities>
				<power>10</power>
				<cooldownTime>2</cooldownTime>
				<linkedBodyPartsGroup>TuskAttackTool</linkedBodyPartsGroup>
				<chanceFactor>0.7</chanceFactor>
			</li>
      <li>
				<label>spikes</label>
				<capacities>
          <li>Scratch</li>
          <li>Stab</li>
				</capacities>
				<power>12</power>
				<cooldownTime>4</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.4</chanceFactor>
			</li>
		</tools>
    <race>
      <body>QuadrupedAnimalWithHoovesTusksAndTrunk</body>
      <baseBodySize>1.2</baseBodySize>
      <baseHealthScale>1.1</baseHealthScale>
      <baseHungerRate>0.6</baseHungerRate>
      <foodType>OmnivoreRoughAnimal</foodType>
      <leatherDef>Leather_Pig</leatherDef>
      <trainability>Intermediate</trainability>
      <herdAnimal>true</herdAnimal>
      <gestationPeriodDays>10</gestationPeriodDays>
      <manhunterOnTameFailChance>0.1</manhunterOnTameFailChance>
      <manhunterOnDamageChance>0.50</manhunterOnDamageChance>
      <litterSizeCurve>
				<points>
					<li>(0.5, 0)</li>
					<li>(1, 1)</li>
					<li>(1.7, 1)</li>
					<li>(2.0, 0)</li>
				</points>
			</litterSizeCurve>
      <lifeExpectancy>18</lifeExpectancy>
      <useMeatFrom>Pig</useMeatFrom>
      <roamMtbDays>3</roamMtbDays>
      <lifeStageAges>
        <li><def>AnimalBaby</def><minAge>0</minAge></li>
        <li><def>AnimalJuvenile</def><minAge>0.35</minAge></li>     
        <li>
					<def>AnimalAdult</def>
					<minAge>0.80</minAge>
					<soundWounded>Pawn_Wildboar_Wounded</soundWounded>
					<soundDeath>Pawn_Wildboar_Death</soundDeath>
					<soundCall>Pawn_Wildboar_Call</soundCall>
					<soundAngry>Pawn_Wildboar_Angry</soundAngry>
				</li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
			<soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
      <soundEating>Herbivore_Eat</soundEating>
      <wildBiomes>
  			<TemperateForest>0.2</TemperateForest>
				<AridShrubland>0.25</AridShrubland>
			  <Grasslands MayRequire="Ludeon.RimWorld.Odyssey">0.45</Grasslands>
			</wildBiomes>
    </race>
    <tradeTags>
      <li>AnimalFighter</li>
      <li>AnimalExotic</li>
    </tradeTags>
  </ThingDef>

