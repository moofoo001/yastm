  <ThingDef ParentName="AnimalThingBase">
  <defName>ST_Mugato</defName>
  <label>mugato</label>
  <description>A large, spike-backed primate from Neural. Extremely aggressive and territorial.</description>

  <statBases>
    <MoveSpeed>4.0</MoveSpeed>
    <MarketValue>600</MarketValue>
    <ArmorRating_Blunt>0.20</ArmorRating_Blunt>
    <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
    <ComfyTemperatureMin>10</ComfyTemperatureMin>
    <ComfyTemperatureMax>60</ComfyTemperatureMax>
    <Wildness>0.95</Wildness>
  </statBases>

  <tools>
    <li>
      <label>horn</label>
      <capacities><li>Stab</li></capacities>
      <power>17</power>
      <cooldownTime>2.5</cooldownTime>
      <linkedBodyPartsGroup>Horns</linkedBodyPartsGroup>
    </li>
    <li>
      <capacities><li>Bite</li></capacities>
      <power>14</power>
      <cooldownTime>2.0</cooldownTime>
      <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      <chanceFactor>0.6</chanceFactor>
    </li>
    <li>
      <label>head</label>
      <capacities><li>Blunt</li></capacities>
      <power>8</power>
      <cooldownTime>2.0</cooldownTime>
      <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
      <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
      <chanceFactor>0.2</chanceFactor>
    </li>
  </tools>

  <race>
    <body>QuadrupedAnimalWithPaws</body>
    <herdAnimal>false</herdAnimal>
    <baseBodySize>1.6</baseBodySize>
    <baseHealthScale>1.5</baseHealthScale>
    <baseHungerRate>0.45</baseHungerRate>
    <foodType>OmnivoreRoughAnimal</foodType>
    <trainability>None</trainability>
    <gestationPeriodDays>6.0</gestationPeriodDays>
    <manhunterOnDamageChance>0.35</manhunterOnDamageChance>
    <manhunterOnTameFailChance>0.7</manhunterOnTameFailChance>
    <litterSizeCurve>
      <points>
        <li>(0.5, 0)</li>
        <li>(1, 1)</li>
        <li>(1.5, 1)</li>
        <li>(2.0, 0)</li>
      </points>
    </litterSizeCurve>
    <lifeExpectancy>20</lifeExpectancy>

    <lifeStageAges>
      <li>
        <def>AnimalBaby</def>
        <minAge>0</minAge>
      </li>
      <li>
        <def>AnimalJuvenile</def>
        <minAge>0.15</minAge>
      </li>
      <li>
        <def>AnimalAdult</def>
        <minAge>0.3333</minAge>
        <!-- sichere Vanilla-Sounds -->
        <soundWounded>Pawn_Bear_Wounded</soundWounded>
        <soundDeath>Pawn_Bear_Death</soundDeath>
        <soundCall>Pawn_Bear_Call</soundCall>
        <soundAngry>Pawn_Bear_Angry</soundAngry>
      </li>
    </lifeStageAges>

    <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
    <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
    <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    <wildBiomes>
				<TropicalSwamp>0.15</TropicalSwamp>
				<TropicalRainforest>0.20</TropicalRainforest>
		</wildBiomes>
  </race>
  <tradeTags>
    <li>AnimalExotic</li>
  </tradeTags>
</ThingDef>

