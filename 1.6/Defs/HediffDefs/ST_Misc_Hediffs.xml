<?xml version="1.0" encoding="utf-8"?>
<Defs>

 <!-- Med Booster  -->
 
  <HediffDef>
    <defName>ST_Hediff_MedBooster</defName>
    <label>medical booster</label>
    <description>Temporary improvement in medical focus and coordination.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.95, 0.85)</defaultLabelColor>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
          <MedicalTendSpeed>0.30</MedicalTendSpeed>
          <SurgerySuccessChanceFactor>0.05</SurgerySuccessChanceFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

    <!-- transporter nausea -->
    <HediffDef>
    <defName>ST_TransporterNausea</defName>
    <label>transporter nausea</label>
    <description>Brief disorientation following matter stream reintegration.</description> <!-- FIX -->
    <hediffClass>HediffWithComps</hediffClass>
    <stages>
        <li>
        <capMods>
            <li><capacity>Consciousness</capacity><offset>-0.05</offset></li>
            <li><capacity>Moving</capacity><offset>-0.05</offset></li>
        </capMods>
        </li>
    </stages>
    <comps>
        <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>18000</disappearsAfterTicks>
        </li>
    </comps>
    </HediffDef>

    <!-- stun mode -->
    <HediffDef>
        <defName>ST_Hediff_PhaserStunMode</defName>
        <description>Phaser Stun mode</description>
        <label>phaser set to stun</label>
        <isBad>false</isBad>
        <tendable>false</tendable>
        <stages><li><minSeverity>0</minSeverity></li></stages>
    </HediffDef>


  <!-- NEU: Ktarian Afterglow -->
  <HediffDef>
    <defName>ST_KtarianAfterglow</defName>
    <label>afterglow</label>
    <description>Lingering neural stimulation from the Ktarian game.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>30000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <label>afterglow</label>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>0.02</offset>
          </li>
        </capMods>
        <statOffsets>
          <MoveSpeed>0.04</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- NEU: Obsessive focus -->
    <HediffDef>
    <defName>ST_KtarianObsession</defName>
    <label>obsessive focus</label>
    <description>Compulsive fixation on the Ktarian game. Hard to focus on anything else.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
        <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>90000</disappearsAfterTicks>
        </li>
    </comps>
    <stages>
        <li>
        <label>obsessive focus</label>
        <statOffsets>
            <WorkSpeedGlobal>0.08</WorkSpeedGlobal> 
            <GlobalLearningFactor>-0.10</GlobalLearningFactor>
            <SocialImpact>-0.15</SocialImpact>
        </statOffsets>
        </li>
    </stages>
    </HediffDef>

    <!-- Stimulant -->
    <HediffDef>
        <defName>ST_Hypo_Stimulant</defName>
        <label>stimulant</label>
        <description>Short burst of energy and coordination.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <comps>
        <li Class="HediffCompProperties_Disappears">
            <disappearsAfterTicks>12000</disappearsAfterTicks>
        </li>
        </comps>
        <stages>
        <li>
            <statOffsets>
            <MoveSpeed>0.20</MoveSpeed>
            </statOffsets>
            <capMods>
            <li>
                <capacity>Manipulation</capacity>
                <offset>0.10</offset>
            </li>
            </capMods>
        </li>
        </stages>
    </HediffDef>

    <!-- Field Triage Buff -->
    <HediffDef>
    <defName>ST_FieldTriageBuff</defName>
    <label>field triage</label>
    <description>Provides a temporary boost to medical tend speed and immunity gain, while slightly reducing pain.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.65,0.95,1)</defaultLabelColor>
    <tendable>false</tendable>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>3000</disappearsAfterTicks> 
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MedicalTendSpeed>0.25</MedicalTendSpeed>
          <ImmunityGainSpeed>0.05</ImmunityGainSpeed>
        </statOffsets>
        <painOffset>-0.05</painOffset>
      </li>
    </stages>
  </HediffDef>

    <!-- alert statuses -->
 
  <HediffDef>
    <defName>ST_Alert_RedState</defName>
    <label>red alert</label>
    <description>All hands to stations.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
      <statOffsets>
            <WorkSpeedGlobal>0.05</WorkSpeedGlobal>
            <MoveSpeed>0.05</MoveSpeed>
            <AimingDelayFactor>-0.05</AimingDelayFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

    <!-- yellow alert -->

  <HediffDef>
    <defName>ST_Alert_YellowState</defName>
    <label>yellow alert</label>
    <description>Heightened readiness.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <stages>
      <li>
        <statOffsets>
            <WorkSpeedGlobal>0.03</WorkSpeedGlobal> <!-- +3% -->
            <MoveSpeed>0.03</MoveSpeed> <!-- +3% -->
        </statOffsets>
      </li>
    </stages>
  </HediffDef>


  <!-- command presence buff -->
  <HediffDef>
    <defName>ST_CommandPresenceBuff</defName>
    <label>command presence</label>
    <description>Leadership aura that steadies nerves and improves coordination.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2200</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MoveSpeed>0.10</MoveSpeed>
          <AimingDelayFactor>-0.05</AimingDelayFactor>
          <ShootingAccuracyPawn>0.05</ShootingAccuracyPawn>
          <MentalBreakThreshold>-0.03</MentalBreakThreshold>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

    <!-- tactical overwatch buff -->
  <HediffDef>
    <defName>ST_TacticalOverwatchBuff</defName>
    <label>tactical overwatch</label>
    <description>Assumes a steady firing stance, improving aim at the cost of mobility.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>900</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <AimingDelayFactor>-0.15</AimingDelayFactor>
          <ShootingAccuracyPawn>0.03</ShootingAccuracyPawn>
          <MoveSpeed>-0.05</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- medical Tricorder -->
  <HediffDef>
    <defName>ST_MedScan_Boost</defName>
    <label>medical scan</label>
    <description>Fine-tuned treatment based on tricorder scan results.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>36000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0.85</painFactor>
        <statOffsets>
          <ImmunityGainSpeed>0.20</ImmunityGainSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- science Tricorder -->
  <HediffDef>
    <defName>ST_ScienceInsight</defName>
    <label>science insight</label>
    <description>New data informs better hypotheses and techniques.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
