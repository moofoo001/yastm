<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- medical Tricorder -->
  <HediffDef>
    <defName>ST_MedScan_Boost</defName>
    <label>medical scan</label>
    <description>Fine-tuned treatment based on tricorder scan results.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>36000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <painFactor>0.85</painFactor>
        <statOffsets>
          <ImmunityGainSpeed>0.20</ImmunityGainSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- science Tricorder -->
  <HediffDef>
    <defName>ST_ScienceInsight</defName>
    <label>science insight</label>
    <description>New data informs better hypotheses and techniques.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>36000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ResearchSpeed>0.20</ResearchSpeed>
          <MiningYield>0.10</MiningYield>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <!-- security Tricorder -->
  <HediffDef>
    <defName>ST_SecuritySweep</defName>
    <label>security sweep</label>
    <description>Heightened situational awareness after a tricorder sweep.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>36000</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ShootingAccuracyPawn>0.10</ShootingAccuracyPawn>
          <MeleeHitChance>0.08</MeleeHitChance>
          <AimingDelayFactor>-0.08</AimingDelayFactor>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
