<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- Gravship substructure with color options. -->

  <!-- Base definition, mostly copied from the core Substructure but with isPaintable=true -->  
    <TerrainDef Name="Substructure_C" ParentName="FloorBase" abstract="true">
    <defName>Substructure_C</defName>
    <label>gravship substructure colored</label>
    <description>A lightweight truss structure with flooring on top that forms the deck of a gravship. Only things on top of this substructure can be lifted by the grav engine's levitation field. This floor must be constructed within range of a grav engine.\n\nGravship substructure can be removed using the 'remove foundation' designator.</description>
    <texturePath>Terrain/Surfaces/Substructure/Substructure</texturePath>
    <fertility>0</fertility>
    <edgeType>Hard</edgeType>
    <renderPrecedence>399</renderPrecedence>
    <constructEffect>ConstructMetal</constructEffect>
    <isPaintable>true</isPaintable>
    <designationCategory>Odyssey</designationCategory>
    <isFoundation>true</isFoundation>
    <preventCraters>true</preventCraters>
    <designationHotKey>Misc9</designationHotKey>
    <affordances>
      <li>Substructure</li>
    </affordances>
    <statBases>
      <WorkToBuild>600</WorkToBuild>
      <Flammability>0</Flammability>
      <CleaningTimeFactor>0.9</CleaningTimeFactor>
    </statBases>
    <costList>
      <GravlitePanel>1</GravlitePanel>
      <Steel>4</Steel>
    </costList>
    <uiOrder>1000</uiOrder>
    <requireInspectedGravEngine>true</requireInspectedGravEngine>
    <terrainAffordanceNeeded>Walkable</terrainAffordanceNeeded>
    <resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
    <tags>
      <li>Substructure</li>
    </tags>
    <placeWorkers>
      <li>PlaceWorker_InSubstructureFootprint</li>
      <li>PlaceWorker_BuildingsValidOverSubstructure</li>
    </placeWorkers>
    <designationCategory />
  </TerrainDef>

  <!-- These inherit the *exact* behavior of the core gravship Substructure.
       Only the tint changes. Keep the ParentName as the original defName: Substructure. -->

  <!-- Blue tint -->
  <TerrainDef ParentName="Substructure_C">
    <defName>ST_Substructure_Blue</defName>
    <label>substructure (blue)</label>
    <color>(0.55, 0.70, 1.00, 1)</color>
  </TerrainDef>

  <!-- Gold tint -->
  <TerrainDef ParentName="Substructure_C">
    <defName>ST_Substructure_Gold</defName>
    <label>substructure (gold)</label>
    <color>(1.00, 0.85, 0.35, 1)</color>
  </TerrainDef>

  <!-- Dark tint -->
  <TerrainDef ParentName="Substructure_C">
    <defName>ST_Substructure_Dark</defName>
    <label>substructure (dark)</label>
    <color>(0.60, 0.60, 0.65, 1)</color>
  </TerrainDef>

</Defs>
