<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- YASTM – Obelisk Questline (alle Phasen in einem Quest) -->
  <QuestScriptDef>
    <!-- defName unverändert lassen, damit dein Incident weiter funktioniert -->
    <defName>STQ_VE_Obelisks_I_II_Setup</defName>
    <rootSelectionWeight>0</rootSelectionWeight>
    <autoAccept>false</autoAccept>

    <root Class="QuestNode_Sequence">
      <nodes>

        <!-- ========= PHASE I ========= -->
        <!-- Startbrief beim Annehmen -->
        <li Class="QuestNode_Letter">
          <inSignal>QuestAccepted</inSignal>
          <label>STQ.Obelisks.Setup.LetterTitle</label>
          <text>STQ.Obelisks.Setup.LetterText</text>
          <letterDef>NeutralEvent</letterDef>
        </li>

        <!-- Titel/Beschreibung Phase I -->
        <li Class="StarTrekFactions.QuestNodes.QuestNode_RenameOnSignal">
          <inSignal>QuestAccepted</inSignal>
          <titleKey>STQ.Obelisks.PhaseI.Title</titleKey>
          <descriptionKey>STQ.Obelisks.PhaseI.Desc</descriptionKey>
        </li>

        <!-- ========= PHASE II ========= -->
        <!-- Beacon aktiviert -> Phase II -->
        <li Class="StarTrekFactions.QuestNodes.QuestNode_RenameOnSignal">
          <inSignal>STQ.Obelisks.BeaconActivated</inSignal>
          <titleKey>STQ.Obelisks.PhaseII.Title</titleKey>
          <descriptionKey>STQ.Obelisks.PhaseII.Desc</descriptionKey>
        </li>

        <li Class="QuestNode_Letter">
          <inSignal>STQ.Obelisks.BeaconActivated</inSignal>
          <label>STQ.Obelisks.Impulse.FaunaTitle</label>
          <text>STQ.Obelisks.Impulse.FaunaText</text>
          <letterDef>NeutralEvent</letterDef>
        </li>

        <!-- Daten übertragen -> Manhunter pack -->
        <li Class="StarTrekFactions.QuestNodes.QuestNode_RunIncidentNow">
          <inSignal>STQ.Obelisks.DataTransmitted</inSignal>
          <incident>ManhunterPack</incident>
          <pointsFactor>1.0</pointsFactor>
          <outSignal>STQ.Obelisks.II.ManhuntersSpawned</outSignal>
        </li>

        <!-- Warten bis die Manhunter besiegt sind -->
        <li Class="StarTrekFactions.QuestNodes.QuestNode_WaitEnemiesDefeated">
          <inSignal>STQ.Obelisks.II.ManhuntersSpawned</inSignal>
          <onlyManhunters>true</onlyManhunters>
          <outSignal>STQ.Obelisks.II.Cleared</outSignal>
        </li>

        <!-- Info: Phase II abgeschlossen -->
        <li Class="QuestNode_Letter">
          <inSignal>STQ.Obelisks.II.Cleared</inSignal>
          <label>STQ.Obelisks.PhaseII.CompleteTitle</label>
          <text>STQ.Obelisks.PhaseII.CompleteText</text>
          <letterDef>NeutralEvent</letterDef>
        </li>

        <!-- ========= PHASE III (Pressure) ========= -->
        <!-- Umbenennen auf Phase III -->
        <li Class="StarTrekFactions.QuestNodes.QuestNode_RenameOnSignal">
          <inSignal>STQ.Obelisks.II.Cleared</inSignal>
          <titleKey>STQ.Obelisks.PhaseIII.Title</titleKey>
          <descriptionKey>STQ.Obelisks.PhaseIII.Desc</descriptionKey>
        </li>

            <!-- 1–2 Tage warten -->
        <li Class="StarTrekFactions.QuestNodes.QuestNode_DelayThenSignalOnSignal">
          <inSignal>STQ.Obelisks.II.Cleared</inSignal>
          <delayTicksMin>60000</delayTicksMin>
          <delayTicksMax>120000</delayTicksMax>
          <outSignal>STQ.Obelisks.III.DelayDone</outSignal>
          <debug>true</debug>
        </li>

        <!-- Zweiter Manhunter -->
        <li Class="StarTrekFactions.QuestNodes.QuestNode_RunIncidentNow">
          <inSignal>STQ.Obelisks.III.DelayDone</inSignal>
          <incident>ManhunterPack</incident>
          <pointsFactor>1.05</pointsFactor>
          <outSignal>STQ.Obelisks.III.ManhuntersSpawned</outSignal>
        </li>

        <!-- Warten bis besiegt -->
        <li Class="StarTrekFactions.QuestNodes.QuestNode_WaitEnemiesDefeated">
          <inSignal>STQ.Obelisks.III.ManhuntersSpawned</inSignal>
          <onlyManhunters>true</onlyManhunters>
          <outSignal>STQ.Obelisks.III.Cleared</outSignal>
        </li>

        <!-- Hinweisbrief nach Sieg -->
        <li Class="QuestNode_Letter">
          <inSignal>STQ.Obelisks.III.Cleared</inSignal>
          <label>STQ.Obelisks.PhaseIII.ThreatTitle</label>
          <text>STQ.Obelisks.PhaseIII.ThreatText</text>
          <letterDef>NeutralEvent</letterDef>
        </li>

      <!-- ====== CHOICE: Warden vs Vault ====== -->

      <!-- (Optional) Auto-Choice nach 1 Tag: wenn nicht entschieden, Default = Vault -->
      <li Class="StarTrekFactions.QuestNodes.QuestNode_DelayThenSignalOnSignal">
        <inSignal>STQ.Obelisks.III.Cleared</inSignal>
        <delayTicksMin>60000</delayTicksMin>   <!-- 1 Tag -->
        <delayTicksMax>60000</delayTicksMax>
        <outSignal>STQ.Obelisks.Path.Vault.Chosen</outSignal>
        <cancelIfSignal>STQ.Obelisks.Path.ChoiceMade</cancelIfSignal>
        <debug>false</debug>
      </li>

      <!-- Auswahl-Dialog -->
      <li Class="StarTrekFactions.QuestNodes.QuestNode_ChoiceDialogOnSignalV2">
        <inSignal>STQ.Obelisks.III.Cleared</inSignal>

        <!-- Titel/Body aus Keys (empfohlen) -->
        <titleKey>STQ.Obelisks.Choice.Title</titleKey>
        <textKey>STQ.Obelisks.Choice.Text</textKey>

        <!-- Optionen: schicken die beiden Pfad-Signale -->
        <optionALabel>STQ.Obelisks.Choice.Warden</optionALabel>
        <optionASignal>STQ.Obelisks.Path.Warden.Chosen</optionASignal>

        <optionBLabel>STQ.Obelisks.Choice.Vault</optionBLabel>
        <optionBSignal>STQ.Obelisks.Path.Vault.Chosen</optionBSignal>
      </li>

      <!-- ====== PFAD IV: WARDEN ====== -->
      <!-- Umbenennen + Hinweisschreiben -->
      <li Class="StarTrekFactions.QuestNodes.QuestNode_RenameOnSignal">
        <inSignal>STQ.Obelisks.Path.Warden.Chosen</inSignal>
        <titleKey>STQ.Obelisks.PhaseIV.Title</titleKey>
        <descriptionKey>STQ.Obelisks.PhaseIV.Desc</descriptionKey>
      </li>
      <li Class="QuestNode_Letter">
        <inSignal>STQ.Obelisks.Path.Warden.Chosen</inSignal>
        <label>STQ.Obelisks.PhaseIV.LetterTitle</label>
        <text>STQ.Obelisks.PhaseIV.LetterText</text>
        <letterDef>NeutralEvent</letterDef>
      </li>

      <!-- Kleiner feindlicher Raid -->
      <li Class="StarTrekFactions.QuestNodes.QuestNode_RunIncidentNow">
        <inSignal>STQ.Obelisks.Path.Warden.Chosen</inSignal>
        <incident>RaidEnemy</incident>
        <pointsFactor>0.80</pointsFactor>
        <outSignal>STQ.Obelisks.IV.RaidSpawned</outSignal>
      </li>

      <li Class="StarTrekFactions.QuestNodes.QuestNode_WaitEnemiesDefeated">
        <inSignal>STQ.Obelisks.IV.RaidSpawned</inSignal>
        <outSignal>STQ.Obelisks.IV.Cleared</outSignal>
      </li>

      <li Class="QuestNode_Letter">
        <inSignal>STQ.Obelisks.IV.Cleared</inSignal>
        <label>STQ.Obelisks.PhaseIV.DoneTitle</label>
        <text>STQ.Obelisks.PhaseIV.DoneText</text>
        <letterDef>PositiveEvent</letterDef>
      </li>

      <!-- ====== PFAD V: VAULT ====== -->
      <li Class="StarTrekFactions.QuestNodes.QuestNode_RenameOnSignal">
        <inSignal>STQ.Obelisks.Path.Vault.Chosen</inSignal>
        <titleKey>STQ.Obelisks.PhaseV.Title</titleKey>
        <descriptionKey>STQ.Obelisks.PhaseV.Desc</descriptionKey>
      </li>
      <li Class="QuestNode_Letter">
        <inSignal>STQ.Obelisks.Path.Vault.Chosen</inSignal>
        <label>STQ.Obelisks.PhaseV.LetterTitle</label>
        <text>STQ.Obelisks.PhaseV.LetterText</text>
        <letterDef>NeutralEvent</letterDef>
      </li>

      <!-- Basis-Variante (Core-only): kleiner Raid -->
      <li Class="StarTrekFactions.QuestNodes.QuestNode_RunIncidentNow">
        <inSignal>STQ.Obelisks.Path.Vault.Chosen</inSignal>
        <incident>RaidEnemy</incident>
        <pointsFactor>0.70</pointsFactor>
        <outSignal>STQ.Obelisks.V.RaidSpawned</outSignal>
      </li>

      <li Class="StarTrekFactions.QuestNodes.QuestNode_WaitEnemiesDefeated">
        <inSignal>STQ.Obelisks.V.RaidSpawned</inSignal>
        <outSignal>STQ.Obelisks.V.Cleared</outSignal>
      </li>

      <li Class="QuestNode_Letter">
        <inSignal>STQ.Obelisks.V.Cleared</inSignal>
        <label>STQ.Obelisks.PhaseV.DoneTitle</label>
        <text>STQ.Obelisks.PhaseV.DoneText</text>
        <letterDef>PositiveEvent</letterDef>
      </li>
      </nodes>
    </root>
  </QuestScriptDef>

</Defs>
