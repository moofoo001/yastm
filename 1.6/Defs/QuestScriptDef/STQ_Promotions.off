<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <QuestScriptDef>
    <defName>STQ_Promotion_LJG</defName>
    <label>Promotion: lieutenant junior grade</label>

    <!-- Wichtig: voll qualifizierter Typ auf root -->
    <root Class="RimWorld.QuestGen.QuestNode_Sequence">
      <nodes>

        <!-- Warten auf: 1 Scan (Medical ODER Science) + Security + Diplomacy -->
        <li Class="RimWorld.QuestGen.QuestNode_Join">
          <inSignals>
            <li>STQ_ScanCategoryCompleted</li>
            <li>STQ_SecuritySweepCompleted</li>
            <li>STQ_DiplomacyImproveCompleted</li>
          </inSignals>
          <outSignal>STQ_LJG_AllObjectivesDone</outSignal>
        </li>

        <!-- Rewards: 1x LtJG-Pip -->
        <li Class="RimWorld.QuestGen.QuestNode_GiveRewards">
          <inSignal>STQ_LJG_AllObjectivesDone</inSignal>
          <rewards>
            <li Class="RimWorld.QuestGen.Reward_Items">
              <things>
                <li>
                  <thingDef>ST_PromotionPip_LJG</thingDef>
                  <count>1</count>
                </li>
              </things>
            </li>
          </rewards>
        </li>

      </nodes>
    </root>
  </QuestScriptDef>

</Defs>
