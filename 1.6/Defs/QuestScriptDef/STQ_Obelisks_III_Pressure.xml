<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <QuestScriptDef>
    <defName>STQ_VE_Obelisks_III_Pressure</defName>
    <rootSelectionWeight>0</rootSelectionWeight>
    <autoAccept>false</autoAccept>

    <!-- Phase III reagiert ausschließlich auf das Ende von Phase II -->
    <root Class="QuestNode_Sequence">
      <nodes>

        <!-- Beim Annehmen von Phase III sofort sauberer Titel/Text -->
        <li Class="StarTrekFactions.QuestNodes.QuestNode_RenameOnSignal">
          <inSignal>QuestAccepted</inSignal>
          <titleKey>STQ.Obelisks.PhaseIII.Title</titleKey>
          <descriptionKey>STQ.Obelisks.PhaseIII.Desc</descriptionKey>
        </li>

          <!-- 1–2 Tage warten nach Annahme der Phase III -->
          <li Class="StarTrekFactions.QuestNodes.QuestNode_DelayThenSignalOnSignal">
            <inSignal>QuestAccepted</inSignal>
            <delayTicksMin>60000</delayTicksMin>   <!-- 1 Tag -->
            <delayTicksMax>120000</delayTicksMax>  <!-- 2 Tage -->
            <outSignal>STQ.Obelisks.III.DelayDone</outSignal>
          </li>

        <!-- Nach Delay: neuer Manhunter -->
          <li Class="StarTrekFactions.QuestNodes.QuestNode_RunIncidentNow">
            <inSignal>STQ.Obelisks.III.DelayDone</inSignal>
            <incident>ManhunterPack</incident>
            <pointsFactor>1.05</pointsFactor> <!-- leicht stärker, anpassbar -->
            <outSignal>STQ.Obelisks.III.ManhuntersSpawned</outSignal>
          </li>

          <!-- Warten bis besiegt -->
          <li Class="StarTrekFactions.QuestNodes.QuestNode_WaitEnemiesDefeated">
            <inSignal>STQ.Obelisks.III.ManhuntersSpawned</inSignal>
            <onlyManhunters>true</onlyManhunters>
            <outSignal>STQ.Obelisks.III.Cleared</outSignal>
          </li>

            <!-- (Optional) Info-Brief -->
            <li Class="QuestNode_Letter">
              <inSignal>STQ.Obelisks.III.ManhuntersSpawned</inSignal>
              <label>STQ.Obelisks.PhaseIII.ThreatTitle</label>
              <text>STQ.Obelisks.PhaseIII.ThreatText</text>
              <letterDef>ThreatSmall</letterDef>
            </li>

            <!-- (Optional) Rename/Statusupdate nach Sieg -->
            <li Class="StarTrekFactions.QuestNodes.QuestNode_RenameOnSignal">
              <inSignal>STQ.Obelisks.III.Cleared</inSignal>
              <titleKey>STQ.Obelisks.PhaseIII.Title</titleKey>
              <descriptionKey>STQ.Obelisks.PhaseIII.Desc</descriptionKey>
            </li>
            
        <!-- (C) Choice-Dialog: erscheint NACH dem Delay -->
        <li Class="StarTrekFactions.QuestNodes.QuestNode_ChoiceDialogOnSignalV2">
          <inSignal>STQ.Obelisks.III.Ready</inSignal>

          <!-- Überschrift & Text des Dialogs -->
          <titleKey>STQ.Obelisks.PhaseIII.ChoiceTitle</titleKey>
          <textKey>STQ.Obelisks.PhaseIII.ChoiceText</textKey>

          <!-- Option 1: Halten nach Sternenflottenprotokoll (Warden-Pfad) -->
          <optionALabel>STQ.Obelisks.Path.Warden.Label</optionALabel>
          <optionASignal>STQ.Obelisks.Path.Warden.Chosen</optionASignal>

          <!-- Option 2: Anspruchsteller überholen (Vault-Pfad) -->
          <optionBLabel>STQ.Obelisks.Path.Vault.Label</optionBLabel>
          <optionBSignal>STQ.Obelisks.Path.Vault.Chosen</optionBSignal>
        </li>

        <!-- (D) Start: Phase IV (Warden-Pfad), wenn Option A gewählt wurde -->
        <!-- Start Phase IV (Warden) direkt auf Wahl-Signal -->
        <li Class="StarTrekFactions.QuestNodes.QuestNode_StartQuestOnSignal">
          <inSignal>STQ.Obelisks.Path.Warden.Chosen</inSignal>
          <questDef>STQ_VE_Obelisks_IV_Wardens</questDef>
        </li>

        <!-- Start Phase V (Vault) direkt auf Wahl-Signal -->
        <li Class="StarTrekFactions.QuestNodes.QuestNode_StartQuestOnSignal">
          <inSignal>STQ.Obelisks.Path.Vault.Chosen</inSignal>
          <questDef>STQ_VE_Obelisks_V_Vault</questDef>
        </li>


      </nodes>
    </root>
  </QuestScriptDef>
</Defs>
