<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ENSIGN -->
  <QuestScriptDef>
    <defName>ST_Q_Promotion_Ensign</defName>
    <root Class="QuestNode_Root_Choice">
      <text>ST.Promo.Ensign.Offer</text>
      <choices>
        <li Class="QuestNode_Choice">
          <choiceLabel>ST.Promo.Accept</choiceLabel>
          <questParts>
            <li Class="QuestPart_GetMapPlayerHome"><storeAs>st_playerMap</storeAs><mustHaveFreeColonists>true</mustHaveFreeColonists></li>
            <li Class="QuestPart_Delay"><inSignal>QuestAccepted</inSignal><delayTicks>60000</delayTicks><outSignalsCompleted><li>st_promo.drop</li></outSignalsCompleted></li>
            <li Class="QuestPart_DropPods"><inSignal>st_promo.drop</inSignal><mapParent>$st_playerMap.mapParent</mapParent><useDropSpotCenter>true</useDropSpotCenter><things><li><def>ST_PromotionPip_Ensign</def><count>1</count></li></things></li>
            <li Class="QuestPart_Letter"><inSignal>st_promo.drop</inSignal><label>ST.Promo.Ensign.LetterLabel</label><text>ST.Promo.Ensign.LetterText</text><lookTargets>$st_playerMap.mapParent</lookTargets><letterDef>PositiveEvent</letterDef></li>
            <li Class="QuestPart_End"><inSignal>st_promo.drop</inSignal></li>
          </questParts>
        </li>
        <li Class="QuestNode_Choice"><choiceLabel>ST.Promo.Decline</choiceLabel><questParts><li Class="QuestPart_End"><inSignal>QuestRejected</inSignal></li></questParts></li>
      </choices>
    </root>
  </QuestScriptDef>

