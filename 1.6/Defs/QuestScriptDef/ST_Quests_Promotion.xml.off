            <li Class="QuestPart_Letter"><inSignal>st_promo.drop</inSignal><label>ST.Promo.LJG.LetterLabel</label><text>ST.Promo.LJG.LetterText</text><lookTargets>$st_playerMap.mapParent</lookTargets><letterDef>PositiveEvent</letterDef></li>
