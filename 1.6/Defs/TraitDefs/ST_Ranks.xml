          <SocialImpact>0.10</SocialImpact>
          <NegotiationAbility>0.10</NegotiationAbility>
          <MentalBreakThreshold>-0.05</MentalBreakThreshold>
        </statOffsets>
        <commonality>0</commonality>
      </li>
    </degreeDatas>
  <modExtensions>
    <li Class="YASTM.PromotionRequirementsExtension">
      <factionDefName>ST_Starfleet</factionDefName>
      <goodwillMin>80</goodwillMin>
      <requiredCompletedQuests>5</requiredCompletedQuests>
      <minDaysSinceLastPromotion>15</minDaysSinceLastPromotion>
