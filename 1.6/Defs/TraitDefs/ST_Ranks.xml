<?xml version="1.0" encoding="utf-8"?>
<Defs>

<TraitDef>
    <defName>ST_Rank_Cadet</defName>
    <label>rank: cadet</label>
    <description>Initial training phase. Adapts quickly to new situations.</description>
    <conflictingTraits>
        <li>ST_Rank_Ensign</li><li>ST_Rank_LieutenantJG</li><li>ST_Rank_Lieutenant</li>
        <li>ST_Rank_LtCommander</li><li>ST_Rank_Commander</li><li>ST_Rank_Captain</li>
    </conflictingTraits>
    <degreeDatas>
      <li>
        <label>cadet</label>
        <description>Initial training phase. Adapts quickly to new situations.</description>
        <degree>0</degree>
        <statOffsets>
          <GlobalLearningFactor>0.05</GlobalLearningFactor>
          <WorkSpeedGlobal>0.03</WorkSpeedGlobal>
          <SocialImpact>0.02</SocialImpact>
        </statOffsets>
        <commonality>0</commonality>
      </li>
    </degreeDatas>
    <modExtensions>
        <li Class="YASTM.PromotionRequirementsExtension">
          <fromRankTraitDefName>ST_Rank_Cadet</fromRankTraitDefName>

          <requiredMedOrScienceScans>1</requiredMedOrScienceScans>
          <requiredSecuritySweeps>1</requiredSecuritySweeps>
          <requiredDiplomacyActions>0</requiredDiplomacyActions>

          <minDaysSinceLastPromotion>0</minDaysSinceLastPromotion>
          <goodwillMin>0</goodwillMin>
          <uniqueColonyWide>false</uniqueColonyWide>

          <pipApparelDefName>ST_RankPips_Ensign</pipApparelDefName>
        </li>

        <li Class="YASTM.RankVisualExtension">
          <pipApparelDefName>ST_RankPips_Ensign</pipApparelDefName>
        </li>
      </modExtensions>
  </TraitDef>


  <TraitDef>
    <defName>ST_Rank_Ensign</defName>
