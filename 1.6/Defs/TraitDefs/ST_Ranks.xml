        <goodwillMin>40</goodwillMin>
        <uniqueColonyWide>true</uniqueColonyWide>

        <pipApparelDefName>ST_RankPips_Captain</pipApparelDefName>
      </li>

      <li Class="YASTM.RankVisualExtension">
