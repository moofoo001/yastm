    <conflictingTraits>
        <li>ST_Rank_LieutenantJG</li><li>ST_Rank_Lieutenant</li>
        <li>ST_Rank_LtCommander</li><li>ST_Rank_Commander</li><li>ST_Rank_Captain</li>
    </conflictingTraits>
    <degreeDatas>
      <li>
        <label>ensign</label>
        <description>Freshly commissioned officer. Learns fast, follows procedure.</description>
        <degree>0</degree>
        <statOffsets>
          <GlobalLearningFactor>0.05</GlobalLearningFactor>
          <WorkSpeedGlobal>0.03</WorkSpeedGlobal>
          <SocialImpact>0.02</SocialImpact>
        </statOffsets>
        <commonality>0</commonality>
      </li>
    </degreeDatas>
    <modExtensions>
      <li Class="YASTM.PromotionRequirementsExtension">
        <fromRankTraitDefName>ST_Rank_Ensign</fromRankTraitDefName>

        <requiredMedOrScienceScans>3</requiredMedOrScienceScans>
        <requiredSecuritySweeps>2</requiredSecuritySweeps>
        <requiredDiplomacyActions>1</requiredDiplomacyActions>

        <minDaysSinceLastPromotion>2</minDaysSinceLastPromotion>
        <goodwillMin>5</goodwillMin>
        <uniqueColonyWide>false</uniqueColonyWide>

        <pipApparelDefName>ST_RankPips_LJG</pipApparelDefName>
      </li>

      <li Class="YASTM.RankVisualExtension">
        <pipApparelDefName>ST_RankPips_LJG</pipApparelDefName>
      </li>
    </modExtensions>
  </TraitDef>

  <TraitDef>
    <defName>ST_Rank_LieutenantJG</defName>
