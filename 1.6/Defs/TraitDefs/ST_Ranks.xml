    <conflictingTraits>
        <li>ST_Rank_Ensign</li><li>ST_Rank_Lieutenant</li>
        <li>ST_Rank_LtCommander</li><li>ST_Rank_Commander</li><li>ST_Rank_Captain</li>
    </conflictingTraits>
    <degreeDatas>
      <li>
        <label>lieutenant (jg)</label>
        <description>Junior officer with growing responsibilities.</description>
        <degree>0</degree>
        <statOffsets>
          <GlobalLearningFactor>0.06</GlobalLearningFactor>
          <WorkSpeedGlobal>0.04</WorkSpeedGlobal>
          <SocialImpact>0.03</SocialImpact>
        </statOffsets>
