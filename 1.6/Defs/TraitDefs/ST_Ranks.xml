        <requiredSecuritySweeps>3</requiredSecuritySweeps>
        <requiredDiplomacyActions>2</requiredDiplomacyActions>

        <minDaysSinceLastPromotion>4</minDaysSinceLastPromotion>
        <goodwillMin>10</goodwillMin>
        <uniqueColonyWide>false</uniqueColonyWide>

