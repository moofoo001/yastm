<Defs>
  <BackstoryDef>
    <defName>ST_Adult_Starfleet_Medicine_Trauma_Response_Specialist</defName>
    <title>Starfleet trauma response specialist</title>
    <titleShort>trauma specialist</titleShort>
    <slot>Adulthood</slot>
    <baseDesc>First in, last out: stabilizes critical patients under fire, triages mass
      casualties, and keeps calm when alarms won't stop.
    </baseDesc>
    <skillGains>
      <Medicine>+4</Medicine>
      <Social>+3</Social>
      <Shooting>+1</Shooting>
      </skillGains>
    <spawnCategories>
      <li>Starfleet_Medical</li>
    </spawnCategories>
    <forcedTraits />
    <disallowedTraits>
      <Pyromaniac>0</Pyromaniac>
    </disallowedTraits>
  </BackstoryDef>

