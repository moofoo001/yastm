<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ENSIGN: keine Voraussetzung -->
  <IncidentDef>
    <defName>ST_GiveQuest_Promotion_Ensign</defName>
    <workerClass>YASTM.IncidentWorker_GivePromotionQuest</workerClass>
    <category>Misc</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <baseChance>0.03</baseChance>
    <questScriptDef>ST_Q_Promotion_Ensign</questScriptDef>
    <letterLabel>ST.Promo.Ensign.LetterLabelOffer</letterLabel>
    <letterText>ST.Promo.Ensign.Offer</letterText>
    <letterDef>NeutralEvent</letterDef>
  </IncidentDef>

  <!-- LJG: Voraussetzung = Ensign (Trait ODER Pip-Apparel) -->
  <IncidentDef>
    <defName>ST_GiveQuest_Promotion_LJG</defName>
    <workerClass>YASTM.IncidentWorker_GivePromotionQuest</workerClass>
    <category>Misc</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <baseChance>0.02</baseChance>
    <questScriptDef>ST_Q_Promotion_LJG</questScriptDef>
    <letterLabel>ST.Promo.LJG.LetterLabelOffer</letterLabel>
    <letterText>ST.Promo.LJG.Offer</letterText>
    <letterDef>NeutralEvent</letterDef>
    <modExtensions>
      <li Class="YASTM.ModExt_PromotionEligibility">
        <requiredTraits><li>ST_Rank_Ensign</li></requiredTraits>
        <requiredApparels><li>ST_RankPips_Ensign</li></requiredApparels>
      </li>
    </modExtensions>
  </IncidentDef>

