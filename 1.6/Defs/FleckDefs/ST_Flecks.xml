<?xml version="1.0" encoding="utf-8"?>
<Defs>
<!-- obelisks -->
<FleckDef ParentName="FleckBase_Thrown">
  <defName>ST_ObeliskPulse</defName>
  <altitudeLayer>MetaOverlays</altitudeLayer>        <!-- above clutter -->
  <fadeInTime>0.15</fadeInTime>
  <solidTime>0.15</solidTime>
  <fadeOutTime>0.5</fadeOutTime>
  <growthRate>0</growthRate>
  <graphicData>
    <graphicClass>Graphic_FleckPulse</graphicClass>
    <texPath>Things/Mote/SoftRingWhiteRedTinged</texPath>
    <shaderType>MoteGlow</shaderType>
    <renderInstanced>true</renderInstanced>
    <shaderParameters>
      <_Color>(0.35, 0.15, 0.70, 0.15)</_Color>       <!-- cyan w/ soft alpha -->
      <_Interval>0.1</_Interval>
    </shaderParameters>
    <drawSize>6.0</drawSize>                         <!-- smaller than 10 -->
  </graphicData>
</FleckDef>

<!-- alert -->
<FleckDef ParentName="FleckBase">
    <defName>ST_AlertBlink_Red</defName>
    <altitudeLayer>MetaOverlays</altitudeLayer>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.22</solidTime>
    <fadeOutTime>0.22</fadeOutTime>
    <fleckSystemClass>FleckSystemStatic</fleckSystemClass>
    <graphicData>
      <graphicClass>Graphic_FleckPulse</graphicClass>
      <texPath>Things/Mote/LightningGlow</texPath>
      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
      <drawSize>6.6</drawSize>
      <color>(0.95,0.2,0.2,1)</color>
    </graphicData>
  </FleckDef>

<FleckDef ParentName="FleckBase">
    <defName>ST_AlertBlink_Yellow</defName>
    <altitudeLayer>MetaOverlays</altitudeLayer>
    <fadeInTime>0.05</fadeInTime>
    <solidTime>0.22</solidTime>
    <fadeOutTime>0.22</fadeOutTime>  
    <fleckSystemClass>FleckSystemStatic</fleckSystemClass>
    <graphicData>
      <graphicClass>Graphic_FleckPulse</graphicClass>
      <texPath>Things/Mote/LightningGlow</texPath>
      <shaderType>MoteGlow</shaderType>
      <renderInstanced>true</renderInstanced>
      <drawSize>6.6</drawSize>
      <color>(1,0.92,0.2,1)</color>
    </graphicData>
  </FleckDef>

  <FleckDef ParentName="FleckBase">
    <defName>ST_KtarianHolo</defName>
    <fleckSystemClass>FleckSystemStatic</fleckSystemClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>6</fadeInTime>
    <solidTime>18</solidTime>
    <fadeOutTime>12</fadeOutTime>
    <graphicData>
      <graphicClass>Graphic_Fleck</graphicClass>   <!-- wichtig -->
      <texPath>Things/Mote/ElectricalSpark</texPath>
      <drawSize>1.2</drawSize>
      <color>(0.65,0.85,1,0.9)</color>
    </graphicData>
  </FleckDef>

</Defs>
