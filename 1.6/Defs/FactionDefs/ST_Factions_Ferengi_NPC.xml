<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <FactionDef ParentName="FactionBase">
    <defName>Ferengi_Alliance</defName>
    <label>Ferengi Alliance</label>
    <description>Profit-driven traders with flexible morals and sharp deals.</description>

    <factionNameMaker>ST_NamerFerengiFaction</factionNameMaker>
    <settlementNameMaker>ST_SettlementName_Ferengi</settlementNameMaker>
    <factionIconPath>UI/Icons/Factions/Ferengi</factionIconPath>

    <listOrderPriority>48</listOrderPriority>
    <settlementGenerationWeight>0.14</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>33</configurationListOrderPriority>
    <displayInFactionSelection>true</displayInFactionSelection>

    <allowedCultures><li>ST_Culture_Ferengi</li></allowedCultures>
    <techLevel>Spacer</techLevel>
    <permanentEnemy>false</permanentEnemy>
    <leaderTitle>liquidator</leaderTitle>
    <fixedLeaderKinds>
      <li>FRG_Leader</li>
    </fixedLeaderKinds>

    <colorSpectrum>
      <li>(0.90, 0.70, 0.20)</li>
      <li>(1.00, 0.85, 0.25)</li>
    </colorSpectrum>

    <xenotypeSet Inherit="False" MayRequire="Ludeon.RimWorld.Biotech">
      <xenotypeChances><Ectos_Ferengi>0.90</Ectos_Ferengi><Baseliner>0.10</Baseliner></xenotypeChances>
    </xenotypeSet>

    <backstoryFilters>
      <li>
        <categoriesChildhood><li>Civil</li><li>Spacer</li></categoriesChildhood>
        <categoriesAdulthood><li>Civil</li><li>Spacer</li></categoriesAdulthood>
      </li>
    </backstoryFilters>

    <!-- TraderKinds  -->
    <caravanTraderKinds>
      <li>Trader_Ferengi_CommerceGuild</li>
      <li>Trader_Ferengi_Exotics</li>
      <li>ST_Ferengi_CommerceExchange</li>
    </caravanTraderKinds>
    <visitorTraderKinds>
      <li>Trader_Ferengi_CommerceGuild</li>
      <li>Trader_Ferengi_Exotics</li>
    </visitorTraderKinds>
    <baseTraderKinds>
      <li>Trader_Ferengi_CommerceGuild</li>
      <li>Trader_Ferengi_Exotics</li>
      <li>ST_Ferengi_CommerceExchange</li>
    </baseTraderKinds>

    <!-- Pawn-Budget-Curve -->
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,40)</li>
        <li>(70,55)</li>
        <li>(700,110)</li>
        <li>(1300,170)</li>
        <li>(100000,10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>

    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <FRG_Guard>1.2</FRG_Guard>
          <FRG_Merchant>0.3</FRG_Merchant>
        </options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <FRG_Merchant>3.5</FRG_Merchant>
          <FRG_Guard>0.6</FRG_Guard>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders><FRG_Merchant>1</FRG_Merchant></traders>
        <carriers><Muffalo>6</Muffalo><Dromedary>5</Dromedary><Alpaca>2</Alpaca></carriers>
        <guards><FRG_Guard>8</FRG_Guard></guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <FRG_Merchant>4.0</FRG_Merchant>
          <FRG_Guard>0.8</FRG_Guard>
          <FRG_Leader>0.1</FRG_Leader>
        </options>
      </li>
    </pawnGroupMakers>

    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
  </FactionDef>
</Defs>
