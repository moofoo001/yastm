        <Ectos_Trill>0.07</Ectos_Trill>
        <Ectos_Bajoran>0.05</Ectos_Bajoran>
        <Ectos_Denobulan>0.04</Ectos_Denobulan>
        <Ectos_Bolian>0.04</Ectos_Bolian>
        <Ectos_Benzite>0.02</Ectos_Benzite>
        <Ectos_Orion>0.02</Ectos_Orion>
        <Ectos_Klingon>0.02</Ectos_Klingon>
        <Ectos_Romulan>0.02</Ectos_Romulan>
        <Ectos_Cardassian>0.02</Ectos_Cardassian>
