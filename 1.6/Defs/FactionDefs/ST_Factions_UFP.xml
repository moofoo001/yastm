    <description>A peaceful and advanced exploratory coalition of worlds, dedicated to the principles of cooperation, exploration, and mutual respect.</description>
    <isPlayer>true</isPlayer>
    <basicMemberKind>FederationPawn_general</basicMemberKind>
    <pawnSingular>member</pawnSingular>
    <pawnsPlural>members</pawnsPlural>
    <techLevel>Spacer</techLevel>
    <factionNameMaker>ST_NamerFedFaction</factionNameMaker>
    <settlementNameMaker>ST_NamerFedBase</settlementNameMaker>
    <allowedCultures>
      <li>ST_Culture_UFP</li>
    </allowedCultures>
    
    <factionIconPath>UI/Icons/Factions/UFP</factionIconPath>
    <colorSpectrum>
      <li>(0.20, 0.55, 0.95)</li>
    </colorSpectrum>

    <!-- Faction Xenotyps -->
